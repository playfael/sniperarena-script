        ["rage.fov"]=700,["rage.distance"]=2000,["rage.autoFire"]=true,["rage.autoScope"]=true,
        ["aim.gain"]=1,["aim.maxStep"]=600,["aim.wallbang"]=true,["rcs.enabled"]=false,["recoil.zero"]=true,["recoil.noSpread"]=true,
        ["trigger.activation"]="Always",["trigger.delay"]=0,["trigger.interval"]=75,["trigger.distance"]=2000,
