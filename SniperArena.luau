                    if self.stopped or controller.Destroyed or not controller.Activated or not controller:IsInWeaponActionContext() or weapon.Controller~=controller or weapon.CustomModel~=presentation.skin then return end
                    local ready,seen=true,false
                    for _,channel in ipairs({{"arm",selected.FakeArmAnims},{"entity",selected.CharacterAnims}}) do
                        local adapter=controller.AnimAdapters and controller.AnimAdapters[channel[1]]
                        local anims=channel[2]
                        if adapter and anims and anims.Switch then
                            seen=true
                            local track=adapter:GetAnim("Switch",{AnimInstance=anims.Switch})
                            if not track or track.Length==0 then ready=false end
                            if selected.SecondarySwitch and anims.Switch2 then
                                local other=adapter:GetAnim("Switch2",{AnimInstance=anims.Switch2})
                                if not other or other.Length==0 then ready=false end
                            end
                        end
