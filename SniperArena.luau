    mk("UIListLayout",{Padding=UDim.new(0,7),SortOrder=Enum.SortOrder.LayoutOrder},self.notifHost)
    self:_conn(UserInputService.InputChanged,function(input)
        if self.dragInput and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
            self:MoveTo(self.startPosition.X.Offset+(input.Position.X-self.dragStart.X), self.startPosition.Y.Offset+(input.Position.Y-self.dragStart.Y))
        end
        if self.sliderDrag and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
            self.sliderDrag(input.Position.X)
        end
    end)
    self:_conn(UserInputService.InputEnded,function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            self.sliderDrag=nil;self.dragInput=nil
        end
    end)
    self:_conn(UserInputService.InputBegan,function(input,gameProcessed)
        if self.waitKey then
            if input.UserInputType==Enum.UserInputType.Keyboard and input.KeyCode~=Enum.KeyCode.Unknown then
                local data=self.waitKey;self.waitKey=nil
                local name=input.KeyCode.Name
                if name=="Escape" then data.button.Text=tostring(self.state:Get(data.key,"None"));return end
                if name=="Backspace" or name=="Delete" then name=data.key=="menuKey" and "RightShift" or "None" end
                self.state:Set(data.key,name);data.button.Text=name
                return
            elseif input.UserInputType==Enum.UserInputType.MouseButton2 or input.UserInputType==Enum.UserInputType.MouseButton3 then
                local data=self.waitKey;self.waitKey=nil
                self.state:Set(data.key,input.UserInputType.Name);data.button.Text=input.UserInputType.Name
                return
            end
        end
        if UserInputService:GetFocusedTextBox() then return end
        if input.UserInputType==Enum.UserInputType.Keyboard and input.KeyCode.Name==self.state:Get("menuKey","RightShift") then
            self:Toggle()
        end
    end)
    self:_watch("language",function() self:RefreshLocale() end)
    self:_watch("autoApply",function(value) self.engine.autoApply=value end,true)
    self:_watch("ui.accent",function(color)
        if typeof(color)=="Color3" and self.indicator then
            self.indicator.BackgroundColor3=color
        end
    end,true)
    self:BuildDemoTabs()
    self:BuildSkins()
    self:SelectTab("Skins",true)
    self:Resize()
    self:_conn(Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"),function() self:Resize() end)
    self.window.GroupTransparency=1
    self.scale.Scale=self.baseScale*.96
    self:_anim(self.scale,.26,{Scale=self.baseScale},Enum.EasingStyle.Quint)
    self:_anim(self.window,.25,{GroupTransparency=0},Enum.EasingStyle.Quint)
end

function UI:MoveTo(x,y)
    local camera=Workspace.CurrentCamera
    if not camera then return end
    local screen=camera.ViewportSize
    local factor=self.scale.Scale
    local w=780*factor;local h=542*factor
    x=math.clamp(x,0,math.max(0,screen.X-w))
    y=math.clamp(y,0,math.max(0,screen.Y-h))
    self.window.Position=UDim2.fromOffset(x,y)
end
function UI:Resize()
    local camera=Workspace.CurrentCamera
    if not camera then return end
    local screen=camera.ViewportSize
    self.baseScale=math.min(1,screen.X/805,screen.Y/570)
    if self.isOpen then self.scale.Scale=self.baseScale end
    self:MoveTo(self.window.Position.X.Offset,self.window.Position.Y.Offset)
end
function UI:Show()
    if self.isOpen and not self.closing then return end
    self.closing=false
    self.isOpen=true
    self.window.Visible=true
    self.scale.Scale=self.baseScale*.94
    self.window.GroupTransparency=1
    self:_anim(self.scale,.25,{Scale=self.baseScale},Enum.EasingStyle.Quint)
    self:_anim(self.window,.25,{GroupTransparency=0},Enum.EasingStyle.Quint)
end
function UI:Hide()
    if not self.isOpen or self.closing then return end
    self:ClosePopup()
    self.closing=true
    self:_anim(self.scale,.18,{Scale=self.baseScale*.94},Enum.EasingStyle.Quart)
    local tw=self:_anim(self.window,.18,{GroupTransparency=1},Enum.EasingStyle.Quart)
    if tw then
        tw.Completed:Once(function()
            if not self.closing then return end
            self.isOpen=false;self.closing=false
            if self.window and self.window.Parent then self.window.Visible=false end
        end)
    else
        self.isOpen=false;self.closing=false;self.window.Visible=false
    end
end
function UI:Toggle()
    if self.closing then self:Show()
    elseif self.isOpen then self:Hide()
    else self:Show() end
end
function UI:SelectTab(id,instant)
    local page=self.pages[id]
    if not page then return end
    self:ClosePopup()
    self.activeTab=id
    if self.pickerOverlay then self.pickerOverlay.Visible=false end
    for tabId, node in pairs(self.pages) do node.Visible=tabId==id end
    for tabId, node in pairs(self.tabButtons) do
        local active=tabId==id
        local c=active and Color3.fromRGB(34,26,36) or C.sidebar
        node.button:SetAttribute("mnzsNormalColor",c)
        self:_anim(node.button,instant and .01 or .18,{BackgroundColor3=c})
        self:_anim(node.title,.17,{TextColor3=active and C.text or C.muted})
        self:_anim(node.icon,.17,{ImageColor3=active and Color3.fromRGB(232,196,220) or C.muted})
    end
    local tab=self.tabButtons[id]
    if tab then self:_anim(self.indicator,instant and .01 or .20,{Position=UDim2.fromOffset(17,tab.y)},Enum.EasingStyle.Quint) end
    local translationKey=tab and tab.info.key or "skins"
    self.pageTitle.Text=self:_t(translationKey)
    self.pageSubtitle.Text=id=="Skins" and self:_t("subtitle") or self:_t("welcomeSub")
    self:FilterPage()
end
function UI:RefreshLocale()
    for object,key in pairs(self.translations) do
        if object.Parent then object.Text=self:_t(key) else self.translations[object]=nil end
    end
    local english=self.state:Get("language","pt")=="en"
    if self.flagIcon then self.flagIcon.ImageRectOffset=Vector2.new(english and 192 or 128,128) end
    if self.flagCode then self.flagCode.Text=english and "EN" or "PT" end
    self.search.PlaceholderText=self:_t("search")
    local node=self.tabButtons[self.activeTab]
    if node then self.pageTitle.Text=self:_t(node.info.key) end
    self.pageSubtitle.Text=self.activeTab=="Skins" and self:_t("subtitle") or self:_t("welcomeSub")
    for _,entry in ipairs(self.staticCopies or {}) do
        if entry.object and entry.object.Parent then
            entry.object[entry.property]=self:_lcopy(entry.source)
        end
    end
    for _,refresh in ipairs(self.localeRefreshers or {}) do pcall(refresh) end
    for _,refresh in ipairs(self.localeRefreshers or {}) do pcall(refresh) end
    for _,refresh in ipairs(self.localeRefreshers or {}) do pcall(refresh) end
    if self.skinFrame then self:RefreshSkins() end
    if self.pickerOverlay and self.pickerOverlay.Visible then self:RefreshWeaponPicker() end
end
function UI:FilterPage()
    local filter=low(self.search.Text)
    if self.activeTab=="Skins" then self:RefreshSkins();return end
    for _,entry in ipairs(self.filterables[self.activeTab] or {}) do
        if entry.node.Parent then entry.node.Visible=filter=="" or string.find(entry.search,filter,1,true)~=nil end
    end
end

function UI:ClosePopup()
    self.popupHolder.Visible=false
    self.overlayClick.Visible=false
    for _,child in ipairs(self.popupHolder:GetChildren()) do
