function Feature:ApplyPreset(id)
    local values=Feature.PresetValues(id)
    if not values then return false,self.state:Get("language","pt")=="en" and "Unknown preset" or "Preset desconhecido" end
    local keys={}
    for key,value in pairs(values) do
        local normalized,valid=normalize(key,value)
        if not valid then return false,"Invalid preset setting: "..key end
        values[key]=normalized;keys[#keys+1]=key
    end
    table.sort(keys)
    self.applyingPreset=true
    self:_releaseShot()
    self.target=nil;self.aimPosition=nil;self.pendingTarget=nil;self.lastAimedPlayer=nil;self.triggerTarget=nil
    self.mouseRemainder=Vector2.zero;self.toggled={legit=false,rage=false,trigger=false}
    self.state:Set("legit.enabled",false);self.state:Set("rage.enabled",false)
    for _,key in ipairs(keys) do
        if key~="legit.enabled" and key~="rage.enabled" then self.state:Set(key,values[key]) end
    end
    self.state:Set("legit.enabled",values["legit.enabled"])
    self.state:Set("rage.enabled",values["rage.enabled"])
    self.state:Set("presets.active",id)
    self.applyingPreset=false
    return true,self.state:Get("language","pt")=="en" and (id.." applied") or (id.." aplicado")
end
function Feature:Start()
    if self.running then return end
    self:_startV913()
    self.unwatch[#self.unwatch+1]=self.state:OnChange(function(key)
        if not self.applyingPreset and presetManaged(key,specs[key]) and self.state:Get("presets.active","Custom")~="Custom" then
            self.state:Set("presets.active","Custom")
        end
    end)
end

