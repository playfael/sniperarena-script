function Feature:_newDraw(class,properties,bundle)
    local d=Drawing.new(class)
    d.Visible=false
    d.Transparency=1
    d.Color=white
    d.ZIndex=2
    for key,value in pairs(properties or {}) do d[key]=value end
    self.drawings[d]=true
    if bundle then bundle.objects[#bundle.objects+1]=d end
    return d
end
function Feature:_global(key,class,properties)
    if not self.globals[key] then self.globals[key]=self:_newDraw(class,properties) end
    return self.globals[key]
end
function Feature:_removeDrawing(d)
    if self.drawings[d] then
        self.drawings[d]=nil
        pcall(function() d:Remove() end)
    end
end
function Feature:_destroyBundle(record)
    if not record.bundle then return end
    for _,d in ipairs(record.bundle.objects) do self:_removeDrawing(d) end
    record.bundle=nil
end
function Feature:_bundle(record)
    if not record.bundle then record.bundle={objects={},lines={},texts={}} end
