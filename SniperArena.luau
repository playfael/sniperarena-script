        ["esp.arrows"]=true,["esp.chams"]=true,["esp.chamsOpacity"]=35,["world.reduceFlash"]=true})
    if id=="Rage" then return values end
    set({["rage.fov360"]=true,["rage.fov"]=1200,["rage.distance"]=5000,["trigger.interval"]=50,["trigger.distance"]=5000,
        ["bhop.activation"]="Always",["spin.enabled"]=true,["spin.speed"]=7200,["spin.pitch"]=-89,["world.thirdPerson"]=true,
        ["world.fovEnabled"]=true,["world.fov"]=80,["world.fullbright"]=true,["world.noFog"]=true,
        ["esp.distanceLimit"]=5000,["esp.snapline"]=true,["esp.radar"]=true,["esp.radarRange"]=1000,
        ["esp.chamsOpacity"]=65,["esp.lastKnown"]=true,["misc.crosshair"]=true})
