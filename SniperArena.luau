local function presetManaged(key,definition)
    if not definition or definition.kind=="key" or definition.kind=="Color3" then return false end
    if key=="profiles.enabled" then return true end
    local group=key:match("^([^.]+)%.")
    return group=="legit" or group=="rage" or group=="aim" or group=="trigger" or group=="rcs" or group=="recoil"
        or group=="esp" or group=="spin" or group=="bhop" or group=="world" or group=="misc"
end
function Feature.PresetValues(id)
    if not table.find(presetNames,id) or id=="Custom" then return nil end
    local values={}
    for key,definition in pairs(specs) do
        if presetManaged(key,definition) then values[key]=type(definition.default)=="table" and table.clone(definition.default) or definition.default end
    end
    local function set(changes) for key,value in pairs(changes) do values[key]=value end end
    set({["profiles.enabled"]=false,["legit.enabled"]=true,["legit.activation"]="Hold",["legit.regions"]={"Head","Chest"},
        ["legit.fov"]=60,["legit.smooth"]=260,["legit.distance"]=350,["legit.smoke"]=true,["legit.flash"]=true,
        ["legit.drawFov"]=false,["legit.targetLine"]=false,["esp.enabled"]=true,["esp.visibleOnly"]=true,
        ["esp.distanceLimit"]=350,["esp.healthNumber"]=false,["esp.weapon"]=false,["esp.distance"]=false,["esp.lastKnown"]=false})
    if id=="Full Legit" then return values end
    set({["legit.fov"]=110,["legit.smooth"]=170,["legit.distance"]=700,["legit.drawFov"]=true,
        ["rcs.enabled"]=true,["rcs.pitch"]=60,["rcs.yaw"]=40,["esp.distanceLimit"]=700,["esp.distance"]=true,["esp.weapon"]=true})
    if id=="Legit" then return values end
    set({["legit.fov"]=230,["legit.smooth"]=65,["legit.distance"]=1200,["rcs.pitch"]=80,["rcs.yaw"]=60,
        ["trigger.enabled"]=true,["trigger.activation"]="Hold",["trigger.delay"]=90,["trigger.followRegions"]=true,
        ["bhop.enabled"]=true,["bhop.activation"]="Hold",["esp.visibleOnly"]=false,["esp.distanceLimit"]=1200,
        ["esp.boxType"]="Corner",["esp.healthNumber"]=true,["esp.skeleton"]=true})
