function Feature:_activated(mode)
    local cfg=self.config
    local activation=cfg[mode..".activation"]
    return activation=="Always" or (activation=="Toggle" and self.toggled[mode]==true)
        or (activation=="Hold" and self:_keyHeld(cfg[mode..".key"]))
        or (activation=="Firing" and Input:IsMouseButtonPressed(Enum.UserInputType.MouseButton1))
end
function Feature:_profile()
    if not self.config["profiles.enabled"] then return nil end
    local weapon=self.currentWeapon
    local prefix=weapon and "profile."..weapon.."."
    return prefix and self.config[prefix.."enabled"] and prefix or nil
end
function Feature:_effectivePart(mode)
    if mode=="rage" and (self.config["rage.bodyAim"] or self:_keyHeld(self.config["rage.bodyKey"])) then return "Chest" end
    local profile=mode=="legit" and self:_profile()
    return profile and self.config[profile.."part"] or self.config[mode..".part"]
end
function Feature:_effectiveSmooth(mode)
    if mode~="legit" then return 0 end
    local profile=self:_profile()
    return profile and self.config[profile.."smooth"] or self.config["legit.smooth"]
end
function Feature:_effectiveFov(mode,camera)
    local profile=mode=="legit" and self:_profile()
    local radius=profile and self.config[profile.."fov"] or self.config[mode..".fov"]
    if self.config[mode..".dynamicFov"] then
        radius*=math.tan(math.rad(70)*0.5)/math.tan(math.rad(math.clamp(camera.DiagonalFieldOfView,1,170))*0.5)
    end
    return math.clamp(radius,10,1200)
end
function Feature:_regionPosition(part,choice)
    if choice=="Neck" and part.Name=="Head" then return part.CFrame:PointToWorldSpace(Vector3.new(0,-part.Size.Y*0.4,0)) end
    if choice=="Stomach" then return part.CFrame:PointToWorldSpace(Vector3.new(0,part.Size.Y*0.25,0)) end
    if choice=="Pelvis" then return part.CFrame:PointToWorldSpace(Vector3.new(0,-part.Size.Y*0.25,0)) end
    return part.Position
end
function Feature:_targetReady(player)
    if self.pendingTarget~=player then self.pendingTarget=player;self.pendingTargetAt=os.clock() end
    if self.lastAimedPlayer and self.lastAimedPlayer~=player and os.clock()-self.pendingTargetAt<self.config["aim.switchDelay"]/1000 then return false end
    self.lastAimedPlayer=player
    return true
end
function Feature:_isFlashed()
    local untilTime=LocalPlayer:GetAttribute("FlashedUntil")
    if finite(untilTime) and untilTime>Workspace:GetServerTimeNow() then return true end
    return self.flashEffect and type(self.flashEffect.IsFlashed)=="function" and self.flashEffect.IsFlashed() or false
end
local function segmentBox(a,b,part)
    local origin=part.CFrame:PointToObjectSpace(a)
    local delta=part.CFrame:VectorToObjectSpace(b-a)
    local half=part.Size*0.5
    local low,high=0,1
    for _,axis in ipairs({"X","Y","Z"}) do
        if math.abs(delta[axis])<0.00001 then
            if math.abs(origin[axis])>half[axis] then return false end
        else
            local first=(-half[axis]-origin[axis])/delta[axis]
            local last=(half[axis]-origin[axis])/delta[axis]
            low=math.max(low,math.min(first,last));high=math.min(high,math.max(first,last))
            if low>high then return false end
        end
    end
    return true
end
function Feature:_throughSmoke(a,b)
    for part in pairs(self.smokeParts) do if part.Parent and segmentBox(a,b,part) then return true end end
    return false
end
function Feature:_extraAimFilter(mode,a,b)
    if self.config[mode..".flash"] and self:_isFlashed() then return false,"flash" end
    if self.config[mode..".smoke"] and self:_throughSmoke(a,b) then return false,"smoke" end
    return true,"eligible"
end
function Feature:_spinInput() return false end
function Feature:_releaseShot()
    if self.fireHeld then self.inputDriver.release();self.fireHeld=false end
end
function Feature:_partMatches(part,region)
    if region=="Any" then return true end
    local name=part.Name
    if region=="Head" or region=="Neck" then return name=="Head" end
    if region=="Chest" then return name=="UpperTorso" or name=="Torso" end
    if region=="Stomach" or region=="Pelvis" then return name=="LowerTorso" or name=="Torso" end
    return string.find(name,"Leg",1,true)~=nil or string.find(name,"Foot",1,true)~=nil
end
function Feature:TriggerProbe(cameraOverride)
    return self:_triggerProbeAdvanced(cameraOverride)
end
function Feature:_updateFire()
    local now=os.clock()
    if self.fireHeld and (now>=self.releaseShotAt or not self:_canInput()) then self:_releaseShot() end
    local canInput=self:_canInput()
    local cfg=self.config
    local rageActive=cfg["rage.enabled"] and self:_activated("rage")
    local triggerActive=cfg["trigger.enabled"] and self:_activated("trigger")
    if not canInput then self.triggerTarget=nil;return end
    if rageActive and self.target and cfg["rage.autoScope"] and (self.currentWeapon=="AWP" or self.currentWeapon=="SSG 08")
        and LocalPlayer:GetAttribute("IsSniperScoped")~=true then
        if now>=self.nextScopeAt then self.inputDriver.rightClick();self.nextScopeAt=now+0.8 end
        return
    end
    if not (triggerActive or (rageActive and cfg["rage.autoFire"])) then self.triggerTarget=nil;return end
    local record,reason=self:TriggerProbe()
    self.stats.triggerStatus=reason
    if not record then self.triggerTarget=nil;return end
    if not triggerActive and (self.target~=record.player or self.stats.status~="tracking-rage") then self.triggerTarget=nil;return end
    if self.triggerTarget~=record.player then self.triggerTarget=record.player;self.triggerEnteredAt=now end
    if now-self.triggerEnteredAt<cfg["trigger.delay"]/1000 or now<self.nextShotAt then return end
    if self.fireHeld or self.inputDriver.isLeftDown() then return end
    if not self.currentAmmo or self.currentAmmo<=0 then return end
    if not self:_requestShotPose() then return end
    self.inputDriver.press();self.fireHeld=true;self.releaseShotAt=now+0.035
    self.nextShotAt=now+cfg["trigger.interval"]/1000
    self.stats.triggerShots+=1
end
function Feature:_updateRcs()
    local controller=self.cameraController
    if not controller or type(controller.getWeaponKickRotation)~="function" then return end
    local recoil=controller.getWeaponKickRotation()
    if typeof(recoil)~="Vector3" then return end
    local previous=self.previousRecoil or recoil
    self.previousRecoil=recoil
    if self.config["recoil.zero"] or not self.config["rcs.enabled"] or not self:_canInput() or not Input:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then return end
    if self.stats.status=="tracking-legit" or self.stats.status=="tracking-rage" or self.stats.status=="spin-native-input" then return end
    local delta=recoil-previous
    local horizontal,vertical=self:_mouseRadiansPerCount()
    local movement=Vector2.new(delta.Y/horizontal*self.config["rcs.yaw"]/100,delta.X/vertical*self.config["rcs.pitch"]/100)
    if movement.Magnitude>120 then movement=movement.Unit*120 end
    self:_moveMouse(movement);self.stats.rcsInputs+=1
end

local baseRefresh=Feature._refreshEntitiesBase
function Feature:_refreshEntities()
    baseRefresh(self)
    self.entityDirty=false
    local now=os.clock()
    local raw=LocalPlayer:GetAttribute("CurrentEquipped")
    if raw~=self.ownWeaponRaw then
        self.ownWeaponRaw=raw;self.currentWeapon,self.currentAmmo=nil,nil
        if type(raw)=="string" then local ok,data=pcall(Http.JSONDecode,Http,raw);if ok and type(data)=="table" then self.currentWeapon=type(data.Name)=="string" and data.Name or nil;self.currentAmmo=finite(data.Rounds) and data.Rounds or nil end end
    end
    for player,record in pairs(self.records) do
        if player:GetAttribute("Dead")==true or (finite(player:GetAttribute("Health")) and player:GetAttribute("Health")<=0)
            or (player:GetAttribute("Team")~="Terrorists" and player:GetAttribute("Team")~="Counter-Terrorists") then self.memory[player]=nil end
        if record.character and record.root and healthOf(player,record.character)>0 then
            self.memory[player]={position=record.root.Position,time=now,generation=player:GetAttribute("CharacterGeneration"),team=teamOf(player,record.character)}
        end
        local armorRaw=player:GetAttribute("Armor")
        if armorRaw~=record.armorRaw then
            record.armorRaw=armorRaw;record.armor=0
            if type(armorRaw)=="string" then local ok,value=pcall(Http.JSONDecode,Http,armorRaw);if ok and type(value)=="table" and finite(value.Health) then record.armor=value.Health end end
        end
    end
    for player,entry in pairs(self.memory) do
        if player.Parent~=Players or player:GetAttribute("CharacterGeneration")~=entry.generation or now-entry.time>self.config["esp.memorySeconds"] then self.memory[player]=nil end
    end
    if now>=self.nextSmokeScan then
        self.nextSmokeScan=now+0.25;table.clear(self.smokeParts)
        local smokeNeeded=self.config["trigger.smoke"] and (self.config["trigger.enabled"] or self.config["rage.enabled"] and self.config["rage.autoFire"])
            or self.config["legit.smoke"] and self.config["legit.enabled"] or self.config["rage.smoke"] and self.config["rage.enabled"]
        local debris=Workspace:FindFirstChild("Debris")
        if smokeNeeded and debris then for _,part in ipairs(debris:GetDescendants()) do if part:IsA("BasePart") and part.Name=="SmokeVoxel" then self.smokeParts[part]=true end end end
    end
end
function Feature:_watchPlayer(player)
    if self.playerWatches[player] then return end
    local watchers={character={}}
    self.playerWatches[player]=watchers
    local function dirty() self.entityDirty=true;self.nextEsp=0 end
    local function bind()
        for _,conn in ipairs(watchers.character) do conn:Disconnect() end
        table.clear(watchers.character)
        local c=player.Character
        if c then
            watchers.character={c.AncestryChanged:Connect(dirty),c.DescendantAdded:Connect(dirty),c:GetAttributeChangedSignal("ClientCharacterPresentationVisible"):Connect(dirty)}
        end
        dirty()
    end
    watchers.changed=player:GetPropertyChangedSignal("Character"):Connect(bind)
    watchers.health=player:GetAttributeChangedSignal("Health"):Connect(dirty)
    bind()
end
function Feature:_forgetPlayer(player)
    local watchers=self.playerWatches[player]
    if watchers then
        watchers.changed:Disconnect();watchers.health:Disconnect()
        for _,conn in ipairs(watchers.character) do conn:Disconnect() end
        self.playerWatches[player]=nil
    end
    self.memory[player]=nil
    local radarKey="radar:p"..player.UserId
    if self.globals[radarKey] then self:_removeDrawing(self.globals[radarKey]);self.globals[radarKey]=nil end
    if self.highlights[player] then self.highlights[player]:Destroy();self.highlights[player]=nil end
end

