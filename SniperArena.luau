end
function Feature:_startV912()
    if self.running then return end
    self:_startV99()
    self:_installComboAdapters()
    self:_connect(Input.WindowFocusReleased,function() self:_clearBodyPose();self.jumpWasPressed=false end)
    self:_connect(LocalPlayer.CharacterRemoving,function() self:_clearBodyPose();self.jumpWasPressed=false;self.lastRealPoseAt=nil end)
end
function Feature:Panic()
    self.state:Set("recoil.zero",false);self.state:Set("bhop.enabled",false)
