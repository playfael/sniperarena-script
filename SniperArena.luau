function UI:_t(key)
    local locale = self.state:Get("language", "pt")
    return (LANG[locale] and LANG[locale][key]) or LANG.pt[key] or key
end
function UI:_lcopy(original)
    if type(original)~="string" then return tostring(original or "") end
    if self.state:Get("language","pt")=="en" then
        if STATIC_COPY_EN[original] then return STATIC_COPY_EN[original] end
        for key, ptText in pairs(LANG.pt) do
            if ptText==original then return LANG.en[key] or original end
        end
    end
    return original
end
function UI:_trackCopy(object, property, original)
    self.staticCopies=self.staticCopies or {}
    if original and type(original)=="string" then
        table.insert(self.staticCopies,{object=object,property=property,source=original})
        object[property]=self:_lcopy(original)
    end
    return object
end
function UI:_translate(obj, key)
    self.translations[obj]=key
    obj.Text=self:_t(key)
    return obj
end
function UI:_anim(obj, duration, goals, easing)
    if not obj or not obj.Parent then return end
    if self.state:Get("ui.animation",true)==false then
        for property,value in pairs(goals) do obj[property]=value end
        return nil
    end
    local running = self.tweens[obj]
    if running then running:Cancel() end
    local tween=TweenService:Create(obj, TweenInfo.new(duration or .2,easing or Enum.EasingStyle.Quart, Enum.EasingDirection.Out), goals)
    self.tweens[obj]=tween
    tween:Play()
    tween.Completed:Once(function() if self.tweens[obj]==tween then self.tweens[obj]=nil end end)
    return tween
end
function UI:_conn(signal, fn)
    local c=signal:Connect(fn)
    table.insert(self.connections,c)
    return c
end
function UI:_watch(key, fn, immediate)
    local stop=self.state:Watch(key,fn,immediate)
    table.insert(self.unwatch,stop)
    return stop
end
function UI:_clickAnim(button, neutral, hover)
    local normal=neutral or button.BackgroundColor3
    local over=hover or C.hover
    button:SetAttribute("mnzsNormalColor",normal)
    button.MouseEnter:Connect(function() self:_anim(button,.14,{BackgroundColor3=over}) end)
    button.MouseLeave:Connect(function()
        self:_anim(button,.16,{BackgroundColor3=button:GetAttribute("mnzsNormalColor") or normal})
    end)
    button.MouseButton1Down:Connect(function() self:_anim(button,.08,{BackgroundColor3=C.redDark}) end)
    button.MouseButton1Up:Connect(function() self:_anim(button,.1,{BackgroundColor3=over}) end)
end

function UI.new(opts)
    local self=setmetatable({}, UI)
    self.state=assert(opts.state,"State necessário")
    self.engine=assert(opts.engine,"SkinEngine necessário")
    self.assets=opts.assets or {}
    self.connections={}
    self.unwatch={}
    self.tweens={}
    self.translations={}
    self.pages={}
    self.tabButtons={}
    self.filterables={}
    self.activeTab="Skins"
    self.skinKind="Gloves"
    self.selectedWeaponByKind={Weapons="AK-47",Knives="Karambit",Gloves="Sports Gloves"}
    self.selectedSkinByWeapon={}
    self.favorites={}
    self.closing=false
    self.isOpen=true
    local ok,err=xpcall(function() self:Build();self.engine:Start() end,function(e)return debug.traceback(tostring(e),2)end)
    if not ok then
        pcall(function() self:Destroy() end)
        for _,connection in ipairs(self.connections or {}) do pcall(function() connection:Disconnect() end) end
        for _,unwatch in ipairs(self.unwatch or {}) do pcall(unwatch) end
        for _,tween in pairs(self.tweens or {}) do pcall(function() tween:Cancel() end) end
        if self.gui then self.gui:Destroy() end
        error(err)
    end
    return self
end

