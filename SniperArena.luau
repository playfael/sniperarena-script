function Feature:_convergedShotFrame(displayFrame,eye,distance,params)
    local hit=Workspace:Raycast(displayFrame.Position,displayFrame.LookVector*distance,params)
    local point=hit and hit.Position or displayFrame.Position+displayFrame.LookVector*distance
    point=self:_wallbangConvergence(displayFrame,point)
    local delta=point-eye
    local direction=delta.Magnitude>0.01 and delta.Unit or displayFrame.LookVector
    return CFrame.lookAlong(eye,direction),point
end
function Feature:_thirdPersonShotFrame(camera,useDisplayCache)
    if not self.config["world.thirdPerson"] then return nil end
    local actor=self.characterController and self.characterController.getCurrentCharacter()
    local part=actor and actor.CameraPart
    if not part or not part.Parent or not localAlive(actor.Character) then return nil end
    local frame=camera.CFrame
    if useDisplayCache and self.displayFrame and self.displayCharacter==actor.Character and os.clock()-(self.displayFrameAt or 0)<0.15 then frame=self.displayFrame end
    local shot,point=self:_convergedShotFrame(frame,part.Position,5000,self.rayParams or self:_rayParams())
    return shot,point,part.Position
end
function Feature:_performThirdPersonRaycast(original,bullet,spread)
    local camera=Workspace.CurrentCamera
    local frame,eye
    if camera then
        local shotFrame,_,origin=self:_thirdPersonShotFrame(camera,true)
        frame,eye=shotFrame,origin
    end
    if not frame then return original(bullet,spread) end
    local display=camera.CFrame
    camera.CFrame=frame
    local values=table.pack(pcall(original,bullet,spread))
    camera.CFrame=display
    if not values[1] then error(values[2],0) end
    self.stats.thirdPersonShots+=1
    local shot=values[2]
    if type(shot)=="table" and typeof(shot.Origin)=="Vector3" then
        self.stats.thirdPersonOriginError=(shot.Origin-eye).Magnitude
        self.stats.thirdPersonCameraDistance=(display.Position-eye).Magnitude
        self:_measureShotDirection(shot,frame.LookVector)
    end
    return table.unpack(values,2,values.n)
end
function Feature:_measureShotDirection(shot,direction)
    if type(shot)=="table" and typeof(shot.Direction)=="Vector3" and shot.Direction.Magnitude>0 then
        local actual=shot.Direction.Unit
        self.stats.lastShotAimErrorDegrees=math.deg(math.atan2(actual:Cross(direction).Magnitude,actual:Dot(direction)))
    end
end
function Feature:_performWeaponRaycast(original,bullet,spread)
    local effective=spread
