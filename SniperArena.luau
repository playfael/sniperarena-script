local State = (function()
-- Luau | ModuleScript State | Roblox Studio/client
local State = {}
State.__index = State

local function copy(value)
    if type(value) ~= "table" then return value end
    local result = {}
    for k, v in pairs(value) do result[copy(k)] = copy(v) end
    return result
end

function State.new(defaults)
    local self = setmetatable({}, State)
    self.defaults = copy(defaults or {})
    self.values = copy(self.defaults)
    self.listeners = {}
    self.allListeners = {}
    return self
end

function State:Get(key, fallback)
    local value = self.values[key]
    if value == nil then return fallback end
    return value
end

function State:Set(key, value)
    local old = self.values[key]
    if old == value then return end
    self.values[key] = value
    local listeners = self.listeners[key]
    if listeners then
        for _, callback in ipairs(table.clone(listeners)) do
            local ok, err = pcall(callback, value, old)
            if not ok then warn("[MNZS State] " .. tostring(err)) end
        end
    end
    for _, callback in ipairs(table.clone(self.allListeners)) do
        local ok, err = pcall(callback, key, value, old)
        if not ok then warn("[MNZS State] " .. tostring(err)) end
    end
end

function State:Watch(key, fn, immediate)
    local listeners = self.listeners[key]
    if not listeners then listeners = {}; self.listeners[key] = listeners end
    table.insert(listeners, fn)
    if immediate then fn(self:Get(key)) end
    return function()
        local index = table.find(listeners, fn)
        if index then table.remove(listeners, index) end
    end
end

function State:OnChange(fn)
    table.insert(self.allListeners, fn)
    return function()
        local index = table.find(self.allListeners, fn)
        if index then table.remove(self.allListeners, index) end
    end
end

function State:Snapshot()
    return copy(self.values)
end

function State:Restore(snapshot)
    if type(snapshot) ~= "table" then return end
    for key, value in pairs(snapshot) do self:Set(key, copy(value)) end
end

function State:Reset()
    local keys = {}
    for key in pairs(self.values) do keys[key] = true end
    for key in pairs(self.defaults) do keys[key] = true end
    for key in pairs(keys) do self:Set(key, copy(self.defaults[key])) end
end

return State

end)()
-- Sniper Arena: native cosmetic models, independent from inventory and weapon statistics.
local SkinEngine=(function()
    local R=game:GetService("ReplicatedStorage")
    local RunService=game:GetService("RunService")
    local E=require(R.Remote.EntityService)
    local Combat=require(R.Remote.CombatService)
    local W=require(R.Config.WeaponConfig)
    local API=require(R.Client.WeaponController.API)
    local WeaponController=require(R.Client.WeaponController)
    local NativeWeapon=require(R.Client.WeaponController.Weapon)
    local Engine={};Engine.__index=Engine
    local visualKeys={FakeArmAnims=true,CharacterAnims=true,SecondFakeArmAnims=true,SecondCharacterAnims=true,
        ExtraStandbyAnim=true,HiddenArm=true,FirstPersonArmSkin=true,ReverseHand=true,UseFreePart=true,BodyVisible=true,ViewAnimDuration=true,
        SecondarySwitch=true,SecondarySwitchChance=true,Sounds=true,MoonAnimEffects=true,Instances=true,SkinMaterials=true,
        WesternShadowScreen=true,ShootAnimAlign=true,ShootMuzzleDelay=true}
    local function family(name) local item=W[name];return item and (item.Family or item.Name) end
    local function currentWeapons()
        local result={}
        -- The native collection implements __iter; pairs() exposes its internal storage.
        for _,weapon in Combat.GetWeapons(E.LocalEntity) do
            if type(weapon)=="table" then result[weapon]=true end
        end
        return result
    end
    local function ownField(object,key,value)
        if type(STATE)=="table" and type(STATE.override)=="function" then
            STATE.override(object,key,value)
        else
            object[key]=value
        end
    end
    function Engine.new()
        local self=setmetatable({catalog={},kinds={},profiles={},live={},inFlight={},pendingEquips={},weaponOverride=false,presentations=setmetatable({},{__mode="k"}),autoApply=true,enabled=true,stopped=false,stats={rebuilds=0,restored=0,equipPlays=0}},Engine)
        for name,item in pairs(W) do
            if type(name)=="string" and type(item)=="table" and item.Name and item.Family then
                local group=item.Family
                local kind=item.WeaponType=="Melee" and "Knives" or item.WeaponType=="Glove" and "Gloves" or "Weapons"
                if item.WeaponType=="Sniper" or item.WeaponType=="Pistol" or item.WeaponType=="Melee" or item.WeaponType=="Glove" then
                    self.catalog[group]=self.catalog[group] or {}
                    self.kinds[group]=kind
                    table.insert(self.catalog[group],{skin=name,display=item.Display or name,rarity=tostring(item.Rarity or "Stock"),image=item.Image})
                end
            end
        end
        for _,list in pairs(self.catalog) do table.sort(list,function(a,b)return a.skin<b.skin end) end
        return self
    end
    function Engine:Category(name) return self.kinds[name] or self.kinds[family(name)] or "Weapons" end
    function Engine:GetWeapons(kind)
        local list={};for name in pairs(self.catalog) do if not kind or self:Category(name)==kind then table.insert(list,name) end end
        table.sort(list);return list
    end
    function Engine:GetSkins(name) return self.catalog[name] or {} end
    function Engine:GetWears() return {"Padrão"} end
    function Engine:GetPreviewImage(_,info) return info and info.image end
    function Engine:_folder() return nil end
    function Engine:Equipped() local w=Combat.GetCurrentWeapon(E.LocalEntity);return w and (family(w.CustomModel) or family(w.Name)) end
    function Engine:_desired(weapon)
        local group=family(weapon.Name)
        local kind=self:Category(group)
        if kind=="Weapons" and self.weaponOverride and self.selectedVisualWeapon and self.profiles[self.selectedVisualWeapon] then group=self.selectedVisualWeapon end
        if kind=="Knives" and self._v92selectedKnife and self.profiles[self._v92selectedKnife] then group=self._v92selectedKnife end
        if kind=="Gloves" and self._v92selectedGlove and self.profiles[self._v92selectedGlove] then group=self._v92selectedGlove end
        return group,self.profiles[group]
    end
    function Engine:WeaponVisualSelection()
        return {enabled=self.weaponOverride,selected=self.selectedVisualWeapon}
    end
    function Engine:RestoreWeaponVisual(saved)
        if saved==nil then return true end
        if type(saved)~="table" or type(saved.enabled)~="boolean" then return false,"Seleção visual de arma inválida" end
        if saved.selected~=nil and (type(saved.selected)~="string" or not self.profiles[saved.selected] or self:Category(saved.selected)~="Weapons") then return false,"Modelo visual salvo indisponível" end
        local previousEnabled,previousSelected=self.weaponOverride,self.selectedVisualWeapon
        self.weaponOverride=saved.enabled;self.selectedVisualWeapon=saved.selected
        local ok,err=pcall(self._tick,self)
        if not ok then
            self.weaponOverride=previousEnabled;self.selectedVisualWeapon=previousSelected;pcall(self._tick,self)
            return false,tostring(err)
        end
        return true,"Seleção visual restaurada"
    end
    function Engine:SetWeaponOverride(enabled,selected)
        if self.stopped then return false,"Skin changer descarregado" end
        local target=selected and self.profiles[selected] and self:Category(selected)=="Weapons" and selected or self.selectedVisualWeapon
        local ok,message=self:RestoreWeaponVisual({enabled=enabled==true,selected=target})
        if not ok then return false,message end
        return true,self.weaponOverride and "Modelo livre ligado: a aparência muda; tiro e munição continuam os da arma real" or "Modelo livre desligado: skins por família de arma"
    end
    function Engine:_validate(skin,kind)
        local loader=kind=="Gloves" and API.LoadAccessoryModel or API.LoadWeaponModel
        local available=0
        for _,modelType in ipairs({"FirstPerson","ThirdPerson"}) do
            local model
            local ok,err=pcall(function()
                model=loader(skin,modelType)
                if model then
                    assert(model:FindFirstChildWhichIsA("BasePart",true),"Modelo sem partes visuais")
                    available+=1
                end
            end)
            if model then model:Destroy() end
            if not ok then error(tostring(err)) end
        end
        assert(available>0,"Modelo desta skin ainda não está disponível no cliente")
    end
    function Engine:_stamp(weapon,skin)
        local controller=weapon.Controller
        for _,cache in ipairs({controller and controller.Models or {},controller and controller.Accessories or {}}) do
            for _,record in pairs(cache) do
                if type(record)=="table" and record.Model and record.Model:GetAttribute("MNZSLocalSkin")~=skin then record.Model:SetAttribute("MNZSLocalSkin",skin) end
            end
        end
    end
    function Engine:_presentation(controller)
        if self.stopped or not self.enabled then return end
        local weapon=controller.Weapon
        if not weapon or controller.Entity~=E.LocalEntity then return end
        local _,profile=self:_desired(weapon)
        local record=self.live[weapon]
        local skin=weapon.CustomModel
        -- During rollback the desired profile has not been reverted yet. Use the
        -- model actually being rebuilt, provided it belongs to this engine.
        if not record or not skin or (skin~=record.skin and (not profile or skin~=profile.skin)) then return end
        local selected=W[skin]
        if not selected then error("Configuração cosmética ausente") end
        local owned=self.presentations[controller]
        if owned and owned.skin==skin and controller.Config==owned.config then return end
        local original=controller.Config
        -- Only the visual controller sees these animation/rig fields. The actual
        -- weapon and all gameplay components retain their original configuration.
        local presentation=setmetatable({}, {__index=function(_,key)
            if key=="DisableSwitchSkin" then return true end
            if visualKeys[key] then return selected[key] end
            return original[key]
        end})
        ownField(controller,"Config",presentation)
        local originalGetSound=controller.GetSound
        ownField(controller,"GetSound",function(holder,name,args)
            if self.stopped then return originalGetSound(holder,name,args) end
            return API.GetWeaponSound(skin,name,nil,holder.Weapon and holder.Weapon.WeaponForm or holder.WeaponForm or 1,args)
        end)
        -- Components captured the original Config in their constructors. Give their
        -- visual callbacks the same presentation, retaining all logical fields from
        -- the real weapon. Reload only native cosmetic component parameters.
        for name,component in pairs(controller.Components or {}) do
            ownField(component,"Config",presentation)
            if name=="Muzzle" or name=="Shootable" then
                local config=selected.ControllerComponents and selected.ControllerComponents[name] or {}
                component:LoadConfig(config)
            end
        end
        ownField(controller,"ConfigInstances",{})
        if selected.WeaponController=="Gun.WesternShadow" or selected.WeaponController=="Melee.WesternShadow" then
            -- This audited subclass only adds its local inspection screen effect;
            -- its native task holder cancels the effect when the controller ends.
            local visualClass=selected.WeaponController=="Melee.WesternShadow"
                and require(R.Client.WeaponController.Weapon.Melee.WesternShadow)
                or require(R.Client.WeaponController.Weapon.Gun.WesternShadow)
            ownField(controller,"UpdateViewAnim",visualClass.UpdateViewAnim)
        end
        self.presentations[controller]={skin=skin,config=presentation}
    end
    function Engine:_scheduleEquip(controller)
        local presentation=self.presentations[controller]
        if self.stopped or not presentation or not presentation.skin or not controller:IsInWeaponActionContext() then return end
        local weapon=controller.Weapon
        local selected=W[presentation.skin]
        local clip=selected and (selected.FakeArmAnims and selected.FakeArmAnims.Switch or selected.CharacterAnims and selected.CharacterAnims.Switch)
        if not weapon or not clip then return end
        local old=self.pendingEquips[controller]
        if old then pcall(task.cancel,old) end
        local thread
        thread=task.defer(function()
            local ok,err=pcall(function()
