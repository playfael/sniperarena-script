    end
    function Engine:_rebuild(weapon)
        -- Native Create tears down the old visual controller and binds the replacement.
        -- Weapon data and its gameplay components are retained, not cloned or reconfigured.
        local name,config,token,ammo=weapon.Name,weapon.Config,weapon.Token,weapon._Ammo
        local controller=WeaponController.Create(E.LocalEntity,weapon)
        assert(controller and not controller.Destroyed and weapon.Controller==controller,"O jogo não criou o controlador visual")
        if not self.stopped and self.enabled then
            local record=self.live[weapon]
            local _,profile=self:_desired(weapon)
            if record and weapon.CustomModel and (weapon.CustomModel==record.skin or profile and weapon.CustomModel==profile.skin) then
                local presentation=self.presentations[controller]
                assert(presentation and presentation.skin==weapon.CustomModel and presentation.config==controller.Config,"O jogo não aplicou as animações da skin: "..tostring(presentation and presentation.error or "callback ausente"))
            end
        end
        assert(weapon.Name==name and weapon.Config==config and weapon.Token==token and weapon._Ammo==ammo,"Os dados da arma mudaram durante a troca")
        self.stats.rebuilds+=1
        return controller
    end
    function Engine:_applyWeapon(weapon,group,skin)
        if self.inFlight[weapon] then return end
        local controller=weapon.Controller
        local record=self.live[weapon]
        if (not controller or controller.Destroyed or controller.Destroying) and not (record and record.error) then return end
        local presentation=controller and self.presentations[controller]
        if controller and not controller.Destroyed and not controller.Destroying and record and record.skin==skin and weapon.CustomModel==skin and presentation and presentation.config==controller.Config and presentation.skin==skin then
            self:_stamp(weapon,skin);record.controller=controller
            return
        end
        local fresh=not record
        if fresh then record={original=weapon.CustomModel};self.live[weapon]=record end
        local previous=weapon.CustomModel
        local previousSkin,previousGroup=record.skin,record.group
        self.inFlight[weapon]=true
        local ok,err=pcall(function()
            if fresh then ownField(weapon,"CustomModel",skin) else weapon.CustomModel=skin end
            record.controller=self:_rebuild(weapon)
            self:_stamp(weapon,skin)
        end)
        if ok then
            record.skin=skin;record.group=group;record.error=nil
        else
            weapon.CustomModel=previous
            local recovered,recovery=pcall(self._rebuild,self,weapon)
            record.skin=previousSkin;record.group=previousGroup
            if recovered then
                record.controller=recovery
                if previousSkin then self:_stamp(weapon,previousSkin) end
                if fresh then self.live[weapon]=nil end
            else
                record.error=tostring(recovery)
                self.lastError="Falha na recuperação visual: "..record.error
            end
        end
        self.inFlight[weapon]=nil
        if not ok then error(tostring(err)..(record.error and "; "..self.lastError or "; visual anterior recuperado")) end
    end
    function Engine:_restoreWeapon(weapon,active)
        local record=self.live[weapon]
        if not record then return 0 end
        self.inFlight[weapon]=true
        -- STATE may already have restored this property on reload: rebuild regardless.
        -- Preserve a different cosmetic value subsequently supplied by the game.
        if weapon.CustomModel==record.skin or weapon.CustomModel==record.original then weapon.CustomModel=record.original end
        local ok,err=true,nil
        if active then
            ok,err=pcall(self._rebuild,self,weapon)
        end
        self.inFlight[weapon]=nil
        if not ok then record.error=tostring(err);error("Não foi possível restaurar o modelo: "..tostring(err)) end
        self.live[weapon]=nil
        self.stats.restored+=1
        return 1
    end
    function Engine:_tick()
        if self.stopped or not self.enabled or self.busy then return end
        self.busy=true
        local ok,err=pcall(function()
            local active=currentWeapons()
            for weapon in pairs(active) do
                local group,profile=self:_desired(weapon)
                if profile then self:_applyWeapon(weapon,group,profile.skin)
                elseif self.live[weapon] then self:_restoreWeapon(weapon,true) end
            end
            local retired={}
            for weapon in pairs(self.live) do if not active[weapon] then retired[#retired+1]=weapon end end
            for _,weapon in ipairs(retired) do self:_restoreWeapon(weapon,false) end
        end)
        self.busy=false
        if not ok then error(err) end
    end
    function Engine:Apply(group,skin)
        if self.stopped then return false,"Skin changer descarregado" end
        if not W[skin] or not self.catalog[group] or family(skin)~=group then return false,"Skin incompatível com este modelo" end
        local kind=self:Category(group)
        local valid,reason=pcall(self._validate,self,skin,kind)
        if not valid then return false,tostring(reason) end
        local previous=table.clone(self.profiles)
        local previousKnife,previousGlove,previousWeapon=self._v92selectedKnife,self._v92selectedGlove,self.selectedVisualWeapon
        if kind=="Weapons" then self.selectedVisualWeapon=group end
        if kind=="Knives" or kind=="Gloves" then
            for name in pairs(self.profiles) do if self:Category(name)==kind then self.profiles[name]=nil end end
            if kind=="Knives" then self._v92selectedKnife=group else self._v92selectedGlove=group end
        end
        self.profiles[group]={skin=skin,wear="Padrão"}
        local ok,err=pcall(self._tick,self)
        if not ok then
            self.profiles=previous;self._v92selectedKnife=previousKnife;self._v92selectedGlove=previousGlove;self.selectedVisualWeapon=previousWeapon
            local recovered,recovery=pcall(self._tick,self)
            self.lastError=tostring(err)..(not recovered and "; recuperação: "..tostring(recovery) or "")
            return false,self.lastError
        end
        self.lastError=nil
        local applied=false
        for _,record in pairs(self.live) do if record.group==group and record.skin==skin then applied=true;break end end
        return true,applied and "Skin local aplicada ao modelo completo" or "Skin salva; será aplicada ao equipar a arma"
    end
    function Engine:Restore(group)
        if group then self.profiles[group]=nil else table.clear(self.profiles) end
        if not group or self._v92selectedKnife==group then self._v92selectedKnife=nil end
        if not group or self._v92selectedGlove==group then self._v92selectedGlove=nil end
        if not group or self.selectedVisualWeapon==group then self.selectedVisualWeapon=nil end
        if not group then self.weaponOverride=false end
        local active=currentWeapons()
        local pending={}
        for weapon,record in pairs(self.live) do if not group or record.group==group then pending[#pending+1]=weapon end end
        local count,errors=0,{}
        for _,weapon in ipairs(pending) do
            local ok,result=pcall(self._restoreWeapon,self,weapon,active[weapon])
            if ok then count+=result else errors[#errors+1]=tostring(result) end
        end
        if #errors>0 then self.lastError=table.concat(errors,"; ");return count,self.lastError,false end
        self.lastError=nil
        return count,"Modelo original restaurado",true
    end
    function Engine:Start()
        if self.connection or self.stopped then return end
        -- Early runs synchronously before the game's normal Created listeners bind
        -- arms and animation adapters, and before Create activates the new controller.
        self.createdConnection=NativeWeapon.Event.Created:ConnectEarly(function(controller)
            local ok,err=pcall(self._presentation,self,controller)
            if not ok then self.presentations[controller]={error=tostring(err)};self.lastError=tostring(err) end
        end)
        self.activatedConnection=NativeWeapon.Event.Activated:ConnectPost(function(controller)
            self:_scheduleEquip(controller)
        end)
        local nextUpdate=0
        self.connection=RunService.Heartbeat:Connect(function()
            if os.clock()<nextUpdate or not self.autoApply then return end
            nextUpdate=os.clock()+0.2
            local ok,err=pcall(self._tick,self)
            if not ok then self.lastError=tostring(err);nextUpdate=os.clock()+3 end
        end)
    end
    function Engine:Destroy()
        if self.stopped and next(self.live)==nil then return true end
        self.stopped=true
        if self.connection then self.connection:Disconnect();self.connection=nil end
        if self.createdConnection then self.createdConnection:Disconnect();self.createdConnection=nil end
        if self.activatedConnection then self.activatedConnection:Disconnect();self.activatedConnection=nil end
        for controller,thread in pairs(self.pendingEquips) do pcall(task.cancel,thread);self.pendingEquips[controller]=nil end
        local _,message,ok=self:Restore()
        if not ok then _,message,ok=self:Restore() end
        if not ok then warn("MNZS skins: "..message) end
        return ok,message
    end
    return Engine
end)()

