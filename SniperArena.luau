function Feature:_transformCommand(actor,context,command)
    if type(command)~="table" or not self.running or not self:_canInput() then
        self.jumpWasPressed=false;self.stats.antiAimStatus="paused";return command
    end
    local now=os.clock()
    local firing=self.fireHeld or self.inputDriver.isLeftDown()
    if firing then self.realPoseUntil=now+0.16 end
    if self.config["spin.enabled"] and now>=self.realPoseUntil then
        local yaw=now*math.rad(self.config["spin.speed"])*(self.config["spin.direction"]=="Left" and -1 or 1)
        yaw=math.atan2(math.sin(yaw),math.cos(yaw))
        local inputMove=command.Move.Magnitude>1 and command.Move.Unit or command.Move
        local worldMove=CFrame.Angles(0,command.LookYaw,0):VectorToWorldSpace(Vector3.new(inputMove.X,0,inputMove.Y))
        local corrected=CFrame.Angles(0,yaw,0):VectorToObjectSpace(worldMove)
        command.Move=Vector2.new(corrected.X,corrected.Z)
        command.LookYaw=yaw
        command.VerticalLook=math.sin(math.rad(self.config["spin.pitch"]))
        self.stats.antiAimCommands+=1;self.stats.antiAimStatus="body-rotation"
    else
        self.lastRealPoseAt=now;self.lastRealPoseGeneration=actor.Generation
        self.stats.realAimCommands+=1;self.stats.antiAimStatus=self.config["spin.enabled"] and "firing-pose" or "off"
    end
    local hopping=self.config["bhop.enabled"] and (self.config["bhop.activation"]=="Always" or self:_keyHeld(self.config["bhop.key"]))
    if hopping then
        local movement=context and context.State or actor.MovementState
        local grounded=movement and movement.OnGround==true
        local jump=grounded and not self.jumpWasPressed
        command.Buttons=bit32.replace(command.Buttons,jump and 1 or 0,0,1)
        self.jumpWasPressed=jump
        if jump then self.stats.bhopJumps+=1 end
    else self.jumpWasPressed=false end
    self.lastCommandYaw,self.lastCommandPitch=command.LookYaw,command.VerticalLook
    return command
end
function Feature:_requestShotPose()
    if not self.config["spin.enabled"] then return true end
    local now=os.clock()
    if not self.shotPoseRequestAt or now-self.shotPoseRequestAt>0.5 then self.shotPoseRequestAt=now end
    self.realPoseUntil=now+0.16
    local actor=self.characterController and self.characterController.getCurrentCharacter()
    if self.lastRealPoseAt and self.lastRealPoseAt>=self.shotPoseRequestAt and actor and actor.Generation==self.lastRealPoseGeneration then
        self.shotPoseRequestAt=nil
        return true
    end
    self.stats.triggerStatus="waiting-real-aim-command"
    return false
end
function Feature:_captureRecoilSprings(fn)
    if not debug or type(debug.getupvalues)~="function" then return end
    local ok,values=pcall(debug.getupvalues,fn)
    if not ok then return end
    for _,value in pairs(values) do
        if type(value)=="table" and type(value.reset)=="function" and type(value.getPosition)=="function" then self.recoilSprings[value]=true end
    end
end
function Feature:_resetRecoilSprings()
    for spring in pairs(self.recoilSprings) do spring:reset(Vector3.zero) end
end
function Feature:_zeroWeaponRecoil(weapon)
    local recoil=weapon and weapon.Recoil
    if type(recoil)~="table" then return end
    local owner=self.recoilOwners[recoil]
    if not owner then owner={original=recoil.Function};self.recoilOwners[recoil]=owner end
    if recoil.Function~=zeroPattern then owner.original=recoil.Function;recoil.Function=zeroPattern end
    recoil.Value,recoil.RecoveryValue,recoil.RotationValue=Vector2.zero,Vector2.zero,Vector3.zero
    recoil.Time=0
end
function Feature:_restoreWeaponRecoil()
    for recoil,owner in pairs(self.recoilOwners) do
        if recoil.Function==zeroPattern then recoil.Function=owner.original end
    end
