local baseStep=Feature._stepBase
function Feature:_step(dt)
    if self.entityDirty then self:_refreshEntities();self.rayParams=self:_rayParams() end
    local camera=Workspace.CurrentCamera
    if camera and self.config["world.thirdPerson"] and localAlive(getCharacter(LocalPlayer)) then
        local delta=camera.CFrame.RightVector*self.config["world.thirdSide"]+Vector3.new(0,self.config["world.thirdHeight"],0)
        if delta.Magnitude>0.001 then
            local origin=camera.CFrame.Position
            local hit=Workspace:Raycast(origin,delta,self.rayParams or self:_rayParams())
            if hit then delta=hit.Position+hit.Normal*0.15-origin end
            camera.CFrame+=delta
        end
    end
    if camera and self.config["world.thirdPerson"] then
        self.displayFrame=camera.CFrame;self.displayFrameAt=os.clock();self.displayCharacter=getCharacter(LocalPlayer)
    else self.displayFrame=nil;self.displayCharacter=nil end
    baseStep(self,dt)
