end
function Feature:_updateCombo()
    if not self.config["recoil.zero"] then
        if self.recoilWasZero then self:_resetRecoilSprings();self:_restoreWeaponRecoil() end
        self.recoilWasZero=false
        return
    end
    self.recoilWasZero=true
    self:_resetRecoilSprings()
    local inventory=self.inventoryController
    local weapon=inventory and inventory.peekCurrentEquippedForMovement and inventory.peekCurrentEquippedForMovement()
    self:_zeroWeaponRecoil(weapon)
    self.stats.zeroRecoilWeapon=weapon and weapon.Name or ""
    for recoil in pairs(self.recoilOwners) do
        -- Destroyed/equipped-away weapons must not retain our function indefinitely.
        if not weapon or recoil~=weapon.Recoil then
            local owner=self.recoilOwners[recoil]
            if recoil.Function==zeroPattern then recoil.Function=owner.original end
            self.recoilOwners[recoil]=nil
        end
    end
end
function Feature:_installComboAdapters()
    local bulletClass=self.bulletClass
    if bulletClass and type(bulletClass._performRaycast)=="function" then
        local original=bulletClass._performRaycast
        self:_ownComboOverride(bulletClass,"_performRaycast",function(bullet,spread)
            if self.running then return self:_performWeaponRaycast(original,bullet,spread) end
            return original(bullet,spread)
        end)
    end
    local class=self.characterClass
    if class and type(class.SampleInput)=="function" then
        local sample=class.SampleInput
        self:_ownComboOverride(class,"SampleInput",function(actor,context)
            local command=sample(actor,context)
            return self:_transformCommand(actor,context,command)
        end)
        local present=class.Present
        self:_ownComboOverride(class,"Present",function(actor,...)
            local result=present(actor,...)
            if actor.Player==LocalPlayer then self:_presentBodyPose(actor) end
            return result
        end)
    end
    local controller=self.cameraController
    for _,key in ipairs({"weaponKick","setWeaponRecoil"}) do
        local original=controller and controller[key]
        if type(original)=="function" then
            self:_captureRecoilSprings(original)
            self:_ownComboOverride(controller,key,function(...)
                if self.running and self.config["recoil.zero"] then
                    self:_resetRecoilSprings();self.stats.recoilBlocks+=1
                    return
                end
                return original(...)
            end)
        end
    end
end
function Feature:ApplyCombo()
    for key,value in pairs({["legit.enabled"]=true,["legit.activation"]="Always",["legit.part"]="Head",["legit.smooth"]=0,
        ["profiles.enabled"]=false,["trigger.enabled"]=true,["trigger.activation"]="Always",["trigger.part"]="Head",
        ["trigger.delay"]=0,["spin.enabled"]=true,["spin.pitch"]=-89,["recoil.zero"]=true,["recoil.noSpread"]=true,["rcs.enabled"]=false,
        ["bhop.enabled"]=true,["bhop.activation"]="Hold",["bhop.key"]="Space",["world.thirdPerson"]=true}) do self.state:Set(key,value) end
