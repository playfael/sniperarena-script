local function decodeBase64(data, expectedSize)
    local native = type(crypt) == "table" and crypt.base64_decode
        or type(base64_decode) == "function" and base64_decode
    if type(native) == "function" then
        local ok, result = pcall(native, data)
        if ok and type(result) == "string" and #result == expectedSize then return result end
    end
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local values = {}
    for i = 1, #alphabet do values[alphabet:byte(i)] = i - 1 end
    data = data:gsub("%s+", "")
    local chunks = {}
    for i = 1, #data, 4 do
        local a, b, c, d = data:byte(i, i + 3)
        local n = (values[a] or 0) * 262144 + (values[b] or 0) * 4096
            + (values[c] or 0) * 64 + (values[d] or 0)
        local first = math.floor(n / 65536) % 256
        local second = math.floor(n / 256) % 256
        local third = n % 256
        if c == 61 or not c then
            chunks[#chunks + 1] = string.char(first)
        elseif d == 61 or not d then
            chunks[#chunks + 1] = string.char(first, second)
        else
            chunks[#chunks + 1] = string.char(first, second, third)
        end
    end
    return table.concat(chunks)
end
local function ensureFolders()
    if type(makefolder) ~= "function" then return end
    for _, folder in ipairs({"MNZS", "MNZS/themes"}) do
        local exists = false
        if type(isfolder) == "function" then
            local ok, found = pcall(isfolder, folder)
            exists = ok and found == true
        end
        if not exists then pcall(makefolder, folder) end
    end
end

