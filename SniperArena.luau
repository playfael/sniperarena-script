-- Sniper Arena adapters. Reuse UI and geometry; use the game's entity collection.
local SniperEntity=require(game:GetService("ReplicatedStorage").Remote.EntityService)
local SniperCombat=require(game:GetService("ReplicatedStorage").Remote.CombatService)
local SniperSettings=require(game:GetService("ReplicatedStorage").Client.Settings)
local SniperCamera=require(game:GetService("ReplicatedStorage").Client.CameraController)
local SniperWeapons=require(game:GetService("ReplicatedStorage").Config.WeaponConfig)
local SniperConstants=require(game:GetService("ReplicatedStorage").Constant)
local combatOrigin=SniperCamera.GetCombatOriginFn()
local previousNew=Feature.new
specs["world.fov"].max=120
local unsupported={"aim.wallbang","recoil.zero","recoil.noSpread","rcs.enabled","profiles.enabled","world.reduceFlash"}
function Feature.new(state,ui)
    local self=previousNew(state,ui)
    self.sniperProxies={};self.sniperSequence=0
    self.cameraController=nil
    self.nativeRaycast=nil;self.nativeIgnore=nil
    for _,key in ipairs(unsupported) do state:Set(key,false) end
    return self
end
function Feature.SettingsPath()
    return "MNZS/SniperArena/config-"..tostring(game.GameId).."-"..tostring(LocalPlayer.UserId)..".json"
end
local function entityProxy(self,entity)
    local proxy=self.sniperProxies[entity]
    if proxy then return proxy end
    self.sniperSequence+=1
    local instance=entity.Instance
    proxy={_sniperEntity=entity,Name=instance.Name,DisplayName=instance:IsA("Player") and instance.DisplayName or instance.Name,
        UserId=instance:IsA("Player") and instance.UserId or -self.sniperSequence,Parent=instance.Parent}
    function proxy:GetAttribute(key)
        if key=="Health" then return entity.Health end
        if key=="MaxHealth" then return entity.MaxHealth end
        if key=="Team" then return entity.Team end
        if key=="Dead" then return not entity:IsAlive() end
        return instance:GetAttribute(key)
    end
    self.sniperProxies[entity]=proxy
    return proxy
end
function Feature:_refreshEntities()
    local seen={};local count=0
    for _,entity in SniperEntity.WorldManager.GetFocusedEntities() do
        if entity~=SniperEntity.LocalEntity and type(entity.GetModel)=="function" and type(entity.GetRootPart)=="function" then
            local proxy=entityProxy(self,entity)
            local character=entity:GetModel();local root=entity:GetRootPart()
            proxy.Character=character;proxy.Parent=entity.Instance.Parent
            seen[proxy]=true
            local record=self.records[proxy]
            if record and record.character~=character then self:_destroyBundle(record);record=nil end
            if not record then
                record={player=proxy,entity=entity,character=character,root=root,parts={},body={},skeleton={},visibility={},boundsAt=0,rigAt=0,weapon=""}
                self.records[proxy]=record
            end
            record.root=root;record.entity=entity
            local rig=character
            if character and not character:FindFirstChild("UpperTorso") and not character:FindFirstChild("Torso") then
                for _,child in ipairs(character:GetChildren()) do
                    if child:IsA("Model") and (child:FindFirstChild("UpperTorso") or child:FindFirstChild("Torso")) then rig=child;break end
                end
            end
            if character and (record.rig~=rig or os.clock()-record.rigAt>0.3 or not record.parts.Head) then
                record.rig=rig
                record.rigAt=os.clock();record.parts={};record.body={};record.skeleton={};record.boundsAt=0
                for _,name in ipairs(bodyNames) do
                    local part=basePart(rig,name)
                    if part then record.parts[name]=part;table.insert(record.body,part) end
                end
                if not record.parts.Head then
                    local collider=character:FindFirstChild("Collider")
                    if collider then
                        local head=basePart(collider,"Head");local body=basePart(collider,"Body")
                        record.parts.Head=head;record.parts.Torso=body
                        for _,part in ipairs(collider:GetChildren()) do if part:IsA("BasePart") then table.insert(record.body,part) end end
                    end
                end
                for _,joint in ipairs(record.parts.UpperTorso and skeletonR15 or skeletonR6) do
                    local a,b=record.parts[joint[1]],record.parts[joint[2]]
                    if a and b then table.insert(record.skeleton,{a,b}) end
                end
            end
            local weapon=SniperCombat.GetCurrentWeapon(entity)
            record.weapon=weapon and weapon.Name or ""
            record.ammo=weapon and weapon._Ammo and weapon._Ammo.Ammo
            record.armor=math.max(0,tonumber(entity.Shield) or 0)
            if character and root and entity:IsAlive() then count+=1 end
        end
    end
    for proxy,record in pairs(self.records) do
        if not seen[proxy] then
            self:_destroyBundle(record)
            if self.highlights[proxy] then self.highlights[proxy]:Destroy();self.highlights[proxy]=nil end
            self.records[proxy]=nil;self.memory[proxy]=nil
            self.sniperProxies[proxy._sniperEntity]=nil
        end
    end
    local weapon=SniperCombat.GetCurrentWeapon(SniperEntity.LocalEntity)
    self.currentWeapon=weapon and weapon.Name
    self.currentAmmo=weapon and weapon._Ammo and weapon._Ammo.Ammo
    self.stats.entities=count;self.entityDirty=false
end
function Feature:_extraAimFilter() return true end
local previousPartMatches=Feature._partMatches
function Feature:_partMatches(part,region)
    if part and part.Name=="Body" and (region=="Chest" or region=="Stomach" or region=="Pelvis") then return true end
    return previousPartMatches(self,part,region)
end
function Feature:_installPerspectiveAdapter() end
function Feature:_shotEye(camera)
    local frame=combatOrigin()
    return typeof(frame)=="CFrame" and frame.Position or camera.CFrame.Position
end
function Feature:_thirdPersonShotFrame(camera)
    local frame=combatOrigin()
    return typeof(frame)=="CFrame" and frame or camera.CFrame
end
local previousRegionParts=Feature._regionParts
function Feature:_regionParts(record,region)
    -- Keep the visual rig for ESP/skeleton; aim at the native queried hitboxes.
    local collider=record.character and record.character:FindFirstChild("Collider")
    local name=(region=="Head" or region=="Neck") and "Head"
        or (region=="Chest" or region=="Stomach" or region=="Pelvis") and "Body"
    local part=collider and name and collider:FindFirstChild(name)
    if part and part:IsA("BasePart") then return {part} end
    return previousRegionParts(self,record,region)
end
function Feature:_aimDelta(camera,position,alpha)
    -- Selection and trigger must use the same native combat frame, including
    -- camera offsets. Mouse input still follows the game's native sensitivity.
    local frame=self:_thirdPersonShotFrame(camera)
    local relative=frame:PointToObjectSpace(position)
    local yaw=math.atan2(relative.X,-relative.Z)
    local pitch=math.atan2(relative.Y,math.sqrt(relative.X*relative.X+relative.Z*relative.Z))
    local horizontal,vertical=self:_mouseRadiansPerCount()
    local delta=Vector2.new(yaw/horizontal,-pitch/vertical)
    local mode=self.config["rage.enabled"] and "rage" or self.config["legit.enabled"] and "legit"
    -- Zero smoothing means a full correction for both ordinary and 360 FOV.
    -- The inherited half-gain/frame cap made ordinary FOV lag behind fast targets.
    if mode and self:_effectiveSmooth(mode)<=0 then return delta*alpha end
    delta*=alpha*self.config["aim.gain"]
    local limit=self.config["aim.maxStep"]
    return delta.Magnitude>limit and delta.Unit*limit or delta
end
local sniperBaseAimInput=Feature._drawAimAndInputBase
local sniperMoveMouse=Feature._moveMouse
function Feature:_moveMouse(delta)
    if self.collectSniperAim then
        self.sniperAimDelta=(self.sniperAimDelta or Vector2.zero)+delta
        return
    end
    return sniperMoveMouse(self,delta)
end
function Feature:_drawAimAndInput(camera,size,dt)
    -- Update selection now, probe the confirmed pose, then queue the new input.
    -- Mouse injection does not synchronously update the native combat frame.
    self.collectSniperAim=true;self.sniperAimDelta=nil
    local ok,err=pcall(sniperBaseAimInput,self,camera,size,dt)
    self.collectSniperAim=nil
    local delta=self.sniperAimDelta;self.sniperAimDelta=nil
    if not ok then error(err,0) end
    self:_updateFire()
    if delta then sniperMoveMouse(self,delta) end
    self:_updateRcs()
end
function Feature:_rayParams()
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.IgnoreWater=true
    local excluded={}
    local mine=SniperEntity.LocalEntity:GetModel()
    if mine then table.insert(excluded,mine) end
    if Workspace.CurrentCamera then table.insert(excluded,Workspace.CurrentCamera) end
    local temp=Workspace:FindFirstChild("_Temp")
    if temp then table.insert(excluded,temp) end
    params.FilterDescendantsInstances=excluded
    return params
end
function Feature:_updateCamera()
    local desired=self.config["world.thirdPerson"] and SniperEntity.LocalEntity:IsAlive() and LocalPlayer:GetAttribute("combatPaused")~=true
    if desired and not self.sniperPerspective then
        self.sniperPerspective={min=LocalPlayer.CameraMinZoomDistance,max=LocalPlayer.CameraMaxZoomDistance,mode=LocalPlayer.CameraMode}
        SniperSettings.SetForceCameraMode("MNZS_SniperArena",SniperConstants.CameraMode.ThirdPerson,100)
        LocalPlayer.CameraMode=Enum.CameraMode.Classic
    elseif not desired and self.sniperPerspective then
        self:_restorePerspective()
    end
    if desired then
        local distance=self.config["world.thirdDistance"]
        LocalPlayer.CameraMaxZoomDistance=distance;LocalPlayer.CameraMinZoomDistance=distance
    end
end
function Feature:_restorePerspective()
    if not self.sniperPerspective then return end
    local backup=self.sniperPerspective;self.sniperPerspective=nil
    SniperSettings.SetForceCameraMode("MNZS_SniperArena",nil)
    LocalPlayer.CameraMinZoomDistance=backup.min;LocalPlayer.CameraMaxZoomDistance=backup.max;LocalPlayer.CameraMode=backup.mode
end
function Feature:_updateRcs() end
function Feature:_restoreSniperFov()
    local backup=self.sniperFov
    self.sniperFov=nil
    if backup and backup.camera.Parent and backup.camera.FieldOfView==backup.last then backup.camera.FieldOfView=backup.value end
end
local previousDestroy=Feature.Destroy
function Feature:Destroy()
    self:_restoreSniperFov()
    return previousDestroy(self)
end
function Feature:_step(dt)
    if self.entityDirty then self:_refreshEntities();self.rayParams=self:_rayParams() end
    local camera=Workspace.CurrentCamera
    if camera and self.config["world.fovEnabled"] and not (self.config["world.keepScope"] and (self:_sniperIsAiming() or camera.FieldOfView<50)) then
        if self.sniperFov and self.sniperFov.camera~=camera then self:_restoreSniperFov() end
        if not self.sniperFov then self.sniperFov={camera=camera,value=camera.FieldOfView} end
        if self.sniperFov.last~=camera.FieldOfView then self.sniperFov.value=camera.FieldOfView end
        camera.FieldOfView=self.config["world.fov"];self.sniperFov.last=camera.FieldOfView
    else self:_restoreSniperFov() end
    local me=SniperEntity.LocalEntity
    local humanoid=me.Humanoid
    if self.config["bhop.enabled"] and not self.ui.isOpen and Input:GetFocusedTextBox()==nil and type(isrbxactive)=="function" and isrbxactive()
        and me:IsAlive() and LocalPlayer:GetAttribute("combatPaused")~=true and humanoid and humanoid.FloorMaterial~=Enum.Material.Air
        and (self.config["bhop.activation"]=="Always" or self:_keyHeld(self.config["bhop.key"])) then humanoid.Jump=true end
    self:_stepBase(dt)
end
function Feature:Start()
    if self.running then return end
    self:_startBase()
    local originalInvoke=self.apiHandler
    self.api.OnInvoke=function(action,key,value)
        if action=="SkinApply" then return self.ui.engine:Apply(key,value,"Padrão") end
        if action=="SkinRestore" then return self.ui.engine:Restore(key) end
        if action=="Catalog" then
            local result={families=0,skins=0}
            for _,list in pairs(self.ui.engine.catalog) do result.families+=1;result.skins+=#list end
            return result
        end
        return originalInvoke(action,key,value)
    end
    local function dirty() self.entityDirty=true;self.nextRefresh=0;self.nextEsp=0 end
    for _,event in ipairs({SniperEntity.WorldManager.Event.EntityFocus,SniperEntity.WorldManager.Event.EntityUnfocus,SniperEntity.WorldManager.Event.FocusedWorldChanged}) do
        self:_connect(event,dirty)
    end
    self:_connect(Input.InputBegan,function(input,processed)
        if processed or self.ui.isOpen or self.ui.waitKey or Input:GetFocusedTextBox() then return end
        local name=input.UserInputType==Enum.UserInputType.Keyboard and input.KeyCode.Name or input.UserInputType.Name
        if self.config["trigger.activation"]=="Toggle" and name==self.config["trigger.key"] then self.toggled.trigger=not self.toggled.trigger end
    end)
    self.unwatch[#self.unwatch+1]=self.state:OnChange(function()
        if self.config["settings.autoSave"] then self.saveDirtyAt=os.clock()+0.6 end
    end)
    self:_connect(RunService.Heartbeat,function()
        if not self.running or not self.persistenceReady or not self.config["settings.autoSave"] then return end
        local now=os.clock()
        if self.saveDirtyAt and now>=self.saveDirtyAt then self.saveDirtyAt=nil;self:SaveSettings() end
        if now>=self.nextSavePoll then
            self.nextSavePoll=now+1
            local ok,raw=pcall(function() return Http:JSONEncode(encodeValue(self:_settingsPayload())) end)
            if ok and raw~=self.lastSavedRaw then self:SaveSettings() end
        end
    end)
end
