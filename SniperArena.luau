function Feature:_refreshEntitiesBase()
    local seen={}
    for _,player in ipairs(Players:GetPlayers()) do
        if player~=LocalPlayer then
            seen[player]=true
            local character=getCharacter(player)
            local record=self.records[player]
            if record and record.character~=character then self:_destroyBundle(record);record=nil end
            if not record then
                record={player=player,character=character,parts={},body={},skeleton={},visibility={},boundsAt=0,rigAt=0,weapon=""}
                self.records[player]=record
            end
            if character and (#record.body<6 or (not record.parts.Head) or os.clock()-record.rigAt>0.25) then
                record.parts,record.body,record.skeleton={},{},{}
                record.rigAt=os.clock()
                record.boundsAt=0
                for _,name in ipairs(bodyNames) do
                    local part=basePart(character,name)
                    if part then record.parts[name]=part;record.body[#record.body+1]=part end
                end
                record.root=basePart(character,"HumanoidRootPart")
                for _,names in ipairs(record.parts.UpperTorso and skeletonR15 or skeletonR6) do
                    local a,b=record.parts[names[1]],record.parts[names[2]]
                    if a and b then record.skeleton[#record.skeleton+1]={a,b} end
                end
            end
            local raw=player:GetAttribute("CurrentEquipped")
            if raw~=record.weaponRaw then
                record.weaponRaw=raw
                record.weapon,record.ammo="",nil
                if type(raw)=="string" then
                    local ok,data=pcall(Http.JSONDecode,Http,raw)
                    if ok and type(data)=="table" then
                        record.weapon=type(data.Name)=="string" and data.Name or ""
                        record.ammo=finite(data.Rounds) and data.Rounds or nil
                    end
                end
            end
        end
    end
    for player,record in pairs(self.records) do
        if not seen[player] then self:_destroyBundle(record);self.records[player]=nil end
    end
    local count=0
    for _,record in pairs(self.records) do if record.character and record.root then count+=1 end end
    self.stats.entities=count
end
function Feature:_rayParams()
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.IgnoreWater=true
    local excluded={}
    local own=getCharacter(LocalPlayer)
    if own then excluded[#excluded+1]=own end
    if Workspace.CurrentCamera then excluded[#excluded+1]=Workspace.CurrentCamera end
    for _,name in ipairs({"Debris","ThirdPersonWeaponStash"}) do
        local folder=Workspace:FindFirstChild(name)
        if folder then excluded[#excluded+1]=folder end
    end
    params.FilterDescendantsInstances=excluded
    return params
end
function Feature:_visible(record,position,key,interval)
    local now=os.clock()
    local camera=Workspace.CurrentCamera
    if not camera then return false end
    local origin=camera.CFrame.Position
    local cached=record.visibility[key]
    if cached and now-cached.time<interval and (cached.origin-origin).Magnitude<4 and (cached.position-position).Magnitude<4 then return cached.value end
    local delta=position-origin
    local hit=Workspace:Raycast(origin,delta,self.rayParams or self:_rayParams())
    local yes=not hit or hit.Instance:IsDescendantOf(record.character)
    record.visibility[key]={time=now,origin=origin,position=position,value=yes}
    self.stats.rays+=1
    return yes
end
function Feature:_bounds(record,now)
    local root=record.root
    if not root or not root.Parent then return nil,nil end
    if record.boundsMin and now-record.boundsAt<0.1 then return record.boundsMin,record.boundsMax end
    local low,high=Vector3.new(math.huge,math.huge,math.huge),Vector3.new(-math.huge,-math.huge,-math.huge)
    local count=0
    for _,part in ipairs(record.body) do
        if part.Parent then
            local relative=root.CFrame:ToObjectSpace(part.CFrame)
            local x,y,z,r00,r01,r02,r10,r11,r12,r20,r21,r22=relative:GetComponents()
            local size=part.Size*0.5
            local extent=Vector3.new(math.abs(r00)*size.X+math.abs(r01)*size.Y+math.abs(r02)*size.Z,math.abs(r10)*size.X+math.abs(r11)*size.Y+math.abs(r12)*size.Z,math.abs(r20)*size.X+math.abs(r21)*size.Y+math.abs(r22)*size.Z)
            local center=Vector3.new(x,y,z)
            low=low:Min(center-extent)
            high=high:Max(center+extent)
            count+=1
        end
    end
    if count==0 then return nil,nil end
    record.boundsMin,record.boundsMax,record.boundsAt=low,high,now
    return low,high
end
function Feature:_boxGeometry(record,camera,size,now)
    local low,high=self:_bounds(record,now)
    if not low then return nil end
    local center,half=(low+high)*0.5,(high-low)*0.5
    local world={}
    local left,top,right,bottom=math.huge,math.huge,-math.huge,-math.huge
    local allFront=true
    for i,sign in ipairs(cornerSigns) do
        local p=record.root.CFrame:PointToWorldSpace(center+Vector3.new(half.X*sign[1],half.Y*sign[2],half.Z*sign[3]))
        world[i]=p
        local screen,depth=project(camera,p)
        if depth<=0.1 then allFront=false else
            left,top=math.min(left,screen.X),math.min(top,screen.Y)
            right,bottom=math.max(right,screen.X),math.max(bottom,screen.Y)
        end
    end
    local intersects=allFront and right>0 and left<size.X and bottom>0 and top<size.Y
    return {world=world,left=math.max(0,left),top=math.max(0,top),right=math.min(size.X,right),bottom=math.min(size.Y,bottom),onScreen=intersects,allFront=allFront}
end
function Feature:_arrow(bundle,record,camera,size,color)
    local relative=camera.CFrame:PointToObjectSpace(record.root.Position)
    local direction=Vector2.new(relative.X,-relative.Y)
    if direction.Magnitude<0.01 then direction=Vector2.new(0,1) end
    direction=direction.Unit
    local radius=math.max(40,math.min(size.X,size.Y)*0.42)
    local center=size*0.5+direction*radius
    local normal=Vector2.new(-direction.Y,direction.X)
    local d=bundle.arrow
    if not d then d=self:_newDraw("Triangle",{Filled=true},bundle);bundle.arrow=d end
    d.PointA=center+direction*9
    d.PointB=center-direction*7+normal*6
    d.PointC=center-direction*7-normal*6
    d.Color=color
    d.Visible=true
end
function Feature:_drawEspBase(camera,size,now)
    self.stats.boxes,self.stats.skeletonSegments,self.stats.texts,self.stats.visibleEntities=0,0,0,0
    local cfg=self.config
    for _,record in pairs(self.records) do
        self:_hideBundle(record)
        record.lastBox=nil
        if not cfg["esp.enabled"] or (cfg["esp.hideWithMenu"] and self.ui.isOpen) then continue end
        local character,root=record.character,record.root
        if not character or not root or not root.Parent then continue end
        local health,maximum=healthOf(record.player,character)
        if health<=0 or (cfg["esp.team"] and not isEnemy(record.player,character)) then continue end
        local distance=(root.Position-camera.CFrame.Position).Magnitude
        if distance>cfg["esp.distanceLimit"] then continue end
        local visible=true
        if cfg["esp.visibilityColors"] or cfg["esp.visibleOnly"] then
            local point=record.parts.Head or record.parts.UpperTorso or root
            visible=self:_visible(record,point.Position,"esp",0.1)
        end
        if cfg["esp.visibleOnly"] and not visible then continue end
        local color=cfg[visible and "esp.colorVisible" or "esp.colorHidden"]
        local bundle=self:_bundle(record)
        local box=self:_boxGeometry(record,camera,size,now)
        if not box then continue end
        if not box.onScreen then
            if cfg["esp.arrows"] then self:_arrow(bundle,record,camera,size,color) end
            if cfg["esp.box"] and cfg["esp.boxType"]=="3D" and not box.allFront then
                for i,edge in ipairs(boxEdges) do
                    local a,b=worldSegment(camera,box.world[edge[1]],box.world[edge[2]],size)
                    self:_line(bundle,"box"..i,a,b,color,cfg["esp.thickness"],cfg["esp.outline"])
                end
            end
            continue
        end
        self.stats.visibleEntities+=1
        local x,y,w,h=box.left,box.top,box.right-box.left,box.bottom-box.top
        if w<1 or h<1 then continue end
        record.lastBox={x=x,y=y,width=w,height=h,type=cfg["esp.boxType"],visible=visible}
        if cfg["esp.box"] then
            local segments={}
            if cfg["esp.boxType"]=="3D" then
                for _,edge in ipairs(boxEdges) do
                    local a,b=worldSegment(camera,box.world[edge[1]],box.world[edge[2]],size)
                    segments[#segments+1]={a,b}
                end
            elseif cfg["esp.boxType"]=="Corner" then
                local cx,cy=w*0.25,h*0.22
                segments={{Vector2.new(x,y),Vector2.new(x+cx,y)},{Vector2.new(x,y),Vector2.new(x,y+cy)},{Vector2.new(x+w,y),Vector2.new(x+w-cx,y)},{Vector2.new(x+w,y),Vector2.new(x+w,y+cy)},{Vector2.new(x,y+h),Vector2.new(x+cx,y+h)},{Vector2.new(x,y+h),Vector2.new(x,y+h-cy)},{Vector2.new(x+w,y+h),Vector2.new(x+w-cx,y+h)},{Vector2.new(x+w,y+h),Vector2.new(x+w,y+h-cy)}}
            else
                segments={{Vector2.new(x,y),Vector2.new(x+w,y)},{Vector2.new(x+w,y),Vector2.new(x+w,y+h)},{Vector2.new(x+w,y+h),Vector2.new(x,y+h)},{Vector2.new(x,y+h),Vector2.new(x,y)}}
            end
            for i,segment in ipairs(segments) do self:_line(bundle,"box"..i,segment[1],segment[2],color,cfg["esp.thickness"],cfg["esp.outline"]) end
            self.stats.boxes+=1
        end
        if cfg["esp.skeleton"] then
            for i,pair in ipairs(record.skeleton) do
                if pair[1].Parent and pair[2].Parent then
                    local a,b=worldSegment(camera,pair[1].Position,pair[2].Position,size)
                    self:_line(bundle,"bone"..i,a,b,color,cfg["esp.thickness"],cfg["esp.outline"])
                    if a then self.stats.skeletonSegments+=1 end
                end
            end
        end
        if cfg["esp.snapline"] then
            local origin=cfg["esp.snapOrigin"]
            local a=origin=="Top" and Vector2.new(size.X*0.5,0) or origin=="Center" and size*0.5 or origin=="Mouse" and Input:GetMouseLocation() or Vector2.new(size.X*0.5,size.Y-2)
            self:_line(bundle,"snap",a,Vector2.new(x+w*0.5,y+h),color,1,cfg["esp.outline"])
        end
        local textSize=cfg["esp.textSize"]
        if cfg["esp.name"] then self:_text(bundle,"name",cfg["esp.displayName"] and record.player.DisplayName or record.player.Name,Vector2.new(x+w*0.5,math.max(0,y-textSize-4)),white) end
        local nextY=y+h+3
        if cfg["esp.weapon"] and type(record.weapon)=="string" and record.weapon~="" then
            local text=record.weapon
            if cfg["esp.ammo"] and record.ammo then text..=" ["..tostring(record.ammo).."]" end
            self:_text(bundle,"weapon",text,Vector2.new(x+w*0.5,nextY),white)
            nextY+=textSize+2
        end
        if cfg["esp.distance"] then self:_text(bundle,"distance",tostring(math.floor(distance+0.5)).." st",Vector2.new(x+w*0.5,nextY),white) end
        if cfg["esp.health"] then
            if not bundle.healthBack then
                bundle.healthBack=self:_newDraw("Square",{Filled=true,Color=black},bundle)
                bundle.healthFill=self:_newDraw("Square",{Filled=true},bundle)
            end
            local fraction=math.clamp(health/maximum,0,1)
            local barX=math.max(1,x-7)
            bundle.healthBack.Position=Vector2.new(barX-1,y-1)
            bundle.healthBack.Size=Vector2.new(5,h+2)
            bundle.healthBack.Visible=true
            bundle.healthFill.Position=Vector2.new(barX,y+h*(1-fraction))
            bundle.healthFill.Size=Vector2.new(3,math.max(1,h*fraction))
            bundle.healthFill.Color=Color3.fromRGB(240,70,80):Lerp(green,fraction)
            bundle.healthFill.Visible=true
        end
        if cfg["esp.healthNumber"] then self:_text(bundle,"health",tostring(math.ceil(health)),Vector2.new(math.max(2,x-31),y),green,false) end
    end
end

function Feature:_aimPoint(record,partChoice,camera,origin)
    local candidates={}
    if partChoice=="Head" then candidates={record.parts.Head}
    elseif partChoice=="Neck" then candidates={record.parts.Head or record.parts.UpperTorso}
    elseif partChoice=="Chest" then candidates={record.parts.UpperTorso or record.parts.Torso}
    elseif partChoice=="Stomach" then candidates={record.parts.LowerTorso or record.parts.Torso}
    elseif partChoice=="Legs" then candidates={record.parts.LeftUpperLeg,record.parts.RightUpperLeg,record.parts["Left Leg"],record.parts["Right Leg"]}
    elseif partChoice=="Pelvis" then candidates={record.parts.LowerTorso or record.parts.Torso or record.root}
    else
        for _,name in ipairs({"Head","UpperTorso","Torso","LowerTorso"}) do
            if record.parts[name] then candidates[#candidates+1]=record.parts[name] end
        end
        if #candidates==0 and record.root then candidates[1]=record.root end
    end
    local best,bestScreen,bestPosition,bestDistance=nil,nil,nil,math.huge
    local viewport=camera.ViewportSize
    for _,part in ipairs(candidates) do
        if part and part.Parent then
            local position=self:_regionPosition(part,partChoice)
            local screen,depth=project(camera,position)
            if depth>0.1 and screen.X>=0 and screen.X<=viewport.X and screen.Y>=0 and screen.Y<=viewport.Y then
                local d=(screen-origin).Magnitude
                if d<bestDistance then best,bestScreen,bestPosition,bestDistance=part,screen,position,d end
            end
        end
    end
    return best,bestScreen,bestDistance,bestPosition
end
function Feature:_candidate(record,mode,camera,origin)
    return self:_candidateAdvanced(record,mode,camera,origin)
end
function Feature:_keyHeld(key)
    if key=="None" then return false end
    if mouseKeys[key] then return Input:IsMouseButtonPressed(mouseKeys[key]) end
    local ok,item=pcall(function() return Enum.KeyCode[key] end)
    return ok and Input:IsKeyDown(item) or false
end
function Feature:_canInput()
    if Input:GetFocusedTextBox() or self.ui.waitKey then return false,"typing" end
    if os.clock()<self.inputCooldown then return false,"binding" end
    if self.config["aim.pauseMenu"] and (self.ui.isOpen or self.ui.closing) then return false,"menu" end
    if Input.MouseBehavior~=Enum.MouseBehavior.LockCenter then return false,"game-menu" end
    local own=getCharacter(LocalPlayer)
    if not localAlive(own) then return false,"local-dead" end
    if type(isrbxactive)~="function" or not isrbxactive() then return false,"window-unfocused" end
    return true,"ready"
end
function Feature:_moveMouse(delta)
    local combined=delta+self.mouseRemainder
    local x,y=roundSigned(combined.X),roundSigned(combined.Y)
    self.mouseRemainder=combined-Vector2.new(x,y)
    if x~=0 or y~=0 then
        mousemoverel(x,y)
        self.stats.inputs+=1
        self.stats.lastInput={x=x,y=y}
    end
end
function Feature:_mouseRadiansPerCount()
    -- CameraInput uses 0.5 degrees per count, a 0.77 pitch multiplier,
    -- Roblox MouseSensitivity and the game's MouseDeltaSensitivity.
    local setting=self.userGameSettings and self.userGameSettings.MouseSensitivity or 0.25
    local horizontal=math.rad(0.5)*math.max(0.01,setting)*math.max(0.01,Input.MouseDeltaSensitivity)
    local invert=self.userGameSettings and self.userGameSettings:GetCameraYInvertValue() or 1
    return horizontal,horizontal*0.77*invert
end
function Feature:_aimDelta(camera,position,alpha)
    local relative=camera.CFrame:PointToObjectSpace(position)
    local yaw=math.atan2(relative.X,-relative.Z)
    local pitch=math.atan2(relative.Y,math.sqrt(relative.X*relative.X+relative.Z*relative.Z))
    local horizontal,vertical=self:_mouseRadiansPerCount()
    local gain,limit=self.config["aim.gain"],self.config["aim.maxStep"]
    local mode=self.config["rage.enabled"] and "rage" or self.config["legit.enabled"] and "legit"
    if mode and self.config[mode..".fov360"] and self:_effectiveSmooth(mode)==0 then gain=1;limit=6000 end
    local delta=Vector2.new(yaw/horizontal,-pitch/vertical)*alpha*gain
    return delta.Magnitude>limit and delta.Unit*limit or delta
end
function Feature:_drawAimAndInputBase(camera,size,dt)
    local cfg=self.config
    local mode=cfg["rage.enabled"] and "rage" or cfg["legit.enabled"] and "legit" or nil
    local circle=self:_global("fov","Circle",{Filled=false,Thickness=1.5})
    local targetLine=self:_global("targetLine","Line",{Thickness=1.5})
    circle.Visible,targetLine.Visible=false,false
    self.stats.target=""
    local origin=size*0.5
    if mode and cfg[mode..".drawFov"] and not cfg[mode..".fov360"] then
        circle.Position,circle.Radius,circle.Color=origin,self:_effectiveFov(mode,camera),cfg[mode..".color"]
        circle.Visible=true
    end
    local canInput,why=self:_canInput()
    local activated=false
    if mode then
        activated=self:_activated(mode)
    end
    if not mode or not canInput or not activated then
        self.target=nil
        self.stats.status=not canInput and why or (mode and "await-key" or "idle")
        if not (canInput and self:_spinInput(dt)) then self.mouseRemainder=Vector2.zero end
        return
    end
    if type(mousemoverel)~="function" then self.stats.status="mouse-api-unavailable";return end
    local best=nil
    if cfg[mode..".sticky"] and self.target then
        local record=self.records[self.target]
        if record then best=self:_candidate(record,mode,camera,origin) end
    end
    if not best then
        for _,record in pairs(self.records) do
            local candidate=self:_candidate(record,mode,camera,origin)
            if candidate and (not best or candidate.score<best.score) then best=candidate end
        end
    end
    if not best then
        self.target=nil;self.aimPosition=nil;self.pendingTarget=nil;self.stats.status="no-eligible-target"
        if not self:_spinInput(dt) then self.mouseRemainder=Vector2.zero end
        return
    end
    self.target=best.record.player
    self.aimPosition=best.position;self.aimPositionAt=os.clock()
    self.stats.target=self.target.Name
    self.stats.targetPixels=best.pixels
    self.stats.status="tracking-"..mode
    if cfg[mode..".targetLine"] and best.onScreen~=false then
        targetLine.From,targetLine.To,targetLine.Color=origin,best.screen,cfg[mode..".color"]
        targetLine.Visible=true
    end
    if not self:_targetReady(best.record.player) then self.stats.status="target-switch-delay";return end
    local alpha=1
    local smoothing=self:_effectiveSmooth(mode)
    if smoothing>0 then alpha=1-math.exp(-math.min(dt,0.05)/(smoothing/1000)) end
    self:_moveMouse(self:_aimDelta(camera,best.position,alpha))
end

function Feature:_drawMiscBase(size)
    local cfg=self.config
    local mid=size*0.5
    for i=1,4 do self:_global("cross"..i,"Line",{Thickness=1.5}).Visible=false end
    if cfg["misc.crosshair"] then
        local gap,length=cfg["misc.crossGap"],cfg["misc.crossSize"]
        local segments={{mid+Vector2.new(-gap-length,0),mid+Vector2.new(-gap,0)},{mid+Vector2.new(gap,0),mid+Vector2.new(gap+length,0)},{mid+Vector2.new(0,-gap-length),mid+Vector2.new(0,-gap)},{mid+Vector2.new(0,gap),mid+Vector2.new(0,gap+length)}}
        for i,segment in ipairs(segments) do
            local d=self.globals["cross"..i]
            d.From,d.To,d.Color,d.Visible=segment[1],segment[2],cfg["misc.crossColor"],true
        end
    end
    local hud=self:_global("hud","Text",{Font=2,Size=13,Outline=true,Center=false})
    hud.Visible=cfg["misc.hud"]
    if hud.Visible then
        hud.Position=Vector2.new(14,math.max(15,size.Y-75))
        hud.Color=white
        local map=tostring(Workspace:GetAttribute("Map") or "")
        local timer=tostring(Workspace:GetAttribute("Timer") or "-")
        hud.Text=string.format("MNZS v%s | %d FPS | %.2f ms\n%s | %s s | ESP %d | %s%s",Feature.VERSION,self.stats.fps,self.stats.lastMs,map,timer,self.stats.visibleEntities,self.stats.status,self.stats.target~="" and " > "..self.stats.target or "")
    end
end
function Feature:_setLightProperty(property,target)
    if self.lightingBackup[property]==nil then
        self.lightingBackup[property]=Lighting[property]
        self.lightConnections[property]=Lighting:GetPropertyChangedSignal(property):Connect(function()
            if not self.running or self.lightWriting then return end
            local current=Lighting[property]
            if current~=self.lightTargets[property] then
                self.lightingBackup[property]=current
                self.lightWriting=true
                Lighting[property]=self.lightTargets[property]
                self.lightWriting=false
            end
        end)
    end
    self.lightTargets[property]=target
    self.lightWriting=true
    Lighting[property]=target
    self.lightWriting=false
end
function Feature:_restoreLight(property)
    local conn=self.lightConnections[property]
    if conn then conn:Disconnect();self.lightConnections[property]=nil end
    local value=self.lightingBackup[property]
    if value~=nil then
        if Lighting[property]==self.lightTargets[property] then Lighting[property]=value end
        self.lightingBackup[property],self.lightTargets[property]=nil,nil
    end
end
function Feature:_updateWorld()
    local cfg=self.config
    if cfg["world.fullbright"] then
        self:_setLightProperty("Brightness",2)
        self:_setLightProperty("ClockTime",14)
        self:_setLightProperty("Ambient",Color3.fromRGB(180,180,180))
        self:_setLightProperty("OutdoorAmbient",Color3.fromRGB(180,180,180))
    else
        for _,property in ipairs({"Brightness","ClockTime","Ambient","OutdoorAmbient"}) do self:_restoreLight(property) end
    end
    if cfg["world.noFog"] then self:_setLightProperty("FogEnd",1000000);self:_setLightProperty("FogStart",1000000)
    else self:_restoreLight("FogEnd");self:_restoreLight("FogStart") end
end
function Feature:_restorePerspective()
    local backup=self.perspectiveBackup
    if not backup then return end
    self.perspectiveBackup=nil
    LocalPlayer.CameraMaxZoomDistance=math.max(backup.maximum,LocalPlayer.CameraMinZoomDistance)
    LocalPlayer.CameraMinZoomDistance=backup.minimum
    LocalPlayer.CameraMaxZoomDistance=backup.maximum
    LocalPlayer.CameraMode=backup.mode
    self.appliedPerspective=nil
end
function Feature:_capturePerspective()
    if not self.perspectiveBackup then
        self.perspectiveBackup={mode=LocalPlayer.CameraMode,minimum=LocalPlayer.CameraMinZoomDistance,maximum=LocalPlayer.CameraMaxZoomDistance}
    end
end
function Feature:_updateCameraPartVisibility(active)
    local camera=Workspace.CurrentCamera
    if not active or not camera then
        for part,value in pairs(self.hiddenCameraParts) do
            if part.Parent and part.LocalTransparencyModifier==1 then part.LocalTransparencyModifier=value end
        end
        table.clear(self.hiddenCameraParts)
        if self.visibilityConnection then self.visibilityConnection:Disconnect();self.visibilityConnection=nil end
        self.visibilityCamera=nil
        self.nextCameraPartScan=0
        return
    end
    if camera~=self.visibilityCamera then
        if self.visibilityConnection then self.visibilityConnection:Disconnect() end
        self.visibilityCamera=camera
        self.visibilityConnection=camera.DescendantAdded:Connect(function() self.nextCameraPartScan=0 end)
        self.nextCameraPartScan=0
    end
    if os.clock()>=self.nextCameraPartScan then
        self.nextCameraPartScan=os.clock()+0.1
        -- Only equipped first-person camera models. Skin properties and native
        -- model construction stay untouched; this local camera override restores on exit.
        for _,model in ipairs(camera:GetChildren()) do
            if model:IsA("Model") and model:FindFirstChild("Stats") and model:FindFirstChild("CameraShake") then
                for _,part in ipairs(model:GetDescendants()) do
                    if part:IsA("BasePart") and self.hiddenCameraParts[part]==nil then
                        self.hiddenCameraParts[part]=part.LocalTransparencyModifier
                    end
                end
            end
        end
    end
    for part,value in pairs(self.hiddenCameraParts) do
        if not part.Parent or not part:IsDescendantOf(camera) then
            if part.Parent and part.LocalTransparencyModifier==1 then part.LocalTransparencyModifier=value end
            self.hiddenCameraParts[part]=nil
        elseif part.LocalTransparencyModifier~=1 then
            self.hiddenCameraParts[part]=part.LocalTransparencyModifier
            part.LocalTransparencyModifier=1
        end
    end
end
function Feature:_installPerspectiveAdapter()
    local controller=self.cameraController
    if not controller or type(controller.setPerspective)~="function" then return end
    local original=controller.setPerspective
    self.originalPerspective=original
    local replacement=function(firstPerson,mouseEnabled,distance)
        if self.running and self.config["world.thirdPerson"] and firstPerson==true and mouseEnabled~=true and localAlive(getCharacter(LocalPlayer)) then
            self:_capturePerspective()
            return original(false,mouseEnabled,self.config["world.thirdDistance"])
        end
        return original(firstPerson,mouseEnabled,distance)
    end
    self.perspectiveAdapter=replacement
    if type(MNZS_RELOAD_CONTEXT)=="table" and type(MNZS_RELOAD_CONTEXT.override)=="function" then
        MNZS_RELOAD_CONTEXT.override(controller,"setPerspective",replacement)
    else controller.setPerspective=replacement end
end
function Feature:_updateCamera()
    self:_updateCombo()
    local cfg,controller=self.config,self.cameraController
    if controller and type(controller.setForceLockOverride)=="function" then
        local menuOpen=self.ui.isOpen or self.ui.closing or false
        if self.menuUnlockApplied~=menuOpen then
            controller.setForceLockOverride("MNZSFeaturesMenu",menuOpen)
            self.menuUnlockApplied=menuOpen
        end
    end
    local own=getCharacter(LocalPlayer)
    local alive=localAlive(own)
    if cfg["world.thirdPerson"] and alive and controller and type(controller.setPerspective)=="function" then
        local distance=cfg["world.thirdDistance"]
        self:_capturePerspective()
        if self.appliedPerspective~=distance or LocalPlayer.CameraMode~=Enum.CameraMode.Classic or math.abs(LocalPlayer.CameraMinZoomDistance-distance)>0.01 then
            controller.setPerspective(false,false,distance)
            self.appliedPerspective=distance
        end
    else self:_restorePerspective() end
    self:_updateCameraPartVisibility(cfg["world.thirdPerson"] and alive)
    local fov=cfg["world.fovEnabled"] and alive and not (cfg["world.keepScope"] and LocalPlayer:GetAttribute("IsSniperScoped")==true)
    if controller and type(controller.setFOVLock)=="function" then
        local signature=fov and cfg["world.fov"] or false
        if self.appliedFov~=signature then
            controller.setFOVLock("MNZS_Features98",fov,cfg["world.fov"])
            self.appliedFov=signature
        end
    end
end
function Feature:_panicBase()
    for _,key in ipairs({"legit.enabled","rage.enabled","esp.enabled","spin.enabled","world.thirdPerson","world.fovEnabled","world.fullbright","world.noFog","misc.crosshair","misc.hud"}) do self.state:Set(key,false) end
    self.toggled={legit=false,rage=false}
    self.target=nil
    self:_hideAll()
    self:_updateWorld()
    self:_updateCamera()
end
function Feature:Reset()
    self:Panic()
    for key,def in pairs(specs) do self.state:Set(key,def.default) end
end
function Feature:_snapshotBase()
    local visible,drawings=0,0
    for d in pairs(self.drawings) do drawings+=1;if d.Visible then visible+=1 end end
    local entities={}
    for _,record in pairs(self.records) do
        local health,maximum=healthOf(record.player,record.character)
        entities[#entities+1]={name=record.player.Name,character=record.character and record.character:GetFullName(),health=health,maxHealth=maximum,team=teamOf(record.player,record.character),enemy=isEnemy(record.player,record.character),weapon=record.weapon,ammo=record.ammo,bones=#record.skeleton,box=record.lastBox}
    end
    return {version=Feature.VERSION,running=self.running,stats=table.clone(self.stats),drawings=drawings,visibleDrawings=visible,connections=#self.connections,entities=entities,menuOpen=self.ui.isOpen,capabilities={drawing=type(Drawing)=="table",mouse=type(mousemoverel)=="function",camera=self.cameraController~=nil},config=table.clone(self.config)}
end
function Feature:Probe(mode)
    mode=mode=="rage" and "rage" or "legit"
    local camera=Workspace.CurrentCamera
    if not camera then return {error="camera-unavailable"} end
    local origin=camera.ViewportSize*0.5
    local results={}
    for _,record in pairs(self.records) do
        local candidate,reason=self:_candidate(record,mode,camera,origin)
        results[#results+1]={name=record.player.Name,reason=reason,pixels=candidate and candidate.pixels,distance=candidate and candidate.distance,part=candidate and candidate.part.Name}
    end
    return results
end
function Feature:_stepBase(dt)
    local start=os.clock()
    self.stats.frames+=1
    self.frameCount+=1
    if start-self.frameWindow>=0.5 then self.stats.fps=math.floor(self.frameCount/(start-self.frameWindow)+0.5);self.frameCount=0;self.frameWindow=start end
    local camera=Workspace.CurrentCamera
    if not camera or camera.ViewportSize.X<=0 or camera.ViewportSize.Y<=0 then self:_hideAll();return end
    self:_drawAimAndInput(camera,camera.ViewportSize,dt)
    if start>=self.nextEsp then
        self.nextEsp=start+1/self.config["esp.fps"]
        self:_drawEsp(camera,camera.ViewportSize,start)
    end
    self:_drawMisc(camera.ViewportSize)
    self.stats.lastMs=(os.clock()-start)*1000
    self.stats.totalMs+=self.stats.lastMs
    self.stats.peakMs=math.max(self.stats.peakMs,self.stats.lastMs)
end
function Feature:_startBase()
    if self.running then return end
    self.running=true
    for key in pairs(specs) do
        local stop=self.state:Watch(key,function(value)
            self.config[key]=normalize(key,value)
            if specs[key].kind=="key" then self.inputCooldown=os.clock()+0.18;self.toggled={legit=false,rage=false} end
            if key=="legit.enabled" and value==true then self.state:Set("rage.enabled",false)
            elseif key=="rage.enabled" and value==true then self.state:Set("legit.enabled",false) end
        end,true)
        self.unwatch[#self.unwatch+1]=stop
    end
    self:_installPerspectiveAdapter()
    self:_connect(Input.InputBegan,function(input,processed)
        if self.ui.waitKey or Input:GetFocusedTextBox() or os.clock()<self.inputCooldown then return end
        local name=input.UserInputType==Enum.UserInputType.Keyboard and input.KeyCode.Name or input.UserInputType.Name
        if name==self.config["misc.panic"] then self:Panic();return end
        if processed or self.ui.isOpen then return end
        for _,mode in ipairs({"legit","rage"}) do
            if self.config[mode..".activation"]=="Toggle" and name==self.config[mode..".key"] then self.toggled[mode]=not self.toggled[mode] end
        end
        self:_handleFeatureBind(name)
    end)
    self:_connect(Input.WindowFocusReleased,function() self.toggled={legit=false,rage=false};self.target=nil;self.mouseRemainder=Vector2.zero end)
    self:_connect(LocalPlayer.CharacterRemoving,function() self.target=nil;self.toggled={legit=false,rage=false};self:_restorePerspective() end)
    self:_connect(LocalPlayer.CharacterAdded,function() self.nextRefresh=0;self.appliedPerspective=nil;self.toggled={legit=false,rage=false};self.mouseRemainder=Vector2.zero end)
    self:_connect(self.ui.gui.Destroying,function() self:Destroy() end)
    self:_connect(Workspace:GetPropertyChangedSignal("CurrentCamera"),function() self.nextRefresh=0;self.nextEsp=0;self.target=nil end)
    self:_connect(Players.PlayerRemoving,function(player)
        local record=self.records[player]
        if record then self:_destroyBundle(record);self.records[player]=nil end
        if self.target==player then self.target=nil end
    end)
    self:_connect(RunService.Heartbeat,function()
        if not self.running or os.clock()<self.nextRefresh then return end
        local active=self.config["esp.enabled"] or self.config["legit.enabled"] or self.config["rage.enabled"] or self.config["trigger.enabled"]
        self.nextRefresh=os.clock()+(active and 1/30 or 0.2)
        local ok,err=pcall(function()
            self:_refreshEntities()
            self.rayParams=self:_rayParams()
            self:_updateWorld()
        end)
        if not ok then self:_error(err) end
    end)
    self:_refreshEntities()
    self.rayParams=self:_rayParams()
    RunService:BindToRenderStep(self.perspectiveRenderName,Enum.RenderPriority.Camera.Value-5,function()
        if not self.running then return end
        local ok,err=pcall(self._updateCamera,self)
        if not ok then self:_error(err) end
    end)
    RunService:BindToRenderStep(self.renderName,Enum.RenderPriority.Last.Value-10,function(dt)
        if not self.running then return end
        local ok,err=xpcall(function() self:_step(dt) end,function(e) return debug.traceback(tostring(e),2) end)
        if not ok then self:_hideAll();self:_error(err) end
    end)
    local api=Instance.new("BindableFunction")
    api.Name="MNZSFeaturesAPI"
    local apiHandler=function(action,key,value)
        if action=="SaveSettings" then return self:SaveSettings()
        elseif action=="Unload" then self:Unload();return true
        elseif action=="ApplyPreset" then return self:ApplyPreset(key)
        elseif action=="ApplyCombo" then return self:ApplyCombo()
        elseif action=="Snapshot" then return self:Snapshot()
        elseif action=="Probe" then return self:Probe(key)
        elseif action=="TriggerProbe" then local record,reason=self:TriggerProbe();return {eligible=record~=nil,reason=reason,player=record and record.player.Name}
        elseif action=="SaveProfile" or action=="LoadProfile" or action=="DeleteProfile" then return self:SaveProfile(action)
        elseif action=="AimDelta" and typeof(key)=="Vector3" and Workspace.CurrentCamera then
            return self:_aimDelta(Workspace.CurrentCamera,key,finite(value) and math.clamp(value,0,1) or 1)
        elseif action=="Get" and specs[key] then return self.config[key]
        elseif action=="Set" and specs[key] then
            local valid,ok=normalize(key,value)
            if not ok then return false,"Invalid feature value" end
            self.state:Set(key,valid)
            return true
        elseif action=="Panic" then self:Panic();return true
        elseif action=="Reset" then self:Reset();return true
        elseif action=="Tab" and self.ui.pages[key] then self.ui:SelectTab(key);return true
        elseif action=="Locale" and (key=="pt" or key=="en") then self.state:Set("language",key);return true
        elseif action=="Menu" then if key==false then self.ui:Hide() else self.ui:Show() end;return true end
        return false,"Unknown feature action/key"
    end
    api.OnInvoke=apiHandler
    self.apiHandler=apiHandler
    api.Parent=self.ui.gui
    self.api=api
    self.ui.gui:SetAttribute("MNZSFeaturesVersion",Feature.VERSION)
end
function Feature:_error(message)
    self.stats.errors+=1
    self.stats.lastError=tostring(message)
    if not self.lastErrorTime or os.clock()-self.lastErrorTime>5 then self.lastErrorTime=os.clock();warn("[MNZS Features] "..tostring(message)) end
end
function Feature:_destroyBase()
    if not self.running then return end
    self.running=false
    RunService:UnbindFromRenderStep(self.renderName)
    RunService:UnbindFromRenderStep(self.perspectiveRenderName)
    for _,c in ipairs(self.connections) do c:Disconnect() end
    for _,stop in ipairs(self.unwatch) do stop() end
    table.clear(self.connections)
    table.clear(self.unwatch)
    self:_restorePerspective()
    self:_updateCameraPartVisibility(false)
    if self.visibilityConnection then self.visibilityConnection:Disconnect();self.visibilityConnection=nil end
    if self.cameraController and self.cameraController.setPerspective==self.perspectiveAdapter then
        self.cameraController.setPerspective=self.originalPerspective
    end
    if self.cameraController and type(self.cameraController.setFOVLock)=="function" then pcall(self.cameraController.setFOVLock,"MNZS_Features98",false) end
    if self.cameraController and type(self.cameraController.setForceLockOverride)=="function" then pcall(self.cameraController.setForceLockOverride,"MNZSFeaturesMenu",false) end
    local properties={}
    for property in pairs(self.lightingBackup) do properties[#properties+1]=property end
    for _,property in ipairs(properties) do self:_restoreLight(property) end
    for d in pairs(self.drawings) do self:_removeDrawing(d) end
    table.clear(self.records)
    table.clear(self.globals)
    if self.api then self.api:Destroy();self.api=nil end
    self.stats.status="stopped"
end

