-- Cria previews reais a partir das MeshParts/texturas que a experiencia disponibiliza.
-- Renderizacao acontece apenas para cards visiveis no scroll, com limite de memoria.
function UI:_makeViewportPreview(slot)
    if not slot.host or not slot.host.Parent then return false end
    local storage=game:GetService("ReplicatedStorage")
    local assets=storage:FindFirstChild("Assets")
    local weapons=assets and assets:FindFirstChild("Weapons")
    local weaponFolder=weapons and weapons:FindFirstChild(slot.weapon)
    local cameraFolder=weaponFolder and weaponFolder:FindFirstChild("Camera")
    local template=cameraFolder and cameraFolder:FindFirstChild("Weapon")
    if not template or not template:IsA("Model") then return false end
    local paints=self.engine:_folder(slot.weapon,slot.skin,slot.wear)
    if not paints then return false end
    local viewport=mk("ViewportFrame",{Name="Accurate3DPreview",BackgroundTransparency=1,
        Position=UDim2.fromScale(0,0),Size=UDim2.fromScale(1,1),
        Ambient=Color3.fromRGB(188,174,185),LightColor=Color3.fromRGB(245,222,233),
        LightDirection=Vector3.new(-.7,-1,-.6),ZIndex=21},slot.host)
    local world=mk("WorldModel",{},viewport)
    local cloned=template:Clone()
    for _,desc in ipairs(cloned:GetDescendants()) do
        if desc:IsA("BasePart") then desc.Anchored=true;desc.CanCollide=false end
        if desc:IsA("Script") or desc:IsA("LocalScript") or desc:IsA("ParticleEmitter") then desc:Destroy() end
    end
    cloned.Parent=world
    local function getSurface(part)
        for _,child in ipairs(part:GetChildren()) do
            if child:IsA("SurfaceAppearance") then return child end
        end
        return nil
    end
    local changed=0
    for _,mesh in ipairs(cloned:GetDescendants()) do
        if mesh:IsA("MeshPart") then
            local appearance=getSurface(mesh)
            local sample=paints:FindFirstChild(mesh.Name)
            if not sample and mesh.Parent then sample=paints:FindFirstChild(mesh.Parent.Name) end
            if appearance and sample and sample:IsA("SurfaceAppearance") then
                local ok=pcall(function()
                    local nextSurface=sample:Clone()
                    nextSurface.Name=appearance.Name
                    appearance:Destroy()
                    nextSurface.Parent=mesh
                end)
                if ok then changed+=1 end
            end
        end
    end
    -- Nao mostrar uma arma com skin errada se os materiais nao foram encontrados.
    if changed==0 then viewport:Destroy();return false end
    local success,cf,size=pcall(function()
        local bounding,size=cloned:GetBoundingBox()
        return bounding,size
    end)
    if not success then viewport:Destroy();return false end
    local largest=math.max(size.X,size.Y,size.Z,.3)
    local camera=mk("Camera",{FieldOfView=35},viewport)
    camera.CFrame=CFrame.new(cf.Position+Vector3.new(largest*.92,largest*.45,largest*1.75),cf.Position)
    viewport.CurrentCamera=camera
    slot.viewport=viewport
    slot.label.Visible=false
    return true
end
function UI:_syncPreviews()
    if not self.skinList or not self.skinList.Parent then return end
    local top=self.skinList.AbsolutePosition.Y
    local bottom=top+self.skinList.AbsoluteSize.Y
    local newCount=0
    for _,slot in ipairs(self.previewSlots or {}) do
        if slot.frame and slot.frame.Parent then
            local y=slot.frame.AbsolutePosition.Y
            local isVisible=(y+slot.frame.AbsoluteSize.Y>top-18) and (y<bottom+18)
            if isVisible and newCount<8 then
                newCount+=1
                if not slot.attempted then
                    slot.attempted=true
                    local ok,result=pcall(self._makeViewportPreview,self,slot)
                    if not ok or not result then slot.label.Text=self:_lcopy("SEM PRÉVIA") end
                end
            elseif slot.viewport then
                slot.viewport:Destroy();slot.viewport=nil;slot.attempted=false;slot.label.Visible=true
                slot.label.Text=self:_lcopy("PRÉVIA 3D")
            end
        end
    end
end

