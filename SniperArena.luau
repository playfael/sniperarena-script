function Feature:_line(bundle,key,a,b,color,thickness,outline)
    if not a or not b then return end
    local pair=bundle.lines[key]
    if not pair then
        pair={back=self:_newDraw("Line",{},bundle),front=self:_newDraw("Line",{},bundle)}
        bundle.lines[key]=pair
    end
    local back,front=pair.back,pair.front
    back.From,back.To,back.Color,back.Thickness=a,b,black,thickness+2
    back.ZIndex=1
    back.Visible=outline
    front.From,front.To,front.Color,front.Thickness=a,b,color,thickness
    front.ZIndex=2
    front.Visible=true
