    local decoded, cachedUri
    loaders[id] = function()
        if cachedUri then return cachedUri end
        local register = type(getcustomasset) == "function" and getcustomasset
            or type(getsynasset) == "function" and getsynasset
        if not register then return nil, "O executor nao oferece registro de imagem local." end
        local ok, result = pcall(function()
            if not decoded then
                decoded = decodeBase64(encoded, metadata.Size)
                if #decoded ~= metadata.Size then error("tamanho da imagem invalido") end
            end
            local existing
            if type(readfile) == "function" then
                local readOk, content = pcall(readfile, metadata.Path)
                if readOk and type(content) == "string" then existing = content end
            end
            if existing ~= decoded then
                if type(writefile) ~= "function" then error("writefile indisponivel") end
                ensureFolders()
                writefile(metadata.Path, decoded)
            end
            return register(metadata.Path)
        end)
        if ok and type(result) == "string" and result ~= "" then
            cachedUri = result
            return result
        end
        return nil, "Falha ao carregar a imagem " .. id .. ": " .. tostring(result)
    end
end

