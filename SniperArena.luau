function Feature:Snapshot()
    local snapshot=self:_snapshotV99()
    local count,springCount=0,0
    for _ in pairs(self.recoilOwners) do count+=1 end
    for _ in pairs(self.recoilSprings) do springCount+=1 end
    snapshot.combo={movementAdapter=self.characterClass~=nil,recoilSprings=springCount,recoilWeapons=count,
        yaw=self.lastCommandYaw,pitch=self.lastCommandPitch,realPoseUntil=self.realPoseUntil,poseApplied=self.bodyJoints~=nil,
        thirdPersonShotAdapter=self.bulletClass~=nil}
    return snapshot
end
function Feature:_destroyV912()
    self:_clearBodyPose();self:_restoreWeaponRecoil();self:_restoreComboOverrides()
    if self.recoilWasZero then self:_resetRecoilSprings() end
    self:_destroyV99()
end

-- v9.13: full-circle selection, native penetration, saved sessions and complete unload.
for _,mode in ipairs({"legit","rage"}) do
    spec(mode..".fov360","boolean",false)
    spec(mode..".regions","regions",{})
end
for _,weapon in ipairs(Feature.PROFILE_WEAPONS) do spec("profile."..weapon..".regions","regions",{}) end
spec("aim.wallbang","boolean",false)
spec("trigger.followRegions","boolean",true)
spec("trigger.regions","regions",{})
spec("settings.autoSave","boolean",true)

local function loadNative(path)
    local node=game:GetService("ReplicatedStorage")
    for name in string.gmatch(path,"[^.]+") do node=node and node:FindFirstChild(name) end
    if not node then return nil end
    local ok,value=pcall(require,node)
    return ok and value or nil
end
function Feature.new(state,ui)
    local self=Feature._newV912(state,ui)
    self.nativeRaycast=loadNative("Shared.Raycast")
    self.nativeIgnore=loadNative("Components.Common.GetRayIgnore")
    self.penetrationCache={}
    self.stats.penetrationChecks=0
    self.savePath=Feature.SettingsPath()
    self.nextSavePoll=0
    self.persistenceReady=false
    return self
end
function Feature:_selectedRegions(mode)
    if mode=="rage" and (self.config["rage.bodyAim"] or self:_keyHeld(self.config["rage.bodyKey"])) then return {"Chest"} end
    local prefix=mode=="legit" and self:_profile() or nil
    local choices=self.config[(prefix or mode..".").."regions"]
    if type(choices)=="table" and #choices>0 then return choices end
    local legacy=self:_effectivePart(mode)
    return legacy=="Closest" and {"Head","Chest","Stomach"} or {legacy}
end
function Feature:_regionParts(record,region)
    local p=record.parts
    if region=="Head" or region=="Neck" then return {p.Head or p.UpperTorso} end
    if region=="Chest" then return {p.UpperTorso or p.Torso} end
    if region=="Stomach" or region=="Pelvis" then return {p.LowerTorso or p.Torso or record.root} end
    return {p.LeftUpperLeg or p["Left Leg"],p.RightUpperLeg or p["Right Leg"]}
end
function Feature:_shotEye(camera)
    local actor=self.characterController and self.characterController.getCurrentCharacter()
    local part=actor and actor.CameraPart
    return part and part.Parent and part.Position or camera.CFrame.Position
end
function Feature:_weaponForPenetration()
    local inventory=self.inventoryController
    return inventory and inventory.peekCurrentEquippedForMovement and inventory.peekCurrentEquippedForMovement()
end
function Feature:_penetrationHits(origin,direction)
    local weapon=self:_weaponForPenetration()
    if not weapon or not weapon.Properties or not self.nativeRaycast or type(self.nativeRaycast.castThroughDistance)~="function" then return nil,"weapon" end
    local range=math.min(direction.Magnitude,weapon.Properties.Range or 500)
    if range<0.01 then return nil,"distance" end
    local ignored=type(self.nativeIgnore)=="function" and self.nativeIgnore() or (self.rayParams or self:_rayParams()).FilterDescendantsInstances
    self.stats.penetrationChecks+=1
    local ok,hits=pcall(self.nativeRaycast.castThroughDistance,origin,direction.Unit*range,weapon.Properties.Penetration or 0,ignored)
    return ok and hits or nil,ok and "native" or "unavailable"
end
function Feature:_canReach(record,position,wallbang)
    local camera=Workspace.CurrentCamera
    if not camera then return false,"camera" end
    local origin=self:_shotEye(camera)
    local delta=position-origin
    if delta.Magnitude<0.01 then return false,"distance" end
    local params=self.rayParams or self:_rayParams()
    local hit=Workspace:Raycast(origin,delta,params)
    if not hit or hit.Instance:IsDescendantOf(record.character) then return true,"visible" end
    if not wallbang then return false,"occluded" end
    local weapon=self:_weaponForPenetration()
    if not weapon or delta.Magnitude>(weapon.Properties.Range or 500) then return false,"weapon-range" end
    local key=tostring(record.character)..":"..tostring(position)..":"..tostring(weapon.Identifier)
    local cached=self.penetrationCache[key]
    local now=os.clock()
    if cached and now-cached.time<0.06 and (cached.origin-origin).Magnitude<0.15 then return cached.allowed,cached.reason end
    local hits=self:_penetrationHits(origin,delta.Unit*(delta.Magnitude+1))
    local allowed=false
    for _,entry in ipairs(hits or {}) do
        if entry.instance and entry.instance:IsDescendantOf(record.character) then allowed=true;break end
    end
    local reason=allowed and "penetrable" or "blocked"
    if not self.nextPenetrationClear or now>self.nextPenetrationClear then table.clear(self.penetrationCache);self.nextPenetrationClear=now+0.5 end
    self.penetrationCache[key]={time=now,origin=origin,allowed=allowed,reason=reason}
    return allowed,reason
end
function Feature:_candidateAdvanced(record,mode,camera,origin)
    if not record.character or not record.root or not record.root.Parent then return nil,"character" end
    local cfg=self.config
    local health=healthOf(record.player,record.character)
    if health<=0 then return nil,"dead" end
    if cfg[mode..".team"] and not isEnemy(record.player,record.character) then return nil,"team" end
    local eye=self:_shotEye(camera)
    local distance=(record.root.Position-eye).Magnitude
    if distance>cfg[mode..".distance"] then return nil,"distance" end
    local full=cfg[mode..".fov360"]
    local best,reason=nil,"offscreen"
    for _,region in ipairs(self:_selectedRegions(mode)) do
        for _,part in pairs(self:_regionParts(record,region)) do
            if part and part.Parent then
                local position=self:_regionPosition(part,region)
                local screen,depth=project(camera,position)
                local onScreen=depth>0.1 and screen.X>=0 and screen.X<=camera.ViewportSize.X and screen.Y>=0 and screen.Y<=camera.ViewportSize.Y
                if full or onScreen then
                    local direction=position-camera.CFrame.Position
                    local angle=direction.Magnitude>0 and math.acos(math.clamp(camera.CFrame.LookVector:Dot(direction.Unit),-1,1)) or 0
                    local pixels=full and angle/math.pi*1200 or (screen-origin).Magnitude
                    if full or pixels<=self:_effectiveFov(mode,camera) then
                        local allowed,why=self:_extraAimFilter(mode,eye,position)
                        if allowed and (cfg[mode..".visible"] or cfg["aim.wallbang"]) then allowed,why=self:_canReach(record,position,cfg["aim.wallbang"]) end
                        if allowed then
                            local priority=cfg[mode..".priority"]
                            local score=priority=="Distance" and distance or priority=="Health" and health or pixels
                            if not best or score<best.score or score==best.score and pixels<best.pixels then
                                best={record=record,part=part,region=region,position=position,screen=screen,onScreen=onScreen,pixels=pixels,distance=distance,score=score,penetrable=why=="penetrable"}
                            end
                        else reason=why end
                    else reason="fov" end
                end
            end
        end
    end
    return best,best and "eligible" or reason
end
function Feature:_triggerRegionAllowed(part)
    local mode=self.config["rage.enabled"] and "rage" or self.config["legit.enabled"] and "legit"
    local regions=self.config["trigger.followRegions"] and mode and self:_selectedRegions(mode) or self.config["trigger.regions"]
    if type(regions)=="table" and #regions>0 then
        for _,region in ipairs(regions) do if self:_partMatches(part,region) then return true end end
        return false
    end
    return self:_partMatches(part,self.config["trigger.part"])
end
function Feature:_triggerProbeAdvanced(cameraOverride)
    local camera=cameraOverride or Workspace.CurrentCamera
    if not camera then return nil,"camera" end
    local frame=not cameraOverride and self:_thirdPersonShotFrame(camera,false) or camera.CFrame
    frame=frame or camera.CFrame
    local origin=frame.Position
    local hit=Workspace:Raycast(origin,frame.LookVector*self.config["trigger.distance"],self.rayParams or self:_rayParams())
    local entries=hit and {{instance=hit.Instance,position=hit.Position}} or {}
    if self.config["aim.wallbang"] and not cameraOverride then
        local penetration=self:_penetrationHits(origin,frame.LookVector*self.config["trigger.distance"])
        if penetration then entries=penetration end
    end
    for _,entry in ipairs(entries) do
        local part=entry.instance
        for _,record in pairs(self.records) do
            if record.character and part and part:IsDescendantOf(record.character) then
                if healthOf(record.player,record.character)<=0 then return nil,"dead" end
                if self.config["trigger.team"] and not isEnemy(record.player,record.character) then return nil,"team" end
                if not self:_triggerRegionAllowed(part) then return nil,"region" end
                local allowed,why=self:_extraAimFilter("trigger",origin,entry.position)
                if not allowed then return nil,why end
                return record,"eligible"
            end
        end
    end
    return nil,hit and "world" or "no-hit"
end
function Feature:_wallbangConvergence(display,point)
    local aim=self.aimPosition
    if self.config["aim.wallbang"] and aim and self.target and os.clock()-(self.aimPositionAt or 0)<0.15 then
        local delta=aim-display.Position
        if delta.Magnitude>0.1 and display.LookVector:Dot(delta.Unit)>math.cos(math.rad(0.3)) then return aim end
    end
    return point
end

local function encodeValue(value,depth)
    if (depth or 0)>12 then return nil end
    if typeof(value)=="Color3" then return {__color3=true,r=value.R,g=value.G,b=value.B} end
    if type(value)=="table" then local out={};for key,item in pairs(value) do out[key]=encodeValue(item,(depth or 0)+1) end;return out end
    if type(value)=="number" then return finite(value) and value or nil end
    if type(value)=="string" or type(value)=="boolean" then return value end
    return nil
end
local function decodeValue(value,depth)
    if (depth or 0)>12 then return nil end
    if type(value)~="table" then return value end
    if value.__color3 and finite(value.r) and finite(value.g) and finite(value.b) then return Color3.new(math.clamp(value.r,0,1),math.clamp(value.g,0,1),math.clamp(value.b,0,1)) end
    local out={};for key,item in pairs(value) do out[key]=decodeValue(item,(depth or 0)+1) end;return out
end
function Feature.SettingsPath()
    return "MNZS/config-"..tostring(game.GameId).."-"..tostring(LocalPlayer.UserId)..".json"
end
function Feature.ReadSaved(state)
    if type(isfile)~="function" or type(readfile)~="function" then return nil,"unsupported" end
    local ok,data=pcall(function()
        local path=Feature.SettingsPath()
        if not isfile(path) then return nil end
        local raw=readfile(path)
        if #raw>2000000 then error("Arquivo de configuração excede o limite") end
        local saved=Http:JSONDecode(raw)
        if type(saved)~="table" or saved.schema~=1 or type(saved.state)~="table" then error("Configuração inválida") end
        saved=decodeValue(saved)
        -- Adopt the new default while retaining explicitly customized bindings.
        if saved.state.menuKey=="KeypadZero" then saved.state.menuKey="RightShift" end
        for key,value in pairs(saved.state) do
            if specs[key] then local normalized,valid=normalize(key,value);if valid then state:Set(key,normalized) end
            elseif key=="language" and (value=="pt" or value=="en") or key=="menuKey" and validKey(value) or key=="autoApply" and type(value)=="boolean"
                or key=="ui.animation" and type(value)=="boolean" or key=="ui.opacity" and finite(value) and value>=0 and value<=100
                or type(key)=="string" and (key:sub(1,5)=="wear." or key:sub(1,6)=="skins.") and type(value)=="string"
                or type(key)=="string" and key:sub(1,9)=="favorite." and type(value)=="boolean" then state:Set(key,value) end
        end
        return saved
    end)
    return ok and data or nil,ok and "loaded" or "invalid"
end
function Feature:_settingsPayload()
    local values={}
    for key,value in pairs(self.state:Snapshot()) do
        if specs[key] or key=="language" or key=="menuKey" or key=="autoApply" or key=="ui.animation" or key=="ui.opacity" or key:sub(1,5)=="wear." or key:sub(1,6)=="skins." or key:sub(1,9)=="favorite." then values[key]=value end
    end
    local engine=self.ui.engine
    local knife=engine._nativeDesired96 and engine._nativeDesired96.weapon or engine._v92selectedKnife
    return {schema=1,state=values,skins=engine.profiles,knife=knife,gloves=engine._v92selectedGlove,weaponVisual=engine:WeaponVisualSelection(),
        selection={kind=self.ui.skinKind,weapons=self.ui.selectedWeaponByKind,skins=self.ui.selectedSkinByWeapon,favorites=self.ui.favorites}}
end
function Feature:SaveSettings()
    if self.persistenceReady==false or self.saving or type(writefile)~="function" then return false,"Salvamento indisponível" end
    self.saving=true
    local ok,err=pcall(function()
        local raw=Http:JSONEncode(encodeValue(self:_settingsPayload()))
        writefile(self.savePath,raw)
        self.lastSavedRaw=raw
        self.stats.settingsSaved=true;self.stats.settingsSaveError=nil
    end)
    self.saving=false
    if not ok then self.stats.settingsSaveError=tostring(err) end
    return ok,ok and "Configuração salva" or tostring(err)
end
function Feature:RestoreSaved(saved)
    if type(saved)~="table" then return end
    local engine=self.ui.engine
    local function knownSkin(weapon,skin)
        if type(weapon)~="string" or type(skin)~="string" then return false end
        for _,entry in ipairs(engine:GetSkins(weapon)) do if entry.skin==skin then return true end end
        return false
    end
    local selection=saved.selection
    if type(selection)=="table" then
        if selection.kind=="Weapons" or selection.kind=="Knives" or selection.kind=="Gloves" then self.ui.skinKind=selection.kind end
        for _,kind in ipairs({"Weapons","Knives","Gloves"}) do
            local weapon=type(selection.weapons)=="table" and selection.weapons[kind]
            if type(weapon)=="string" and table.find(engine:GetWeapons(kind),weapon) then self.ui.selectedWeaponByKind[kind]=weapon end
        end
        for weapon,skin in pairs(type(selection.skins)=="table" and selection.skins or {}) do
            if knownSkin(weapon,skin) then self.ui.selectedSkinByWeapon[weapon]=skin end
        end
        for key,favorite in pairs(type(selection.favorites)=="table" and selection.favorites or {}) do
            if type(key)=="string" and type(favorite)=="boolean" then self.ui.favorites[key]=favorite end
        end
    end
    local profiles=type(saved.skins)=="table" and saved.skins or {}
    local order={}
    for weapon,profile in pairs(profiles) do
        if type(profile)=="table" and type(profile.wear)=="string" and knownSkin(weapon,profile.skin) then order[#order+1]=weapon end
    end
    table.sort(order)
    -- Applying a glove or native knife selects it. Restore the saved selections last.
    for _,kind in ipairs({"Knives","Gloves"}) do
        local selected=kind=="Knives" and saved.knife or saved.gloves
        local index=type(selected)=="string" and table.find(order,selected)
        if index and engine:Category(selected)==kind then table.remove(order,index);order[#order+1]=selected end
    end
    self.stats.settingsRestoreError=nil
    for _,weapon in ipairs(order) do
        local profile=profiles[weapon]
        local ok,applied,message=pcall(engine.Apply,engine,weapon,profile.skin,profile.wear)
        if not ok or not applied then
            self.stats.settingsRestoreError=tostring(ok and message or applied)
        end
    end
    local ok,restored,message=pcall(engine.RestoreWeaponVisual,engine,saved.weaponVisual)
    if not ok or not restored then
        self.stats.settingsRestoreError=tostring(ok and message or restored)
    end
    self.ui:RefreshSkins()
end
function Feature:_startV913()
    if self.running then return end
    self:_startV912()
    self.unwatch[#self.unwatch+1]=self.state:OnChange(function() if self.config["settings.autoSave"] then self.saveDirtyAt=os.clock()+0.6 end end)
    self:_connect(RunService.Heartbeat,function()
        local now=os.clock()
        if not self.running or not self.persistenceReady or not self.config["settings.autoSave"] then return end
        if self.saveDirtyAt and now>=self.saveDirtyAt then self.saveDirtyAt=nil;self:SaveSettings() end
        if now>=self.nextSavePoll then
            self.nextSavePoll=now+1
            local ok,raw=pcall(function() return Http:JSONEncode(encodeValue(self:_settingsPayload())) end)
            if ok and raw~=self.lastSavedRaw then self:SaveSettings() end
        end
    end)
end
function Feature:Unload()
    if self.stopApplication then self.stopApplication() end
end
function Feature:Destroy()
    if self.running and self.config["settings.autoSave"] then self:SaveSettings() end
    self:_destroyV912()
end
function Feature.BindLifecycle(features,ui,engine,env)
    local stopped=false
    local function stop()
        if stopped then return end
        stopped=true
        if env and env.__MNZS_SNIPER_ARENA_STOP==stop then env.__MNZS_SNIPER_ARENA_STOP=nil end
        local uiOK,uiErr=pcall(function() ui:Destroy() end)
        local engineOK,engineErr=pcall(function() engine:Destroy() end)
        if not uiOK then warn("[MNZS] "..tostring(uiErr)) end
        if not engineOK then warn("[MNZS] "..tostring(engineErr)) end
    end
    features.stopApplication=stop
    if env then env.__MNZS_SNIPER_ARENA_STOP=stop end
    return stop
end

