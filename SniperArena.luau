local mouseKeys = {MouseButton1=Enum.UserInputType.MouseButton1,MouseButton2=Enum.UserInputType.MouseButton2,MouseButton3=Enum.UserInputType.MouseButton3}
local function finite(value)
    return type(value)=="number" and value==value and math.abs(value)<math.huge
end
local function validKey(value)
    if type(value)~="string" then return false end
    if value=="None" or mouseKeys[value] then return true end
    local ok,item=pcall(function() return Enum.KeyCode[value] end)
    return ok and item~=Enum.KeyCode.Unknown
end
local function normalize(key,value)
    local def=specs[key]
    if not def then return nil,false end
    if def.kind=="number" then
        if not finite(value) then return def.default,false end
        return math.clamp(value,def.min,def.max),true
    elseif def.kind=="regions" then
        if type(value)~="table" then return {},false end
        local result={}
        for _,region in ipairs(value) do
            if not table.find(Feature.REGIONS,region) then return {},false end
            if not table.find(result,region) then result[#result+1]=region end
        end
        return result,true
    elseif def.kind=="key" then
        if validKey(value) then return value,true end
    elseif typeof(value)==def.kind then
        if not def.options or table.find(def.options,value) then return value,true end
    end
    return def.default,false
end
function Feature.AddDefaults(defaults)
    for key,def in pairs(specs) do defaults[key]=def.default end
end

