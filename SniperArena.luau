-- Presentation roles only; game settings, cosmetics and viewport materials are untouched.
do
    local palette=UI.Palette
    local legacy={}
    local properties={"BackgroundColor3","TextColor3","ImageColor3","BorderColor3","ScrollBarImageColor3","PlaceholderColor3","Color"}
    local function colorKey(color)
        return string.format("%d,%d,%d",math.floor(color.R*255+0.5),math.floor(color.G*255+0.5),math.floor(color.B*255+0.5))
    end
    local function alias(role,r,g,b) legacy[colorKey(Color3.fromRGB(r,g,b))]=role end
    for role,color in pairs(palette) do legacy[colorKey(color)]=role end
    for _,entry in ipairs({
        {"panel",20,16,24},{"panel2",29,22,33},{"text",242,235,242},{"muted",157,143,162},{"red",225,63,107},
        {"panel2",24,20,29},{"panel2",22,18,27},{"panel",17,14,22},{"panel2",38,19,30},
        {"selected",34,26,36},{"selected",37,28,40},{"selected",62,28,44},{"selected",69,32,51},{"selected",71,32,56},
        {"hover",61,32,47},{"hover",45,34,46},{"hover",129,42,70},{"bright",169,76,126},{"bright",228,169,225},
        {"outline",81,49,67},{"outline",132,65,103},{"selectedBorder",152,84,121},{"navIcon",232,196,220},
        {"sliderTrack",66,48,60},{"artBase",12,8,15},{"artBase",13,7,13},{"darkness",7,5,10},
        {"backgroundTop",35,6,18},{"canvas",8,7,12},{"redDark",144,53,67},{"red",221,40,69},
    }) do alias(table.unpack(entry)) end
    local function roleFor(color)
        if typeof(color)~="Color3" then return nil end
        local role=legacy[colorKey(color)]
        if role then return role end
        for _,name in ipairs({"red","bright","redDark","selected","panel","panel2","hover","outline","text","muted","dim","canvas","sidebar","white","good"}) do
            if palette[name]==color then return name end
        end
        return nil
    end
    local function fixed(object)
        local parent=object
        while parent do
            if parent:GetAttribute("MNZSThemeFixed") then return true end
            if parent:IsA("ScreenGui") then break end
            parent=parent.Parent
        end
        return false
    end
    UI.TagThemeObject=function(object,values)
        if object:GetAttribute("MNZSThemeFixed") then return end
        for _,property in ipairs(properties) do
            local value=values and values[property]
            local role=roleFor(value)
            if role then object:SetAttribute("MNZSThemeRole_"..property,role) end
        end
        if object:IsA("UIGradient") and values and typeof(values.Color)=="ColorSequence" then
            for index,point in ipairs(values.Color.Keypoints) do
                local role=roleFor(point.Value)
                if role then object:SetAttribute("MNZSThemeGradient_"..index,role) end
            end
        end
    end
    local originalAnim=UI._anim
    local function animate(self,object,duration,goals,easing)
        self.themeTweenGoals=self.themeTweenGoals or {}
        local entry={goals=goals}
        local tween=originalAnim(self,object,duration,goals,easing)
        if tween then
            self.themeTweenGoals[object]=entry
            tween.Completed:Once(function() if self.themeTweenGoals and self.themeTweenGoals[object]==entry then self.themeTweenGoals[object]=nil end end)
        end
        return tween
    end
    UI._anim=function(self,object,duration,goals,easing)
        local mapped=table.clone(goals)
        if object and not fixed(object) then
            for property,value in pairs(mapped) do
                if typeof(value)=="Color3" then
                    local role=roleFor(value)
                    if role then mapped[property]=palette[role] or value;object:SetAttribute("MNZSThemeRole_"..property,role) end
                end
            end
        end
        return animate(self,object,duration,mapped,easing)
    end
    UI._clickAnim=function(self,button,neutral,hover)
        local owned={}
        local function listen(signal,callback) owned[#owned+1]=self:_conn(signal,callback) end
        local normalRole=roleFor(neutral or button.BackgroundColor3)
        local hoverRole=roleFor(hover) or "hover"
        if hoverRole=="red" then hoverRole="bright" end
        local originalText=button.TextColor3
        local textRole=roleFor(originalText)
        local function contrast(color)
            local luminance=color.R*0.2126+color.G*0.7152+color.B*0.0722
            return luminance>0.65 and palette.canvas or palette.text
        end
        button:SetAttribute("mnzsNormalColor",neutral or button.BackgroundColor3)
        local function normalColor()
            local value=button:GetAttribute("mnzsNormalColor") or neutral or button.BackgroundColor3
            return palette[roleFor(value) or normalRole] or value
        end
        listen(button.MouseEnter,function() animate(self,button,0.14,{BackgroundColor3=palette[hoverRole],TextColor3=contrast(palette[hoverRole])}) end)
        listen(button.MouseLeave,function() animate(self,button,0.16,{BackgroundColor3=normalColor(),TextColor3=palette[textRole] or originalText}) end)
        listen(button.MouseButton1Down,function() animate(self,button,0.08,{BackgroundColor3=palette.redDark,TextColor3=palette.text}) end)
        listen(button.MouseButton1Up,function() animate(self,button,0.1,{BackgroundColor3=palette[hoverRole],TextColor3=contrast(palette[hoverRole])}) end)
        listen(button.Destroying,function()
            for _,connection in ipairs(owned) do
                connection:Disconnect()
                local index=table.find(self.connections,connection)
                if index then table.remove(self.connections,index) end
            end
            table.clear(owned)
        end)
    end
    local function recolor(self,object,instant)
        if not object.Parent or fixed(object) then return end
        local goals={}
        for _,property in ipairs(properties) do
            local role=object:GetAttribute("MNZSThemeRole_"..property)
            if role and palette[role] and object[property]~=palette[role] then goals[property]=palette[role] end
        end
        if next(goals) then
            if instant then for property,value in pairs(goals) do object[property]=value end
            else animate(self,object,0.24,goals) end
        end
        if object:IsA("GuiButton") then
            local role=object:GetAttribute("MNZSThemeRole_BackgroundColor3")
            if role and palette[role] then object:SetAttribute("mnzsNormalColor",palette[role]) end
        elseif object:IsA("UIGradient") then
            local points={}
            for index,point in ipairs(object.Color.Keypoints) do
                local role=object:GetAttribute("MNZSThemeGradient_"..index)
                points[#points+1]=ColorSequenceKeypoint.new(point.Time,palette[role] or point.Value)
            end
            object.Color=ColorSequence.new(points)
        end
    end
    local function updatePalette(theme)
        palette.canvas=theme.background;palette.sidebar=theme.background
        palette.panel=theme.panel;palette.panel2=theme.panel:Lerp(Color3.new(1,1,1),0.035)
        palette.red=theme.accent;palette.bright=theme.hover
        palette.redDark=theme.panel:Lerp(theme.accent,0.32);palette.hover=theme.panel:Lerp(theme.accent,0.18)
        palette.selected=theme.panel:Lerp(theme.accent,0.22);palette.selectedBorder=theme.accent:Lerp(Color3.new(1,1,1),0.25)
        palette.outline=theme.panel:Lerp(theme.accent,0.20)
        palette.text=Color3.fromRGB(241,242,246);palette.muted=Color3.fromRGB(167,168,180);palette.dim=Color3.fromRGB(120,122,137)
        palette.navIcon=theme.hover;palette.sliderTrack=theme.panel:Lerp(Color3.new(1,1,1),0.13)
        palette.artBase=theme.background;palette.darkness=theme.background;palette.backgroundTop=theme.panel:Lerp(theme.accent,0.12)
        palette.white=Color3.new(1,1,1)
        palette.toggleThumb=(theme.accent.R*0.2126+theme.accent.G*0.7152+theme.accent.B*0.0722)>0.65 and theme.background or palette.white
        if UI.SetShellPalette then UI.SetShellPalette(palette) end
    end
    UI.FinishThemeArtwork=function(self)
        self.themeArtToken=(self.themeArtToken or 0)+1
        for _,object in ipairs({self.art,self.themeArtNext}) do
            local tween=object and self.tweens[object]
            if tween then tween:Cancel();self.tweens[object]=nil end
        end
        self.art.Image=self.themeImage or ""
        self.art.ImageTransparency=self.art.Image~="" and 1-self.state:Get("ui.opacity",68)/100 or 1
        if self.themeArtNext then self.themeArtNext.Image="";self.themeArtNext.ImageTransparency=1 end
    end
    UI.ApplyTheme=function(self,id,instant)
        local pending={}
        for object,entry in pairs(self.themeTweenGoals or {}) do
            for _,value in pairs(entry.goals) do
                if typeof(value)=="Color3" then
                    local tween=self.tweens[object]
                    if tween then pending[#pending+1]=tween end
                    break
                end
            end
        end
        for _,tween in ipairs(pending) do tween:Cancel() end
        local theme=MNZSFeatures.ThemeById(id)
        updatePalette(theme)
        for _,object in ipairs(self.gui:GetDescendants()) do recolor(self,object,instant==true) end
        local uri,problem
        if theme.imageReady then uri,problem=MNZSThemeAssets.Get(theme.id) end
        self.themeImage=uri or "";self.themeImageError=problem
        self.themeArtToken=(self.themeArtToken or 0)+1
        local token=self.themeArtToken
        if self.themeArtNext and not instant and self.state:Get("ui.animation",true) then
            self.themeArtNext.Image=self.themeImage;self.themeArtNext.ImageTransparency=1
            animate(self,self.art,0.24,{ImageTransparency=1})
            local tween=animate(self,self.themeArtNext,0.28,{ImageTransparency=self.themeImage~="" and 1-self.state:Get("ui.opacity",68)/100 or 1})
            if tween then tween.Completed:Once(function()
                if self.gui and self.gui.Parent and self.themeArtToken==token then self:FinishThemeArtwork() end
            end) else self:FinishThemeArtwork() end
        else self:FinishThemeArtwork() end
        self.themeId=theme.id
        for _,refresh in ipairs(self.localeRefreshers or {}) do pcall(refresh) end
    end
    local originalColorPicker=UI.CreateColorPicker
    UI.CreateColorPicker=function(self,parent,opts)
        local row=originalColorPicker(self,parent,opts)
        local sample=row:FindFirstChildOfClass("TextButton")
        if sample then sample:SetAttribute("MNZSThemeFixed",true);sample.BackgroundColor3=self.state:Get(opts.id) end
        return row
    end
    local originalNew=UI.new
    UI.new=function(opts)
        local self=originalNew(opts)
        self.indicator:SetAttribute("MNZSThemeRole_BackgroundColor3","red")
        self.themeArtNext=self.art:Clone();self.themeArtNext.Name="ThemeArtworkTransition";self.themeArtNext.Image="";self.themeArtNext.ImageTransparency=1;self.themeArtNext.Parent=self.art.Parent
        for _,object in ipairs(self.sidebar:GetDescendants()) do
            if object:IsA("ImageLabel") and object.Image==self.assets.ItachiBackground then self.profilePortrait=object;break end
        end
        if self.profilePortrait then
            self.profilePortrait.Name="LocalPlayerAvatar"
            local function refreshAvatar()
                if self.profilePortrait.Parent then self.profilePortrait.Image=self.userAvatar.Image end
            end
            self:_conn(self.userAvatar:GetPropertyChangedSignal("Image"),refreshAvatar)
            refreshAvatar()
        end
        self:ApplyTheme(self.state:Get("ui.theme","Crimson"),true)
        self:_watch("ui.theme",function(id) self:ApplyTheme(id,false) end,false)
        self:_watch("ui.accent",function() self.indicator.BackgroundColor3=palette.red end,false)
        self:_watch("ui.opacity",function() self:FinishThemeArtwork() end,false)
        self:_watch("ui.animation",function(enabled)
            if enabled then return end
            local pending={}
            for object,entry in pairs(self.themeTweenGoals or {}) do pending[#pending+1]={object=object,entry=entry,tween=self.tweens[object]} end
            for _,item in ipairs(pending) do
                if item.tween then item.tween:Cancel() end
                if item.object.Parent then for property,value in pairs(item.entry.goals) do item.object[property]=value end end
            end
            self.themeTweenGoals={};self:FinishThemeArtwork()
        end,false)
        self:_conn(self.gui.DescendantAdded,function(object) if self.themeId then recolor(self,object,true) end end)
        return self
    end
    local originalDestroy=UI.Destroy
    UI.Destroy=function(self)
        self.themeArtToken=(self.themeArtToken or 0)+1
        self.themeTweenGoals={}
        return originalDestroy(self)
    end
end

-- Cosmetic motion only. No character, camera, preview model or skin state is changed.
do
    local tweenService=game:GetService("TweenService")
    local inputService=game:GetService("UserInputService")
    local function alive(object)
        return object and object.Parent~=nil
    end
    local function getMotion(self)
        if not self._menuMotion then
            self._menuMotion={dead=false,tweens={},buttons={},sections={},pagePositions={},connections={}}
        end
        return self._menuMotion
    end
    local function enabled(self)
        local motion=getMotion(self)
        return not motion.dead and self.state:Get("ui.animation",true)~=false
    end
    local function setProperties(object,goals)
        if not alive(object) then return end
        for property,value in pairs(goals) do object[property]=value end
    end
    local function cancelTween(motion,object,finish)
        local slot=motion.tweens[object]
        if not slot then return end
        motion.tweens[object]=nil
        if slot.connection then slot.connection:Disconnect() end
        slot.tween:Cancel()
        if finish then setProperties(object,slot.goals) end
    end
    local function animate(self,object,duration,goals,kind,delay)
        local motion=getMotion(self)
        cancelTween(motion,object,false)
        if not alive(object) or motion.dead then return end
        if not enabled(self) then setProperties(object,goals);return end
        local tween=tweenService:Create(object,TweenInfo.new(duration,Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out,0,false,delay or 0),goals)
        local slot={tween=tween,goals=goals,kind=kind,connection=nil :: RBXScriptConnection?}
        motion.tweens[object]=slot
        slot.connection=tween.Completed:Connect(function()
            if motion.tweens[object]==slot then motion.tweens[object]=nil end
            if slot.connection then slot.connection:Disconnect();slot.connection=nil end
        end)
        tween:Play()
    end
    local function connect(motion,signal,callback)
        local connection=signal:Connect(callback)
        motion.connections[#motion.connections+1]=connection
        return connection
    end
    local function settleEntries(self)
        local motion=getMotion(self)
        for object,slot in pairs(motion.tweens) do
            if slot.kind=="entry" then cancelTween(motion,object,true) end
        end
        for page,position in pairs(motion.pagePositions) do
            if alive(page) then page.Position=position else motion.pagePositions[page]=nil end
        end
        for card,record in pairs(motion.sections) do
            if alive(card) and alive(record.scale) then record.scale.Scale=1 end
        end
    end
    local function buttonResponse(self,record)
        if not alive(record.button) or not alive(record.scale) then return end
        local scale=1
        if enabled(self) and self.isOpen and not self.closing then
            scale=record.pressed and .975 or (record.hovered and 1.018 or 1)
        end
        animate(self,record.scale,record.pressed and .08 or .15,{Scale=scale},"button")
    end
    local function settleButtons(self)
        local motion=getMotion(self)
        for _,record in pairs(motion.buttons) do
            record.hovered=false;record.pressed=false
            cancelTween(motion,record.scale,false)
            if alive(record.scale) then record.scale.Scale=1 end
        end
    end
    local function bindButton(self,button)
        local motion=getMotion(self)
        if motion.dead or not button:IsA("GuiButton") or motion.buttons[button]
            or button:FindFirstChildOfClass("UIScale") then return end
        local scale=Instance.new("UIScale")
        scale.Name="MNZSMotionScale";scale.Scale=1;scale.Parent=button
        local record={button=button,scale=scale,hovered=false,pressed=false,connections={}}
        motion.buttons[button]=record
        button:SetAttribute("MNZSMotionBound",true)
        local function listen(signal,callback)
            record.connections[#record.connections+1]=signal:Connect(callback)
        end
        listen(button.MouseEnter,function() record.hovered=true;buttonResponse(self,record) end)
        listen(button.MouseLeave,function() record.hovered=false;record.pressed=false;buttonResponse(self,record) end)
        listen(button.MouseButton1Down,function() record.pressed=true;buttonResponse(self,record) end)
        listen(button.MouseButton1Up,function() record.pressed=false;buttonResponse(self,record) end)
        listen(button.Destroying,function()
            motion.buttons[button]=nil
            cancelTween(motion,scale,false)
            for _,connection in ipairs(record.connections) do connection:Disconnect() end
            table.clear(record.connections)
        end)
    end
    local function trackSection(self,card)
        local motion=getMotion(self)
        if motion.dead or motion.sections[card] or card:FindFirstChildOfClass("UIScale") then return end
        local scale=Instance.new("UIScale")
        scale.Name="MNZSSectionMotionScale";scale.Scale=1;scale.Parent=card
        local record={scale=scale,connection=nil :: RBXScriptConnection?}
        motion.sections[card]=record
        record.connection=card.Destroying:Connect(function()
            cancelTween(motion,scale,false)
            motion.sections[card]=nil
            if record.connection then record.connection:Disconnect();record.connection=nil end
        end)
    end
    local function playPage(self,id)
        local motion=getMotion(self)
        local page=self.pages and self.pages[id]
        if not enabled(self) or not alive(page) or not self.isOpen or self.closing then return end
        local position=motion.pagePositions[page] or page.Position
        motion.pagePositions[page]=position
        page.Position=position+UDim2.fromOffset(0,7)
        animate(self,page,.23,{Position=position},"entry")
        local sections={}
        for card,record in pairs(motion.sections) do
            if card.Parent==page and card.Visible and alive(record.scale) then sections[#sections+1]=card end
        end
        table.sort(sections,function(a,b)
            if a.LayoutOrder~=b.LayoutOrder then return a.LayoutOrder<b.LayoutOrder end
            return a.AbsolutePosition.Y<b.AbsolutePosition.Y
        end)
        for index,card in ipairs(sections) do
            local scale=motion.sections[card].scale
            scale.Scale=.988
            animate(self,scale,.22,{Scale=1},"entry",math.min((index-1)*.035,.14))
        end
    end
    local function cleanup(self)
        local motion=self._menuMotion
        if not motion or motion.dead then return end
        motion.dead=true
        if motion.stopWatching then motion.stopWatching();motion.stopWatching=nil end
        for _,connection in ipairs(motion.connections) do connection:Disconnect() end
        table.clear(motion.connections)
        for object in pairs(motion.tweens) do cancelTween(motion,object,true) end
        settleEntries(self)
        for button,record in pairs(motion.buttons) do
            for _,connection in ipairs(record.connections) do connection:Disconnect() end
            if alive(record.scale) then record.scale:Destroy() end
            if alive(button) then button:SetAttribute("MNZSMotionBound",nil) end
        end
        for _,record in pairs(motion.sections) do
            if record.connection then record.connection:Disconnect() end
            if alive(record.scale) then record.scale:Destroy() end
        end
        table.clear(motion.buttons);table.clear(motion.sections);table.clear(motion.pagePositions)
    end

    local createSection=UI.CreateSection
    UI.CreateSection=function(self,...)
        local card=createSection(self,...)
        trackSection(self,card)
        return card
    end
    local selectTab=UI.SelectTab
    UI.SelectTab=function(self,id,instant)
        local changed=self.activeTab~=id
        settleEntries(self)
        local result=selectTab(self,id,instant)
        if changed and not instant then playPage(self,id) end
        return result
    end
    local show=UI.Show
    UI.Show=function(self,...)
        local opening=not self.isOpen or self.closing
        local result=show(self,...)
        if opening then settleEntries(self);playPage(self,self.activeTab) end
        return result
    end
    local hide=UI.Hide
    UI.Hide=function(self,...)
        settleEntries(self);settleButtons(self)
        return hide(self,...)
    end
    local new=UI.new
    UI.new=function(opts)
        local self=new(opts)
        local motion=getMotion(self)
        for _,object in ipairs(self.gui:GetDescendants()) do bindButton(self,object) end
        connect(motion,self.gui.DescendantAdded,function(object) bindButton(self,object) end)
        connect(motion,inputService.InputEnded,function(input)
            if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
            for _,record in pairs(motion.buttons) do
                if record.pressed then record.pressed=false;buttonResponse(self,record) end
            end
        end)
        connect(motion,inputService.WindowFocusReleased,function() settleButtons(self) end)
        connect(motion,self.gui.Destroying,function() cleanup(self) end)
        motion.stopWatching=self.state:Watch("ui.animation",function(value)
            if value==false then settleEntries(self);settleButtons(self) end
        end,false)
        playPage(self,self.activeTab)
        return self
    end
    local destroy=UI.Destroy
    UI.Destroy=function(self,...)
        cleanup(self)
        return destroy(self,...)
    end
end

-- Keep the original presentation and card controls; paginate the complete catalogue.
do
    local PAGE_SIZE=24
    local rarityOrder={Common=1,UnCommon=2,Uncommon=2,Rare=3,Epic=4,Legendary=5,Mystic=6,Exotic=7,Stock=8}
    local rarityLabels={
        Common={"Comum","Common"},UnCommon={"Incomum","Uncommon"},Uncommon={"Incomum","Uncommon"},
        Rare={"Rara","Rare"},Epic={"Épica","Epic"},Legendary={"Lendária","Legendary"},
        Mystic={"Mística","Mystic"},Exotic={"Exótica","Exotic"},Stock={"Padrão","Stock"},
    }
    local function lower(value) return string.lower(tostring(value or "")) end
    local function english(self) return self.state:Get("language","pt")=="en" end
    local function rarityLabel(self,rarity)
        if rarity=="All" then return english(self) and "All" or "Todas" end
        local labels=rarityLabels[rarity]
        return labels and labels[english(self) and 2 or 1] or tostring(rarity)
    end
    local function cloneControl(template,name,parent,position,size)
        local control=template:Clone()
        control.Name=name;control.Position=position;control.Size=size;control.Visible=true
        control.Parent=parent
        return control
    end
    function UI:_ensureSkinFilters()
        if self.skinSearch then return end
        self.skinQuery="";self.skinRarity="All";self.skinPage=1
        self.skinSearch=cloneControl(self.pickerSearch,"SkinSearch",self.skinFrame,
            UDim2.fromOffset(2,163),UDim2.fromOffset(312,23))
        self.skinSearch.Text="";self.skinSearch.ZIndex=19
        self.skinRarityButton=cloneControl(self.wearButton,"SkinRarityFilter",self.skinFrame,
            UDim2.fromOffset(322,163),UDim2.fromOffset(206,23))
        self.skinRarityButton.ZIndex=19;self.skinRarityButton.TextSize=10
        self.skinPreviousPage=cloneControl(self.wearButton,"SkinPreviousPage",self.skinFrame,
            UDim2.fromOffset(365,104),UDim2.fromOffset(32,21))
        self.skinPreviousPage.Text="<";self.skinPreviousPage.ZIndex=19
        self.skinNextPage=cloneControl(self.wearButton,"SkinNextPage",self.skinFrame,
            UDim2.fromOffset(496,104),UDim2.fromOffset(32,21))
        self.skinNextPage.Text=">";self.skinNextPage.ZIndex=19
        self.skinPageLabel=cloneControl(self.weaponSummary,"SkinPageNumber",self.skinFrame,
            UDim2.fromOffset(399,105),UDim2.fromOffset(95,19))
        self.skinPageLabel.TextXAlignment=Enum.TextXAlignment.Center
        self.skinEmptyLabel=cloneControl(self.skinHelp,"SkinEmptyResults",self.skinFrame,
            UDim2.fromOffset(4,219),UDim2.fromOffset(520,38))
        self.skinEmptyLabel.TextXAlignment=Enum.TextXAlignment.Center
        self.skinEmptyLabel.TextWrapped=true;self.skinEmptyLabel.Visible=false
        self.weaponSummary.Size=UDim2.fromOffset(355,15)
        for _,button in ipairs({self.skinRarityButton,self.skinPreviousPage,self.skinNextPage}) do
            self:_clickAnim(button,UI.Palette.panel2,UI.Palette.hover)
        end
        self:_conn(self.skinSearch:GetPropertyChangedSignal("Text"),function()
            if self._settingSkinQuery then return end
            self.skinQuery=self.skinSearch.Text;self.skinPage=1
            self:RefreshSkins()
        end)
        self:_conn(self.skinRarityButton.MouseButton1Click,function()
            local options={{value="All",label=rarityLabel(self,"All").." ("..tostring(self._skinPageData and self._skinPageData.total or 0)..")"}}
            for _,rarity in ipairs(self._skinRarities or {}) do
                options[#options+1]={value=rarity,label=rarityLabel(self,rarity).." ("..tostring(self._skinRarityCounts[rarity])..")"}
            end
            self:OpenList(self.skinRarityButton,options,function(value) self:SetSkinRarity(value) end,206)
        end)
        self:_conn(self.skinPreviousPage.MouseButton1Click,function() self:SetSkinPage((self.skinPage or 1)-1) end)
        self:_conn(self.skinNextPage.MouseButton1Click,function() self:SetSkinPage((self.skinPage or 1)+1) end)
    end
    -- These methods affect browsing only; applying a skin still uses the existing button.
    function UI:SetSkinQuery(value)
        if type(value)~="string" or not self.skinSearch or not self.skinSearch.Parent then return false,"Busca inválida" end
        self._settingSkinQuery=true;self.skinSearch.Text=value;self._settingSkinQuery=nil
        self.skinQuery=value;self.skinPage=1;self:RefreshSkins()
        return true,self:GetSkinFilterSnapshot()
    end
    function UI:SetSkinRarity(value)
        if not self.skinSearch or not self.skinSearch.Parent then return false,"Menu indisponível" end
        if value~="All" and not (self._skinRarityCounts and self._skinRarityCounts[value]) then return false,"Raridade indisponível" end
        self.skinRarity=value;self.skinPage=1;self:RefreshSkins()
        return true,self:GetSkinFilterSnapshot()
    end
    function UI:SetSkinPage(value)
        if not self.skinSearch or not self.skinSearch.Parent or type(value)~="number" or value~=value or math.abs(value)==math.huge then return false,"Página inválida" end
        local pages=self._skinPageData and self._skinPageData.pages or 1
        self.skinPage=math.clamp(math.floor(value),1,pages);self:RefreshSkins()
        return true,self:GetSkinFilterSnapshot()
    end
    function UI:GetSkinFilterSnapshot()
        local data=self._skinPageData or {}
        return {weapon=data.weapon,query=self.skinQuery or "",rarity=self.skinRarity or "All",
            page=self.skinPage or 1,pages=data.pages or 1,pageSize=PAGE_SIZE,total=data.total or 0,
            matched=data.matched or 0,rendered=data.rendered or 0,skins=table.clone(data.skins or {}),
            selected=data.weapon and self.selectedSkinByWeapon[data.weapon]}
    end
    local originalRefreshSkins=UI.RefreshSkins
    function UI:RefreshSkins(...)
        if not self.skinFrame or not self.skinFrame.Parent then return end
        self:_ensureSkinFilters()
        local weapons=self.engine:GetWeapons(self.skinKind)
        local chosen=self.selectedWeaponByKind[self.skinKind]
        if not table.find(weapons,chosen) then chosen=weapons[1] end
        local list=chosen and self.engine:GetSkins(chosen) or {}
        local counts,rarities={},{}
        for _,info in ipairs(list) do
            local rarity=tostring(info.rarity or "Stock")
            if not counts[rarity] then rarities[#rarities+1]=rarity;counts[rarity]=0 end
            counts[rarity]+=1
        end
        table.sort(rarities,function(a,b)
            local ar,br=rarityOrder[a] or 100,rarityOrder[b] or 100
            return ar==br and a<b or ar<br
        end)
        self._skinRarityCounts=counts;self._skinRarities=rarities
        if self.skinRarity~="All" and not counts[self.skinRarity] then self.skinRarity="All" end
        local query=lower(self.skinQuery):match("^%s*(.-)%s*$")
        local viewKey=tostring(self.skinKind).."\0"..tostring(chosen).."\0"..query.."\0"..self.skinRarity
        if self._skinFilterKey~=viewKey then self.skinPage=1 end
        self._skinFilterKey=viewKey
        local matches={}
        for _,info in ipairs(list) do
            if (self.skinRarity=="All" or tostring(info.rarity or "Stock")==self.skinRarity)
                and (query=="" or string.find(lower(info.display),query,1,true)
                    or string.find(lower(info.skin),query,1,true) or string.find(lower(chosen),query,1,true)) then
                matches[#matches+1]=info
            end
        end
        local pages=math.max(1,math.ceil(#matches/PAGE_SIZE))
        self.skinPage=math.clamp(self.skinPage or 1,1,pages)
        local allowed={}
        for i=(self.skinPage-1)*PAGE_SIZE+1,math.min(self.skinPage*PAGE_SIZE,#matches) do allowed[matches[i].skin]=true end
        local renderKey=viewKey.."\0"..tostring(self.skinPage)
        local sameView=self._skinRenderKey==renderKey
        local lastScroll=self.skinList.CanvasPosition
        -- RefreshSkins retains its original navigation, selection, favourites and wear
        -- callbacks. Only its card factory is bounded; catalogue entries stay untouched.
        local previousFactory=rawget(self,"CreateSkinCard")
        local createCard=self.CreateSkinCard
        local previousSearch=self.search
        local rendered,visibleSkins=0,{}
        self.CreateSkinCard=function(ui,parent,info,...)
            if not allowed[info.skin] then return nil end
            local card=createCard(ui,parent,info,...)
            rendered+=1;visibleSkins[#visibleSkins+1]=info.skin
            return card
        end
        -- The dedicated skin query replaces the global page query on this tab only.
        -- The inherited refresh is synchronous; restore both references on failure too.
        self.search={Text=""};self._lastSkinsWeapon=false
        local ok,err=pcall(originalRefreshSkins,self,...)
        self.search=previousSearch;self.CreateSkinCard=previousFactory
        if not ok then error(err,0) end
        if sameView then self.skinList.CanvasPosition=lastScroll end
        self._skinRenderKey=renderKey
        self._skinPageData={weapon=chosen,pages=pages,total=#list,matched=#matches,rendered=rendered,skins=visibleSkins}
        local en=english(self)
        self.skinSearch.PlaceholderText=en and "Find skin by name..." or "Buscar skin pelo nome..."
        self.skinRarityButton.Text=(en and "Rarity: " or "Raridade: ")..rarityLabel(self,self.skinRarity).."  v"
        self.skinPageLabel.Text=tostring(self.skinPage).." / "..tostring(pages)
        self.weaponSummary.Text=tostring(#matches).." / "..tostring(#list).." skins"
        self.skinPreviousPage.Active=self.skinPage>1;self.skinPreviousPage.TextTransparency=self.skinPage>1 and 0 or .6
        self.skinNextPage.Active=self.skinPage<pages;self.skinNextPage.TextTransparency=self.skinPage<pages and 0 or .6
        self.skinEmptyLabel.Text=en and "No skins match this search and rarity." or "Nenhuma skin encontrada com esta busca e raridade."
        self.skinEmptyLabel.Visible=#matches==0
        self.skinHelp.Visible=false
        if self.skinKind=="Weapons" and self.wearButton then
            self.wearButton.Text=(en and "Free model: " or "Modelo livre: ")..(self.engine.weaponOverride and "ON" or "OFF")
            self.wearButton.Active=true
            self.skinHelp.Text=en and "Free model changes appearance; shots/ammo use your real weapon."
                or "Modelo livre: muda a aparência; tiro/munição seguem a arma real."
        end
    end
    local originalNew=UI.new
    UI.new=function(opts)
        local self=originalNew(opts)
        self.brandUsername.Text=game:GetService("Players").LocalPlayer.Name
        self.userLabel.Text="Sniper Arena"
        self.gui:SetAttribute("MNZSGame","Sniper Arena")
        return self
    end
end

local defaults = {
    language="pt", menuKey="RightShift", autoApply=true,
    ["ui.animation"]=true,["ui.opacity"]=68,
    ["ui.accent"]=Color3.fromRGB(221,40,69),["ui.note"]="",["ui.import"]="",
    ["demo.enabled"]=false,["demo.power"]=55,["demo.mode"]="Normal",
}
for _,id in ipairs({"Legit","Rage","Visuais","Mundo","Diversos"}) do
    defaults["demo."..id..".toggle"]=false
    defaults["demo."..id..".slider"]=60
    defaults["demo."..id..".select"]="Normal"
    defaults["demo."..id..".bind"]="None"
    defaults["demo."..id..".color"]=Color3.fromRGB(221,40,69)
    defaults["demo."..id..".text"]=""
end

MNZSFeatures.AddDefaults(defaults)
local state=State.new(defaults)
local savedSettings=MNZSFeatures.ReadSaved(state)
local engine,ui,features,stop
local cleaned=false
local function cleanup()
 if cleaned then return end
 cleaned=true
 if stop then stop();return end
 if ui then pcall(function() ui:Destroy() end) end
 local ownGui=game:GetService("Players").LocalPlayer.PlayerGui:FindFirstChild("MNZS_SNIPER_ARENA_UI")
 if ownGui then ownGui:Destroy() end
 if engine then pcall(function() engine:Destroy() end) end
end
if type(STATE)=="table" and type(STATE.onCleanup)=="function" then STATE.onCleanup(cleanup) end
local ok,err=xpcall(function()
 engine=SkinEngine.new()
 ui=UI.new({state=state,engine=engine,assets=Assets})
 features=MNZSFeatures.new(state,ui)
 ui.features=features
 features:Start()
 features:RestoreSaved(savedSettings)
 features.persistenceReady=true
 stop=MNZSFeatures.BindLifecycle(features,ui,engine,environment)
end,function(e)return debug.traceback(tostring(e),2)end)
if not ok then cleanup();error(err) end
return {Version="SA 0.7",Game="Sniper Arena",Features=features,UI=ui,Stop=cleanup}
