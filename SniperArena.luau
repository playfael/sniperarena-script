-- Sniper Arena aim controls. Insert after runtime.luau inside MNZSFeatures.
do
    local nativeCameraInput,nativeSpeedController
    do
        local replicated=game:GetService("ReplicatedStorage")
        local inputOK,input=pcall(function() return require(replicated.Client.RbxHelper).GetCameraInput() end)
        if inputOK and type(input)=="table" then nativeCameraInput=input end
        local speedOK,speed=pcall(function() return require(replicated.Client.CameraController.SpeedController) end)
        if speedOK and type(speed)=="table" then nativeSpeedController=speed end
    end
    local function settingNumber(name,fallback)
        local setting=SniperSettings[name]
        local value=setting and setting.Value
        return finite(value) and value or fallback
    end
    local function inputUpvalue(name)
        local setter=nativeCameraInput and nativeCameraInput[name]
        if type(setter)~="function" or not debug or type(debug.getupvalue)~="function" then return nil end
        -- Real returns the value directly, without a separate upvalue name.
        local ok,value=pcall(debug.getupvalue,setter,1)
        return ok and value or nil
    end
    function Feature:_mouseRadiansPerCount()
        local speed=nativeSpeedController and nativeSpeedController.Speed
        if not finite(speed) then speed=1 end
        local rotation=inputUpvalue("SetRotationSpeed")
        if not finite(rotation) then rotation=settingNumber("Sensitivity_Mouse",50)/50*0.5*speed end
        local alpha=inputUpvalue("SetMouseAlpha")
        if not finite(alpha) then alpha=1 end
        local axis=inputUpvalue("SetRotationHVSpeed")
        if typeof(axis)~="Vector2" or not finite(axis.X) or not finite(axis.Y) then
            local invertX=SniperSettings.InvertX and SniperSettings.InvertX.Value==true
            local invertY=SniperSettings.InvertY and SniperSettings.InvertY.Value==true
            axis=Vector2.new(settingNumber("Sensitivity_H",50)/50*(invertX and -1 or 1),
                settingNumber("Sensitivity_V",50)/50*(invertY and -1 or 1))
        end
        local userSensitivity=self.userGameSettings and self.userGameSettings.MouseSensitivity or 0.25
        if not finite(userSensitivity) then userSensitivity=0.25 end
        local deltaSensitivity=Input.MouseDeltaSensitivity
        if not finite(deltaSensitivity) then deltaSensitivity=1 end
        local invert=self.userGameSettings and self.userGameSettings:GetCameraYInvertValue() or 1
        local scale=math.rad(0.5)*userSensitivity*deltaSensitivity*rotation*alpha
        return scale*axis.X,scale*0.77*axis.Y*invert
    end
    function Feature:_aimDelta(camera,position,alpha)
        local frame=self:_thirdPersonShotFrame(camera)
        local relative=frame:PointToObjectSpace(position)
        local yaw=math.atan2(relative.X,-relative.Z)
        local pitch=math.atan2(relative.Y,math.sqrt(relative.X*relative.X+relative.Z*relative.Z))
        local horizontal,vertical=self:_mouseRadiansPerCount()
        local delta=Vector2.new(math.abs(horizontal)>1e-12 and yaw/horizontal or 0,
            math.abs(vertical)>1e-12 and -pitch/vertical or 0)
        local mode=self.config["rage.enabled"] and "rage" or self.config["legit.enabled"] and "legit"
        if mode and self:_effectiveSmooth(mode)<=0 then return delta*alpha end
        delta*=alpha*self.config["aim.gain"]
        local limit=self.config["aim.maxStep"]
        return delta.Magnitude>limit and delta.Unit*limit or delta
    end

    -- Roblox exposes M1-M3. Side-button aliases require a mouse-software remap.
    local sideKeys={MouseButton4=Enum.KeyCode.F13,MouseButton5=Enum.KeyCode.F14}
    local sideNames={[Enum.KeyCode.F13]="MouseButton4",[Enum.KeyCode.F14]="MouseButton5"}
    local previousValidKey=validKey
    validKey=function(value)
        return sideKeys[value]~=nil or previousValidKey(value)
    end

    local previousKeyHeld=Feature._keyHeld
    function Feature:_keyHeld(key)
        local mapped=sideKeys[key]
        if mapped then return Input:IsKeyDown(mapped) end
        return previousKeyHeld(self,key)
    end

    local previousStart=Feature.Start
    function Feature:Start()
        if self.running then return end
        previousStart(self)
        self:_connect(Input.InputBegan,function(input,processed)
            if processed or self.ui.isOpen or self.ui.closing or self.ui.waitKey
                or Input:GetFocusedTextBox() or os.clock()<self.inputCooldown then return end
            if input.UserInputType~=Enum.UserInputType.Keyboard then return end
            local alias=sideNames[input.KeyCode]
            if not alias then return end
            for _,mode in ipairs({"legit","rage","trigger"}) do
                if self.config[mode..".key"]==alias and self.config[mode..".activation"]=="Toggle" then
                    self.toggled[mode]=not self.toggled[mode]
                end
            end
        end)
        self:_connect(Input.WindowFocusReleased,function()
            for _,mode in ipairs({"legit","rage","trigger"}) do
                if sideKeys[self.config[mode..".key"]] then self.toggled[mode]=false end
            end
        end)
    end

    function Feature:_effectiveFov(mode,camera)
        local profile=mode=="legit" and self:_profile()
        local radius=profile and self.config[profile.."fov"] or self.config[mode..".fov"]
        radius=math.clamp(radius,10,1200)
        if not self.config[mode..".dynamicFov"] or not camera then return radius end
        local setting=SniperSettings.CameraFOV
        local offset=setting and tonumber(setting.Value) or 20
        if not finite(offset) then offset=20 end
        local baseline=self.config["world.fovEnabled"] and self.config["world.fov"] or 70+offset
        -- Both FOVs are vertical. The viewport-height focal-length terms cancel.
        -- Applying the 1200 px base limit again here would truncate the ADS cone.
        local baseTangent=math.tan(math.rad(math.clamp(baseline,1,170))*0.5)
        local currentTangent=math.tan(math.rad(math.clamp(camera.FieldOfView,1,170))*0.5)
        return math.max(1,radius*baseTangent/currentTangent)
    end

    local mouseChoices=options({
        {"None","Nenhum","None"},
        {"MouseButton1","M1 - botão esquerdo","M1 - left button"},
        {"MouseButton2","M2 - botão direito","M2 - right button"},
        {"MouseButton3","M3 - botão do meio","M3 - middle button"},
        {"MouseButton4","M4 - remapeado para F13","M4 - remapped to F13"},
        {"MouseButton5","M5 - remapeado para F14","M5 - remapped to F14"},
    })
    local previousBuildPage=Feature.BuildPage
    function Feature.BuildPage(ui,id,page)
        local result=previousBuildPage(ui,id,page)
        if id~="Legit" and id~="Rage" then return result end
        local mode=id=="Legit" and "legit" or "rage"
        local section=ui:CreateSection(page,copy("ZOOM E BOTÕES DO MOUSE","ZOOM AND MOUSE BUTTONS"),
            copy("M4/M5: remapeie para F13/F14 no software do mouse.",
                "M4/M5: remap to F13/F14 in mouse software."))
        ui:CreateToggle(section,{id=mode..".dynamicFov",title=copy("FOV dinâmico com zoom","Dynamic FOV with zoom"),
            description=copy("O círculo acompanha o zoom da mira.","The circle follows scope zoom.")})
        ui:CreateDropdown(section,{id=mode..".key",title=copy("Botão da mira","Aim mouse button"),options=mouseChoices})
        ui:CreateDropdown(section,{id="trigger.key",title=copy("Botão do trigger","Trigger mouse button"),options=mouseChoices})
        return result
    end
end

-- Native third-person controls and independent body rotation for Sniper Arena.
do
    local PAUSE_KEY="MNZS.SniperArena.BodySpin"
    specs["spin.speed"].max=14400
    function Feature:_sniperIsAiming()
        local weapon=SniperCombat.GetCurrentWeapon(SniperEntity.LocalEntity)
        local controller=weapon and weapon.Controller
        local aim=controller and not controller.Destroyed and controller.Aimable
        return aim and aim:IsAiming()==true or false
    end
    function Feature:_restoreSniperOffset()
        local record=self.sniperOffset
        self.sniperOffset=nil
        if record and record.humanoid.Parent and record.humanoid.CameraOffset==record.last then
            record.humanoid.CameraOffset=record.base
        end
    end
    local previousCamera=Feature._updateCamera
    function Feature:_updateCamera()
        previousCamera(self)
        local humanoid=SniperEntity.LocalEntity.Humanoid
        local root=SniperEntity.LocalEntity:GetRootPart()
        if not self.sniperPerspective or not humanoid or not root then self:_restoreSniperOffset();return end
        if self.sniperOffset and self.sniperOffset.humanoid~=humanoid then self:_restoreSniperOffset() end
        local record=self.sniperOffset
        if not record then record={humanoid=humanoid,base=humanoid.CameraOffset};self.sniperOffset=record end
        if record.last and humanoid.CameraOffset~=record.last then record.base=humanoid.CameraOffset end
        local camera=Workspace.CurrentCamera
        if not camera then return end
        -- Convert a camera-aligned shoulder offset to the native subject's space,
        -- so a rotating character does not rotate the shoulder camera around it.
        local world=camera.CFrame.RightVector*self.config["world.thirdSide"]+Vector3.new(0,self.config["world.thirdHeight"],0)
        record.last=record.base+root.CFrame:VectorToObjectSpace(world)
        humanoid.CameraOffset=record.last
    end
    local previousRestore=Feature._restorePerspective
    function Feature:_restorePerspective()
        self:_restoreSniperOffset()
        return previousRestore(self)
    end
    function Feature:_spinReady()
        if not self.running or not self.config["spin.enabled"] then return false,"off" end
        local entity=SniperEntity.LocalEntity
        if not entity or not entity:IsAlive() then return false,"waiting-character" end
        if LocalPlayer:GetAttribute("combatPaused")==true then return false,"lobby" end
        -- Body presentation does not inject input. Free cursor, aiming/menu state,
        -- typing and window focus must not disable it as they do the aimbot.
        return true,"ready"
    end
    function Feature:_clearSniperSpin()
        local record=self.sniperSpin
        self.sniperSpin=nil
        if not record then return end
        local controller=record.controller
        if controller and not controller.Destroyed then
            local pauseCleared=false
            if type(controller.SetLocalLookPaused)=="function" then pauseCleared=pcall(controller.SetLocalLookPaused,controller,PAUSE_KEY,nil) end
            if not pauseCleared and type(controller.LocalLookPaused)=="table" then controller.LocalLookPaused[PAUSE_KEY]=nil end
            local ownsUpdate=controller.UpdateCustomPitchYaw==record.update
            local ownsPose=controller.IgnorePitchYaw==record.pose
            if ownsUpdate then controller.UpdateCustomPitchYaw=record.originalRaw end
            if ownsPose then controller.IgnorePitchYaw=record.originalPose end
            if ownsUpdate and ownsPose and record.originalUpdate then pcall(record.originalUpdate,controller) end
        end
        local humanoid=record.humanoid
        if humanoid and humanoid.Parent and humanoid.AutoRotate==false then humanoid.AutoRotate=record.autoRotate end
        if record.root and record.root.Parent and Workspace.CurrentCamera and record.lastRotation
            and record.root.CFrame.Rotation:FuzzyEq(record.lastRotation,1e-4) then
            local _,yaw=Workspace.CurrentCamera.CFrame:ToOrientation()
            record.root.CFrame=CFrame.new(record.root.Position)*CFrame.Angles(0,yaw,0)
        end
        self.stats.antiAimStatus="off"
    end
    function Feature:_stepSniperSpin(dt)
        local ready,reason=self:_spinReady()
        if not ready then self:_clearSniperSpin();self.stats.antiAimStatus=reason;return end
        local entity=SniperEntity.LocalEntity
        local controller=entity.Controller
        local humanoid=entity.Humanoid
        local root=entity:GetRootPart()
        if not controller or controller.Destroyed or controller.Destroying
            or not humanoid or not humanoid.Parent or humanoid.Health<=0 or not root or not root.Parent
            or type(controller.SetLocalLookPaused)~="function" or type(controller.SetCustomPitchYaw)~="function" then
            self:_clearSniperSpin();self.stats.antiAimStatus="waiting-character";return
        end
        if self.sniperSpin and (self.sniperSpin.controller~=controller or self.sniperSpin.root~=root or self.sniperSpin.humanoid~=humanoid) then self:_clearSniperSpin() end
        local record=self.sniperSpin
        if not record then
            local _,yaw=root.CFrame:ToOrientation()
            record={controller=controller,humanoid=humanoid,root=root,autoRotate=humanoid.AutoRotate,yaw=yaw,
                originalRaw=rawget(controller,"UpdateCustomPitchYaw"),originalUpdate=controller.UpdateCustomPitchYaw,originalPose=controller.IgnorePitchYaw}
            self.sniperSpin=record
            record.update=function(target,...)
                if self.sniperSpin==record and self:_spinReady() then
                    target:SetCustomPitchYaw(math.rad(self.config["spin.pitch"]),record.yaw)
                    record.pose=target.IgnorePitchYaw
                elseif record.originalUpdate then return record.originalUpdate(target,...) end
            end
            if type(STATE)=="table" and type(STATE.override)=="function" then
                STATE.override(controller,"UpdateCustomPitchYaw",record.update)
            else controller.UpdateCustomPitchYaw=record.update end
        end
        -- Camera/movement mode changes can restore native autorotation mid-spin.
        -- Keep only our own pause key asserted and track an external new baseline.
        if record.lastAutoRotate~=nil and humanoid.AutoRotate~=record.lastAutoRotate then record.autoRotate=humanoid.AutoRotate end
        controller:SetLocalLookPaused(PAUSE_KEY,true)
        humanoid.AutoRotate=false;record.lastAutoRotate=humanoid.AutoRotate
        local direction=self.config["spin.direction"]=="Left" and -1 or 1
        record.yaw=(record.yaw+math.rad(self.config["spin.speed"])*math.min(dt,.1)*direction)%(math.pi*2)
        -- Rotation only: preserve position and leave the camera/shot direction native.
        root.CFrame=CFrame.new(root.Position)*CFrame.Angles(0,record.yaw,0)
        record.lastRotation=root.CFrame.Rotation
        record.update(controller)
        self.stats.antiAimStatus="native-body-spin"
    end
    -- The native combat frame is independent of this cosmetic body pose. Do not
    -- wait for the BloxStrike command adapter, which does not exist in this game.
    function Feature:_requestShotPose() return true end
    local previousStart=Feature.Start
    function Feature:Start()
        if self.running then return end
        previousStart(self)
        self:_connect(RunService.PreSimulation,function(dt)
            local ok,err=pcall(self._stepSniperSpin,self,dt)
            if not ok then self:_clearSniperSpin();self:_error(err) end
        end)
    end
    local previousPanic=Feature.Panic
    function Feature:Panic()
        self:_clearSniperSpin();self:_restoreSniperOffset()
        return previousPanic(self)
    end
    local previousDestroy=Feature.Destroy
    function Feature:Destroy()
        self:_clearSniperSpin();self:_restoreSniperOffset()
        return previousDestroy(self)
    end
    local previousSnapshot=Feature.Snapshot
    function Feature:Snapshot()
        local snapshot=previousSnapshot(self)
        snapshot.capabilities.spin=true
        snapshot.capabilities.wallbang=false
        snapshot.sniperBody={enabled=self.config["spin.enabled"],active=self.sniperSpin~=nil,status=self.stats.antiAimStatus or "off",
            thirdPerson=self.sniperPerspective~=nil,shoulderOffset=self.sniperOffset~=nil}
        return snapshot
    end
    local previousBuild=Feature.BuildPage
    function Feature.BuildPage(ui,id,page)
        previousBuild(ui,id,page)
        if id=="Mundo" then
            local section=ui:CreateSection(page,copy("THIRD PERSON · AJUSTES","THIRD PERSON · CONTROLS"))
            ui:CreateKeybind(section,{id="world.thirdKey",title=copy("Atalho da câmera","Camera shortcut")})
            ui:CreateSlider(section,{id="world.thirdSide",title=copy("Deslocamento lateral","Shoulder offset"),min=-5,max=5,step=.1,suffix=" st"})
            ui:CreateSlider(section,{id="world.thirdHeight",title=copy("Altura adicional","Height offset"),min=-3,max=5,step=.1,suffix=" st"})
        elseif id=="Rage" then
            local section=ui:CreateSection(page,copy("SPIN DO PERSONAGEM","CHARACTER SPIN"))
            ui:CreateToggle(section,{id="spin.enabled",title=copy("Girar personagem","Spin character")})
            ui:CreateLabel(section,{title=copy("Gira o corpo, inclusive com o menu aberto ou câmera livre. Pausa no lobby e ao morrer.","Spins the body, including with the menu open or a free camera. Pauses in the lobby and while dead."),wrap=true,height=36})
            ui:CreateKeybind(section,{id="spin.key",title=copy("Atalho do spin","Spin shortcut")})
            ui:CreateSlider(section,{id="spin.speed",title=copy("Velocidade","Speed"),min=30,max=14400,step=30,suffix=" °/s"})
            ui:CreateDropdown(section,{id="spin.direction",title=copy("Sentido","Direction"),options={{value="Right",label=copy("Direita","Right")},{value="Left",label=copy("Esquerda","Left")}}})
            ui:CreateSlider(section,{id="spin.pitch",title=copy("Inclinação do corpo","Body pitch"),min=-89,max=89,step=1,suffix="°"})
        end
    end
end

-- Optional melee pause and a single dispatcher for feature toggle shortcuts.
do
    spec("aim.pauseKnife","boolean",true)
    local featureBinds={
        {key="bind.legit",target="legit.enabled",pt="Aimbot Legit",en="Legit aimbot"},
        {key="bind.rage",target="rage.enabled",pt="Aimbot Rage",en="Rage aimbot"},
        {key="bind.trigger",target="trigger.enabled",pt="Triggerbot",en="Triggerbot"},
        {key="esp.key",target="esp.enabled",pt="ESP",en="ESP"},
        {key="world.thirdKey",target="world.thirdPerson",pt="Third person",en="Third person"},
        {key="spin.key",target="spin.enabled",pt="Spin do personagem",en="Character spin"},
        {key="bind.bhop",target="bhop.enabled",pt="Bunny hop",en="Bunny hop"},
        {key="bind.giant",target="localfx.giant",pt="Arma gigante",en="Giant weapon"},
        {key="bind.rgb",target="localfx.rgb",pt="RGB da arma e mãos",en="Weapon and hand RGB"},
        {key="bind.sky",scene=true,pt="Céu RGB",en="RGB sky"},
    }
    for _,entry in ipairs(featureBinds) do
        if not specs[entry.key] then spec(entry.key,"key","None") end
    end
    function Feature:_knifeAimPaused()
        if not self.config["aim.pauseKnife"] then return false end
        local weapon=SniperCombat.GetCurrentWeapon(SniperEntity.LocalEntity)
        -- Resolve the actual weapon identity. Cosmetic models can use another family.
        local config=weapon and (SniperWeapons[weapon.Name] or weapon.Config)
        return config~=nil and config.WeaponType=="Melee"
    end
    local previousAimInput=Feature._drawAimAndInput
    function Feature:_drawAimAndInput(camera,size,dt)
        if not self:_knifeAimPaused() then return previousAimInput(self,camera,size,dt) end
        self:_releaseShot()
        self.target=nil;self.aimPosition=nil;self.aimPositionAt=nil
        self.pendingTarget=nil;self.lastAimedPlayer=nil;self.triggerTarget=nil
        self.collectSniperAim=nil;self.sniperAimDelta=nil
        self.mouseRemainder=Vector2.zero
        self.stats.target="";self.stats.status="knife-paused";self.stats.triggerStatus="knife-paused"
        for _,name in ipairs({"fov","targetLine"}) do
            if self.globals[name] then self.globals[name].Visible=false end
        end
    end
    function Feature:_handleFeatureBind(name)
        if not self.running or self.ui.isOpen or self.ui.closing or self.ui.waitKey
            or Input:GetFocusedTextBox() or os.clock()<self.inputCooldown
            or type(isrbxactive)~="function" or not isrbxactive() then return false end
        if name==self.state:Get("menuKey","RightShift") or name==self.config["misc.panic"] then return false end
        local alias=name=="F13" and "MouseButton4" or name=="F14" and "MouseButton5"
        local changed=false
        for _,entry in ipairs(featureBinds) do
            local binding=self.config[entry.key]
            if binding and binding~="None" and (binding==name or binding==alias) then
                if entry.scene then
                    local scene=self.config["localfx.scene"]
                    if scene=="RGB" then
                        self.state:Set("localfx.scene",self.sniperPreviousScene or "Original")
                    else
                        self.sniperPreviousScene=scene
                        self.state:Set("localfx.scene","RGB")
                    end
                else self.state:Set(entry.target,not self.config[entry.target]) end
                changed=true
            end
        end
        return changed
    end
    local previousBuildPage=Feature.BuildPage
    function Feature.BuildPage(ui,id,page)
        previousBuildPage(ui,id,page)
        if id=="Legit" or id=="Rage" then
            local section=ui:CreateSection(page,copy("ARMA EQUIPADA","EQUIPPED WEAPON"))
            ui:CreateToggle(section,{id="aim.pauseKnife",title=copy("Pausar mira com faca equipada","Pause aim while holding a knife"),
                description=copy("Pausa Legit, Rage e trigger. Retoma ao equipar uma arma de fogo.","Pauses Legit, Rage and trigger. Resumes when a firearm is equipped.")})
        end
    end
    local previousBuildSettings=Feature.BuildSettings
    function Feature.BuildSettings(ui)
        previousBuildSettings(ui)
        local section=ui:CreateSection(ui.pages["Configurações"],copy("ATALHOS DAS FUNÇÕES","FEATURE SHORTCUTS"))
        ui:CreateLabel(section,{title=copy("Clique no atalho e pressione uma tecla. Backspace/Delete limpa; Escape cancela. Atalhos alternam a função com o menu fechado.",
            "Click a shortcut and press a key. Backspace/Delete clears; Escape cancels. Shortcuts toggle features while the menu is closed."),wrap=true,height=50})
        for _,entry in ipairs(featureBinds) do
            ui:CreateKeybind(section,{id=entry.key,title=copy(entry.pt,entry.en)})
        end
        ui:CreateLabel(section,{title=copy("Os botões Hold/Toggle da mira e trigger continuam nas abas Legit/Rage. O atalho do céu alterna entre RGB e o cenário anterior.",
            "Aim and trigger Hold/Toggle buttons remain in Legit/Rage. The sky shortcut toggles RGB and the previous scene."),wrap=true,height=42})
    end
end

-- Local presentation only. Native weapon data, geometry, materials and sounds are retained.
do
    local modes={"Off","Outline","Glow","Chams"}
    local sceneNames={"Original","Apocalypse","Hellfire","NeonNight","RGB"}
