local function mnzs_decode_base64(data)
    local alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local map = {}
    for i=1,#alpha do map[string.byte(alpha,i)] = i-1 end
    data = data:gsub("%s+", "")
    local out = {}
    for i=1,#data,4 do
        local a,b,c,d = data:byte(i,i+3)
        if not a or not b then break end
        local n1,n2,n3,n4 = map[a] or 0,map[b] or 0,map[c] or 0,map[d] or 0
        out[#out+1] = string.char(n1*4 + math.floor(n2/16))
        if c and c~=61 then out[#out+1] = string.char((n2%16)*16 + math.floor(n3/4)) end
        if d and d~=61 then out[#out+1] = string.char((n3%4)*64 + n4) end
    end
    return table.concat(out)
end
local function mnzs_local_asset(fileName, encoded)
    local register = type(getcustomasset)=="function" and getcustomasset
        or type(getsynasset)=="function" and getsynasset
        or type(get_custom_asset)=="function" and get_custom_asset
    if type(writefile)~="function" or not register then return nil end
    local ok, uri=pcall(function()
        if not (type(isfile)=="function" and isfile(fileName)) then
            writefile(fileName,mnzs_decode_base64(encoded))
        end
        return register(fileName)
    end)
    if ok and type(uri)=="string" and uri~="" then return uri end
    warn("[MNZS] Falha ao registrar arte local: "..tostring(uri))
    return nil
end
