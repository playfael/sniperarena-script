local baseNew=Feature._newBase
function Feature._newV99(state,ui)
    local self=baseNew(state,ui)
    self.memory,self.highlights,self.smokeParts={},{},{}
    self.playerWatches={}
    self.inputDriver={press=mouse1press,release=mouse1release,rightClick=mouse2click,isLeftDown=function() return Input:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) end}
    self.triggerEnteredAt,self.nextShotAt,self.nextScopeAt=0,0,0
    self.feedbackUntil,self.nextSmokeScan=0,0
    self.stats.triggerShots,self.stats.spinFrames,self.stats.rcsInputs,self.stats.memoryMarkers=0,0,0,0
