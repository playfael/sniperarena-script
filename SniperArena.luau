            bundle.armorBack.Position=Vector2.new(box.x,box.y+box.height+1);bundle.armorBack.Size=Vector2.new(box.width,4);bundle.armorBack.Visible=true
            bundle.armorFill.Position=bundle.armorBack.Position+Vector2.new(1,1);bundle.armorFill.Size=Vector2.new(math.max(1,(box.width-2)*math.clamp(record.armor/100,0,1)),2);bundle.armorFill.Visible=true
        end
