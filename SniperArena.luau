    local folder=Workspace:FindFirstChild("Characters")
    if folder then
        c=folder:FindFirstChild(player.Name)
        if c and c:IsA("Model") and basePart(c,"HumanoidRootPart") then return c end
        for _,candidate in ipairs(folder:GetChildren()) do
            if candidate:IsA("Model") and candidate:GetAttribute("PresentationOwnerUserId")==player.UserId and basePart(candidate,"HumanoidRootPart") then return candidate end
        end
    end
    return nil
end
local function healthOf(player,character)
    if not character or not character.Parent then return 0,100 end
    if player:GetAttribute("Dead")==true or character:GetAttribute("Dead")==true then return 0,100 end
    if character:GetAttribute("ClientCharacterPresentationVisible")==false then return 0,100 end
    local health=player:GetAttribute("Health")
    if not finite(health) then health=character:GetAttribute("Health") end
    local maximum=player:GetAttribute("MaxHealth")
    if not finite(maximum) then maximum=character:GetAttribute("MaxHealth") end
    local humanoid=character:FindFirstChildOfClass("Humanoid")
    if not finite(health) and humanoid then health=humanoid.Health end
    if not finite(maximum) and humanoid then maximum=humanoid.MaxHealth end
    return finite(health) and math.max(health,0) or 0,finite(maximum) and math.max(maximum,1) or 100
end
local function localAlive(character)
    return character~=nil and healthOf(LocalPlayer,character)>0 and LocalPlayer:GetAttribute("combatPaused")~=true
end
local function teamOf(player,character)
    return player:GetAttribute("Team") or (player.Team and player.Team.Name)
end
local function isEnemy(player,character)
    local svc=require(game:GetService("ReplicatedStorage").Remote.EntityService)
    local entity=type(player)=="table" and player._sniperEntity or svc.GetEntity(player)
    return entity~=nil and entity~=svc.LocalEntity and not svc.LocalEntity:IsFriendly(entity)
end
local function project(camera,position)
    local p=camera:WorldToViewportPoint(position)
    return Vector2.new(p.X,p.Y),p.Z
end
local function clip2D(a,b,size)
    local delta=b-a
    local low,high=0,1
    local p={-delta.X,delta.X,-delta.Y,delta.Y}
    local q={a.X,size.X-a.X,a.Y,size.Y-a.Y}
    for i=1,4 do
        if math.abs(p[i])<0.00001 then
            if q[i]<0 then return nil,nil end
        else
            local t=q[i]/p[i]
            if p[i]<0 then low=math.max(low,t) else high=math.min(high,t) end
            if low>high then return nil,nil end
        end
    end
    return a+delta*low,a+delta*high
end
local function worldSegment(camera,a,b,size)
    local ca=camera.CFrame:PointToObjectSpace(a)
    local cb=camera.CFrame:PointToObjectSpace(b)
    local da,db=-ca.Z,-cb.Z
    if da<0.1 and db<0.1 then return nil,nil end
    if da<0.1 then a=a:Lerp(b,(0.1-da)/(db-da))
    elseif db<0.1 then b=b:Lerp(a,(0.1-db)/(da-db)) end
    local pa=project(camera,a)
    local pb=project(camera,b)
    return clip2D(pa,pb,size)
end
local function roundSigned(value)
    return value>=0 and math.floor(value+0.5) or math.ceil(value-0.5)
end

function Feature._newBase(state,ui)
