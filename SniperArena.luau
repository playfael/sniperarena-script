function UI:ExportConfig()
    local HttpService=game:GetService("HttpService")
    local function encode(v)
        if typeof(v)=="Color3" then
            return {__color3=true,r=math.floor(v.R*255+.5),g=math.floor(v.G*255+.5),b=math.floor(v.B*255+.5)}
        elseif type(v)=="table" then
            local output={};for k,item in pairs(v) do output[k]=encode(item) end;return output
        end
        return v
    end
    return HttpService:JSONEncode(encode(self.state:Snapshot()))
end
function UI:ImportConfig(value)
    local HttpService=game:GetService("HttpService")
    local ok,result=pcall(function() return HttpService:JSONDecode(value) end)
    if not ok or type(result)~="table" then return false,self:_lcopy("JSON inválido") end
    for key,item in pairs(result) do
        if type(item)=="table" and item.__color3 then
            if type(item.r)=="number" and type(item.g)=="number" and type(item.b)=="number" then
                item=Color3.fromRGB(math.clamp(item.r,0,255),math.clamp(item.g,0,255),math.clamp(item.b,0,255))
            end
        end
        if key=="language" and item~="pt" and item~="en" then item="pt" end
        if key=="language" and item~="pt" and item~="en" then item="pt" end
        if key=="language" and item~="pt" and item~="en" then item="pt" end
        if key~="ui.import" then self.state:Set(key,item) end
    end
    return true,self:_lcopy("Configurações importadas para a sessão")
end
function UI:Destroy()
    self:ClosePopup()
    for _,connection in ipairs(self.connections) do
        if typeof(connection)=="RBXScriptConnection" then connection:Disconnect() end
    end
    for _,unwatch in ipairs(self.unwatch or {}) do unwatch() end
    for _,tw in pairs(self.tweens) do tw:Cancel() end
    if self.gui and self.gui.Parent then self.gui:Destroy() end
    self.gui=nil
end
UI.Palette=C
return UI

end)()
