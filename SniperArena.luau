-- Familias disponiveis sao geradas a partir do catalogo real, sem inventar skins.
local function mnzsFamily(weapon,kind)
    local n=low(weapon)
    if kind=="Gloves" then
        if n:find("sport",1,true) then return "sport" end
        if n:find("driver",1,true) then return "driver" end
        if n:find("operator",1,true) then return "operator" end
        if n:find("wrap",1,true) then return "wrap" end
        if n:find("special",1,true) then return "special" end
        if n:find("moto",1,true) then return "moto" end
        return "other"
    elseif kind=="Knives" then
        if n:find("butterfly",1,true) then return "butterfly" end
        if n:find("karambit",1,true) then return "karambit" end
        if n:find("bayonet",1,true) then return "bayonet" end
        if n=="ct knife" or n=="t knife" then return "classic" end
        return "other"
    else
        if n:find("awp",1,true) or n:find("scout",1,true) or n:find("ssg",1,true) or n:find("sniper",1,true) then return "sniper" end
        if n:find("ak-",1,true) or n:find("m4",1,true) or n:find("famas",1,true) or n:find("galil",1,true) or n:find("aug",1,true) or n:find("sg ",1,true) then return "rifle" end
        if n:find("mp",1,true) or n:find("ump",1,true) or n:find("p90",1,true) or n:find("mac-",1,true) or n:find("smg",1,true) then return "smg" end
        if n:find("usp",1,true) or n:find("glock",1,true) or n:find("pistol",1,true) or n:find("five",1,true) or n:find("deagle",1,true) or n:find("revolver",1,true) then return "pistol" end
        return "other"
    end
end
local MNZS_GROUPS={
    Gloves={{"all","Todas"},{"sport","Sport"},{"driver","Driver"},{"operator","Operator"},{"wrap","Wraps"},{"special","Spec."},{"moto","Moto"},{"other","Outras"}},
    Knives={{"all","Todas"},{"butterfly","Butterfly"},{"karambit","Karambit"},{"bayonet","Bayonet"},{"classic","Clássicas"},{"other","Outras"}},
    Weapons={{"all","Todas"},{"rifle","Rifles"},{"pistol","Pistolas"},{"smg","Submetralhadoras"},{"sniper","Precisão"},{"other","Outras"}},
}
function UI:OpenWeaponPicker()
    if not self.pickerOverlay then return end
    self:ClosePopup()
    self.pickerOverlay.Visible=true
    self.pickerFamily="all"
    self.pickerSearch.Text=""
    self:RefreshWeaponPicker()
end
function UI:RefreshWeaponPicker()
    if not self.pickerOverlay or not self.pickerOverlay.Visible then return end
    local kind=self.skinKind
    local all=self.engine:GetWeapons(kind)
    self.pickerTitle.Text=self:_t(kind=="Gloves" and "gloves" or kind=="Knives" and "knives" or "weapons")
        .."  /  "..self:_lcopy("Selecione um modelo")
    self.pickerSearch.PlaceholderText=self:_lcopy("Buscar modelo...")
    local available={}
    for _,weapon in ipairs(all) do available[mnzsFamily(weapon,kind)]=true end
    for _,obj in ipairs(self.pickerGroups:GetChildren()) do if obj:IsA("GuiObject") then obj:Destroy() end end
    local options={}
    for _,entry in ipairs(MNZS_GROUPS[kind]) do
        if entry[1]=="all" or available[entry[1]] then table.insert(options,entry) end
    end
    -- Guias compactas, mantendo tudo numa unica linha mesmo com muitos grupos.
    local x=0
    local count=#options
    local cell=math.floor(506/math.max(count,1))
    for _,entry in ipairs(options) do
        local id=entry[1]
        local selected=self.pickerFamily==id
        local b=btn(self.pickerGroups,self:_lcopy(entry[2]),UDim2.fromOffset(x,1),
            UDim2.fromOffset(cell-4,26),selected and C.redDark or C.panel2,37)
        b.TextSize=count>6 and 9 or 10
        b.MouseButton1Click:Connect(function() self.pickerFamily=id;self:RefreshWeaponPicker() end)
        x+=cell
    end
    for _,obj in ipairs(self.pickerScroll:GetChildren()) do if obj:IsA("GuiObject") then obj:Destroy() end end
    local query=low(self.pickerSearch.Text)
    local shown=0
    for _,weapon in ipairs(all) do
        if (self.pickerFamily=="all" or mnzsFamily(weapon,kind)==self.pickerFamily)
            and (query=="" or low(weapon):find(query,1,true)) then
            shown+=1
            local chosen=weapon==self.selectedWeaponByKind[kind]
            local b=btn(self.pickerScroll,"",UDim2.new(),UDim2.fromOffset(161,47),
                chosen and Color3.fromRGB(71,32,56) or C.panel2,37)
            stroke(b,chosen and C.bright or C.outline,chosen and .05 or .7,chosen and 1.4 or .8)
            txt(b,weapon,11,true,chosen and C.white or C.text,nil,{Position=UDim2.fromOffset(8,4),
                Size=UDim2.fromOffset(145,19),ZIndex=39})
            txt(b,tostring(#self.engine:GetSkins(weapon)).." "..self:_t("skins"),9,false,C.muted,nil,{
                Position=UDim2.fromOffset(8,24),Size=UDim2.fromOffset(145,16),ZIndex=39})
            b.MouseButton1Click:Connect(function()
                self.selectedWeaponByKind[kind]=weapon
                self.state:Set("skins.weapon",weapon)
                self.pickerOverlay.Visible=false
                self:RefreshSkins()
            end)
        end
    end
    if shown==0 then
        txt(self.pickerScroll,self:_lcopy("Nenhum modelo encontrado"),11,false,C.muted,nil,{
            Size=UDim2.fromOffset(490,39),ZIndex=38})
    end
end

function UI:RefreshSkins()
    if not self.skinFrame then return end
    local filter=low(self.search and self.search.Text or "")
    for kind, rec in pairs(self.kindButtons) do
        local selected=kind==self.skinKind
        rec.button.Text=self:_t(rec.key)
        rec.button.BackgroundColor3=selected and Color3.fromRGB(69,32,51) or C.panel
        rec.button:SetAttribute("mnzsNormalColor",selected and Color3.fromRGB(69,32,51) or C.panel)
        rec.stroke.Color=selected and Color3.fromRGB(152,84,121) or C.outline
    end
    self.weaponCaption.Text=self:_t("weapon")
    self.skinHelp.Text=self:_t("skinHelp")
    self.applyButton.Text=self:_t("apply")
    self.restoreButton.Text=self:_t("restore")
    local weapons=self.engine:GetWeapons(self.skinKind)
    if not table.find(weapons,self.selectedWeaponByKind[self.skinKind]) then self.selectedWeaponByKind[self.skinKind]=weapons[1] end
    local chosen=self.selectedWeaponByKind[self.skinKind]
    local equipped=self.engine:Equipped()
    self.activeCaption.Text=self:_t("equipped")..": "..tostring(equipped or self:_t("none"))
    self.weaponPickButton.Text="   "..tostring(chosen or self:_lcopy("Selecione um modelo")).."     v"
    self.weaponSummary.Text=tostring(#weapons).." "..self:_lcopy("Modelos").."  /  "..self:_t("skins")
    if self.pickerOverlay and self.pickerOverlay.Visible then self:RefreshWeaponPicker() end
    local lastScroll=self.skinList.CanvasPosition
    self.previewSlots={}
    local sameSelection=self._lastSkinsWeapon==chosen and self._lastSkinsFilter==filter
    for _,child in ipairs(self.skinList:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    local list=chosen and self.engine:GetSkins(chosen) or {}
    if chosen and not self.selectedSkinByWeapon[chosen] and #list>0 then
        self.selectedSkinByWeapon[chosen]=list[1].skin
    end
    self.skinCaption.Text=self:_t("skinTitle") .. (chosen and " · "..chosen or "")
    local selectedSkin=self.selectedSkinByWeapon[chosen]
    local wears=(chosen and selectedSkin) and self.engine:GetWears(chosen,selectedSkin) or {}
    local chosenWear=self.state:Get("wear."..tostring(chosen),"Factory New")
    if not table.find(wears,chosenWear) then
        chosenWear=wears[1]
        if chosen and chosenWear then self.state:Set("wear."..chosen,chosenWear) end
    end
    self.wearButton.Text=self:_t("wear")..": "..tostring(chosenWear or "—").."  v"
    self.wearButton.Active=#wears>0
    self.wearButton.AutoButtonColor=false
    local cardCount=0
    for _,info in ipairs(list) do
        if filter=="" or string.find(low(chosen),filter,1,true) or string.find(low(info.skin),filter,1,true) or string.find(low(info.display),filter,1,true) then
            cardCount+=1
            self:CreateSkinCard(self.skinList,info,chosen,info.skin==selectedSkin,function(item)
                self.selectedSkinByWeapon[chosen]=item.skin
                self.state:Set("skins.selected."..chosen,item.skin)
                local options=self.engine:GetWears(chosen,item.skin)
                if not table.find(options,self.state:Get("wear."..chosen)) then
                    self.state:Set("wear."..chosen,options[1] or "Factory New")
                end
                self:RefreshSkins()
            end)
        end
    end
    self._lastSkinsWeapon=chosen
    self._lastSkinsFilter=filter
    if sameSelection then
        task.defer(function()
            if self.skinList and self.skinList.Parent then self.skinList.CanvasPosition=lastScroll end
        end)
    else
        self.skinList.CanvasPosition=Vector2.new(0,0)
    end
    task.defer(function()
        if self.skinList and self.skinList.Parent then self:_syncPreviews() end
    end)
    local count=0
    for _ in pairs(self.engine.profiles) do count+=1 end
    self.profileCount.Text=self:_lcopy("PERFIS")..": "..tostring(count)..(self.engine.live and "" or "  -  DEMO")
end

