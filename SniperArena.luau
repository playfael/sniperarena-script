function Feature:_drawRadar(camera,size)
    for key,d in pairs(self.globals) do if string.sub(key,1,6)=="radar:" then d.Visible=false end end
    if not self.config["esp.enabled"] or not self.config["esp.radar"] or (self.config["esp.hideWithMenu"] and self.ui.isOpen) then return end
    local side=self.config["esp.radarSize"]
    local origin=Vector2.new(size.X-side-18,size.Y-side-100)
    local center=origin+Vector2.new(side,side)*0.5
    local background=self:_global("radar:bg","Square",{Filled=true,Color=black,ZIndex=1})
    background.Position=origin;background.Size=Vector2.new(side,side);background.Transparency=0.75;background.Visible=true
    local border=self:_global("radar:border","Square",{Filled=false,Thickness=1,Color=white})
    border.Position=origin;border.Size=background.Size;border.Visible=true
    for i,points in ipairs({{Vector2.new(origin.X,center.Y),Vector2.new(origin.X+side,center.Y)},{Vector2.new(center.X,origin.Y),Vector2.new(center.X,origin.Y+side)}}) do
        local line=self:_global("radar:axis"..i,"Line",{Thickness=1,Color=Color3.fromRGB(70,70,80)});line.From,line.To,line.Visible=points[1],points[2],true
    end
    local own=self:_global("radar:own","Triangle",{Filled=true,Color=white,ZIndex=4})
    own.PointA=center+Vector2.new(0,-5);own.PointB=center+Vector2.new(-4,4);own.PointC=center+Vector2.new(4,4);own.Visible=true
    local yaw=Vector3.new(camera.CFrame.LookVector.X,0,camera.CFrame.LookVector.Z)
    if yaw.Magnitude<0.01 then yaw=Vector3.new(0,0,-1) else yaw=yaw.Unit end
    local right=Vector3.new(-yaw.Z,0,yaw.X)
    for player,record in pairs(self.records) do
        local live=record.character and record.root and healthOf(player,record.character)>0
        local memory=self.memory[player]
        local position=live and record.root.Position or (self.config["esp.lastKnown"] and memory and memory.position)
        if position and (not self.config["esp.team"] or isEnemy(player,record.character)) and (live or not self.config["esp.visibleOnly"]) then
            local delta=position-camera.CFrame.Position
            local xy=Vector2.new(delta:Dot(right),-delta:Dot(yaw))*(side*0.46/self.config["esp.radarRange"])
            if math.abs(xy.X)<=side*0.46 and math.abs(xy.Y)<=side*0.46 then
                local dot=self:_global("radar:p"..player.UserId,"Circle",{Filled=true,Radius=3,ZIndex=4})
                dot.Position=center+xy;dot.Color=live and self.config["esp.colorVisible"] or Color3.fromRGB(235,174,65);dot.Visible=true
            end
        end
    end
end

function Feature:SaveProfile(action)
    local prefix="profile."..self.config["profiles.edit"].."."
    if action=="DeleteProfile" then self.state:Set(prefix.."enabled",false);return true end
    for _,field in ipairs({"fov","smooth","part","regions"}) do
        if action=="LoadProfile" then self.state:Set("legit."..field,self.config[prefix..field])
        else self.state:Set(prefix..field,self.config["legit."..field]) end
    end
    if action~="LoadProfile" then self.state:Set(prefix.."enabled",true) end
    return true
end

