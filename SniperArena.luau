function UI:CreateSlider(parent,opts)
    local row=self:_row(parent,opts.title,opts.description,72)
    local valueLabel=txt(row,"",12,true,C.bright,Enum.TextXAlignment.Right,{Position=UDim2.new(1,-94,0,7),Size=UDim2.fromOffset(79,21),ZIndex=22})
    local bar=mk("Frame",{Position=UDim2.new(0,13,1,-19),Size=UDim2.new(1,-26,0,5),BackgroundColor3=Color3.fromRGB(66,48,60),BorderSizePixel=0,ZIndex=22,Active=true},row)
    rounded(bar,4)
    local fill=mk("Frame",{Size=UDim2.fromScale(.5,1),BackgroundColor3=C.red,BorderSizePixel=0,ZIndex=23},bar)
    rounded(fill,4)
    local knob=mk("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(13,13),BackgroundColor3=C.text,BorderSizePixel=0,ZIndex=24},bar)
    rounded(knob,8)
    local min=opts.min or 0;local max=opts.max or 100;local step=opts.step or 1
    local function render(v)
        v=tonumber(v) or min
        local fraction=math.clamp((v-min)/math.max(.001,max-min),0,1)
        fill.Size=UDim2.fromScale(fraction,1)
        knob.Position=UDim2.fromScale(fraction,.5)
        valueLabel.Text=tostring(v)..(opts.suffix or "")
        if opts.onChange then opts.onChange(v) end
    end
    self:_watch(opts.id,render,true)
    local function move(mouseX)
        local f=math.clamp((mouseX-bar.AbsolutePosition.X)/math.max(bar.AbsoluteSize.X,1),0,1)
        local val=math.floor((min+(max-min)*f)/step+.5)*step
        val=math.clamp(math.floor(val*100+.5)/100,min,max)
        self.state:Set(opts.id,val)
    end
    bar.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            move(input.Position.X)
            self.sliderDrag=move
        end
    end)
    return row
